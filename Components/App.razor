<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/inter/inter.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["mechsystem.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="logo.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["lib/imask/imask.min.js"]"></script>
    <script>
        window.applyMasks = () => {
            if (typeof IMask === 'undefined') return;
            document.querySelectorAll('.mask-cpf').forEach(el => {
                if (!el.maskInstance) {
                    el.maskInstance = IMask(el, { mask: '000.000.000-00' });
                }
            });
            document.querySelectorAll('.mask-cnpj').forEach(el => {
                if (!el.maskInstance) {
                    el.maskInstance = IMask(el, { mask: '00.000.000/0000-00' });
                }
            });
            document.querySelectorAll('.mask-telefone').forEach(el => {
                if (!el.maskInstance) {
                    el.maskInstance = IMask(el, {
                        mask: [
                            { mask: '(00) 0000-0000' },
                            { mask: '(00) 00000-0000' }
                        ]
                    });
                }
            });
        };
    </script>
    <script>
        window.toggleSidebar = () => {
            document.querySelector('.sidebar')?.classList.toggle('open');
            document.querySelector('.sidebar-backdrop')?.classList.toggle('show');
        };
        window.closeSidebar = window.closeMobileSidebar = () => {
            document.querySelector('.sidebar')?.classList.remove('open');
            document.querySelector('.sidebar-backdrop')?.classList.remove('show');
        };
        window.isMobileScreen = () => window.innerWidth < 768;
        window.downloadCsvUtf8Bom = (fileName, csvContent) => {
            const bom = '\uFEFF';
            const blob = new Blob([bom + csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.setAttribute('download', fileName);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        };
    </script>
</body>

</html>
