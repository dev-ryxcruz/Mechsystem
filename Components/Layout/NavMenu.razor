@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@implements IDisposable

@if (collapseSidebar)
{
    <style>
        @@media (min-width: 768px) {
            .sidebar { width: var(--sidebar-width-collapsed) !important; }
        }
    </style>
}

<div class="top-row @(collapseSidebar ? "top-row--collapsed" : "")">
    <div class="top-row-inner d-flex align-items-center w-100">
        @if (!collapseSidebar)
        {
            <a class="navbar-brand d-flex align-items-center gap-2 m-0" href="">
                <img src="logo.png" alt="Mechsystem Logo" style="height: 25px; object-fit: contain; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));" />
                <span style="font-weight: 700; font-size: 1.25rem; letter-spacing: -0.5px;">Mechsystem</span>
            </a>
        }
        <button type="button" title="Alternar Menu" class="btn btn-link text-white @(collapseSidebar ? "mx-auto" : "ms-auto") p-0 sidebar-toggle" @onclick="ToggleSidebar">
            <i class="bi @(collapseSidebar ? "bi-arrow-bar-right" : "bi-arrow-bar-left")" style="font-size: 1.5rem; filter: none; color: var(--accent);"></i>
        </button>
    </div>
</div>

<div class="nav-scrollable" style="@(collapseSidebar ? "overflow-x: hidden;" : "")">
    <nav class="nav flex-column @(collapseSidebar ? "nav-collapsed" : "")" aria-label="Menu principal">
        @for (var sectionIndex = 0; sectionIndex < NavConfig.Sections.Count; sectionIndex++)
        {
            var navSection = NavConfig.Sections[sectionIndex];
            var showDivider = sectionIndex > 0;

            @if (!string.IsNullOrWhiteSpace(navSection.Roles))
            {
                <AuthorizeView Roles="@navSection.Roles">
                    <Authorized>
                        @RenderSection(navSection, showDivider)
                    </Authorized>
                </AuthorizeView>
            }
            else
            {
                @RenderSection(navSection, showDivider)
            }
        }
    </nav>
</div>

@code {
    private bool collapseSidebar = false;
    private readonly HashSet<string> expandedGroups = new(StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        SyncActiveGroupFromUri(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private RenderFragment RenderSection(NavSectionDefinition navSection, bool showDivider) => __builder =>
    {
        if (showDivider)
        {
            <div class="nav-divider" role="separator"></div>
        }

        if (!collapseSidebar && !string.IsNullOrWhiteSpace(navSection.Title))
        {
            <div class="nav-section-title">@navSection.Title</div>
        }

        foreach (var item in navSection.Items)
        {
            if (!string.IsNullOrWhiteSpace(item.Roles))
            {
                <AuthorizeView Roles="@item.Roles">
                    <Authorized>
                        @RenderNavItem(item)
                    </Authorized>
                </AuthorizeView>
            }
            else
            {
                @RenderNavItem(item)
            }
        }
    };

    private RenderFragment RenderNavItem(NavItemDefinition item) => __builder =>
    {
        if (item.IsGroup && item.GroupId is not null)
        {
            var groupId = item.GroupId;
            var isRouteActive = item.MatchesPath(GetCurrentRelativePath());
            var isExpanded = expandedGroups.Contains(groupId);

            <NavGroup Group="item"
                      IsCollapsed="collapseSidebar"
                      IsExpanded="isExpanded"
                      IsRouteActive="isRouteActive"
                      OnToggle="() => ToggleGroup(groupId)" />
        }
        else
        {
            <div class="nav-item">
                <NavLink class="nav-link"
                         href="@item.Href"
                         Match="@item.Match"
                         title="@item.Title"
                         data-tooltip="@item.Title">
                    <i class="bi @item.Icon" aria-hidden="true"></i>
                    @if (!collapseSidebar)
                    {
                        <span class="nav-text">@item.Title</span>
                    }
                </NavLink>
            </div>
        }
    };

    private string GetCurrentRelativePath()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return "/" + relative;
    }

    private void SyncActiveGroupFromUri(string uri)
    {
        var relative = "/" + NavigationManager.ToBaseRelativePath(uri);
        foreach (var section in NavConfig.Sections)
        {
            foreach (var item in section.Items)
            {
                if (item.IsGroup && item.GroupId is not null && item.MatchesPath(relative))
                {
                    expandedGroups.Add(item.GroupId);
                }
            }
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SyncActiveGroupFromUri(e.Location);
        await InvokeAsync(StateHasChanged);

        try { await JS.InvokeVoidAsync("closeMobileSidebar"); }
        catch { /* JS runtime may not be available during prerender */ }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void ToggleSidebar()
    {
        collapseSidebar = !collapseSidebar;
        if (collapseSidebar)
        {
            expandedGroups.Clear();
        }
        else
        {
            SyncActiveGroupFromUri(NavigationManager.Uri);
        }
    }

    private void ToggleGroup(string groupId)
    {
        if (collapseSidebar)
        {
            collapseSidebar = false;
            expandedGroups.Add(groupId);
            return;
        }

        if (!expandedGroups.Remove(groupId))
        {
            expandedGroups.Add(groupId);
        }
    }
}
