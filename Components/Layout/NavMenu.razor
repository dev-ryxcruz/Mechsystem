@rendermode InteractiveServer

@* Controle da largura da sidebar — usa <style> porque NavMenu não tem acesso direto
   ao elemento .sidebar do MainLayout. A transição funciona porque .sidebar 
   já possui 'transition: width' definida no MainLayout.razor.css *@
@if (collapseSidebar)
{
    <style>
        @@media (min-width: 641px) {
            .sidebar { width: 4.5rem !important; }
        }
    </style>
}

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid align-items-center">
        @if (!collapseSidebar)
        {
            <a class="navbar-brand" href="">Mechsystem</a>
        }
        <button title="Alternar Menu" class="btn btn-link text-white @(collapseSidebar ? "mx-auto" : "ms-auto") p-0 sidebar-toggle" @onclick="ToggleSidebar">
            <i class="bi @(collapseSidebar ? "bi-arrow-bar-right" : "bi-arrow-bar-left")" style="font-size: 1.3rem; filter: none; color: var(--accent);"></i>
        </button>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" style="@(collapseSidebar ? "overflow-x: hidden;" : "")">
    <nav class="nav flex-column @(collapseSidebar ? "nav-collapsed" : "")">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Home">
                <i class="bi bi-house-door-fill" aria-hidden="true"></i>
                @if (!collapseSidebar) { <span class="nav-text">Home</span> }
            </NavLink>
        </div>

        <AuthorizeView Roles="Administrador, Atendimento">
            <Authorized>
                <div class="nav-divider"></div>
                @if (!collapseSidebar) { <div class="nav-section-title px-3">Cadastros</div> }

                <!-- Menu Clientes -->
                <div class="nav-item px-3">
                    <div class="nav-link" @onclick="ToggleClientes" style="cursor: pointer;" title="Clientes">
                        <i class="bi bi-people-fill" aria-hidden="true"></i>
                        @if (!collapseSidebar)
                        {
                            <span class="nav-text">Clientes</span>
                            <i class="bi bi-chevron-@(expandClientes ? "up" : "down") ms-auto chevron-icon" aria-hidden="true"></i>
                        }
                    </div>
                    @if (expandClientes && !collapseSidebar)
                    {
                        <div class="nav-submenu">
                            <NavLink class="nav-link" href="/clientes/cadastro">
                                <i class="bi bi-person-plus-fill" aria-hidden="true"></i>
                                <span class="nav-text">Novo Cliente</span>
                            </NavLink>
                            <NavLink class="nav-link" href="/clientes" Match="NavLinkMatch.All">
                                <i class="bi bi-list-ul" aria-hidden="true"></i>
                                <span class="nav-text">Listar Clientes</span>
                            </NavLink>
                        </div>
                    }
                </div>

                <div class="nav-divider"></div>

                <!-- Menu Veículos -->
                <div class="nav-item px-3">
                    <div class="nav-link" @onclick="ToggleVeiculos" style="cursor: pointer;" title="Veículos">
                        <i class="bi bi-car-front-fill" aria-hidden="true"></i>
                        @if (!collapseSidebar)
                        {
                            <span class="nav-text">Veículos</span>
                            <i class="bi bi-chevron-@(expandVeiculos ? "up" : "down") ms-auto chevron-icon" aria-hidden="true"></i>
                        }
                    </div>
                    @if (expandVeiculos && !collapseSidebar)
                    {
                        <div class="nav-submenu">
                            <NavLink class="nav-link" href="/veiculos/cadastro">
                                <i class="bi bi-plus-circle-fill" aria-hidden="true"></i>
                                <span class="nav-text">Novo Veículo</span>
                            </NavLink>
                            <NavLink class="nav-link" href="/veiculos" Match="NavLinkMatch.All">
                                <i class="bi bi-list-ul" aria-hidden="true"></i>
                                <span class="nav-text">Listar Veículos</span>
                            </NavLink>
                        </div>
                    }
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="nav-divider"></div>

        <!-- Menu Serviços -->
        <div class="nav-item px-3">
            <div class="nav-link" @onclick="ToggleServicos" style="cursor: pointer;" title="Serviços">
                <i class="bi bi-tools" aria-hidden="true"></i>
                @if (!collapseSidebar)
                {
                    <span class="nav-text">Serviços</span>
                    <i class="bi bi-chevron-@(expandServicos ? "up" : "down") ms-auto chevron-icon" aria-hidden="true"></i>
                }
            </div>
            @if (expandServicos && !collapseSidebar)
            {
                <div class="nav-submenu">
                    <AuthorizeView Roles="Administrador, Atendimento">
                        <NavLink class="nav-link" href="/servicos/cadastro">
                            <i class="bi bi-plus-circle-fill" aria-hidden="true"></i>
                            <span class="nav-text">Novo Serviço</span>
                        </NavLink>
                    </AuthorizeView>
                    <NavLink class="nav-link" href="/servicos" Match="NavLinkMatch.All">
                        <i class="bi bi-list-ul" aria-hidden="true"></i>
                        <span class="nav-text">Listar Serviços</span>
                    </NavLink>
                </div>
            }
        </div>

        <div class="nav-divider"></div>

        <!-- Menu OS -->
        <div class="nav-item px-3">
            <div class="nav-link" @onclick="ToggleOS" style="cursor: pointer;" title="Ordens de Serviço">
                <i class="bi bi-file-earmark-text-fill" aria-hidden="true"></i>
                @if (!collapseSidebar)
                {
                    <span class="nav-text">Ordens de Serv.</span>
                    <i class="bi bi-chevron-@(expandOS ? "up" : "down") ms-auto chevron-icon" aria-hidden="true"></i>
                }
            </div>
            @if (expandOS && !collapseSidebar)
            {
                <div class="nav-submenu">
                    <AuthorizeView Roles="Administrador, Atendimento">
                        <NavLink class="nav-link" href="/ordens-servico/nova">
                            <i class="bi bi-file-earmark-plus-fill" aria-hidden="true"></i>
                            <span class="nav-text">Nova O.S.</span>
                        </NavLink>
                    </AuthorizeView>
                    <NavLink class="nav-link" href="/ordens-servico" Match="NavLinkMatch.All">
                        <i class="bi bi-list-ul" aria-hidden="true"></i>
                        <span class="nav-text">Listar O.S.</span>
                    </NavLink>
                </div>
            }
        </div>

        <AuthorizeView Roles="Administrador">
            <Authorized>
                <div class="nav-divider"></div>

                @if (!collapseSidebar) { <div class="nav-section-title px-3">Administrativo</div> }
                
                <!-- Menu Usuários -->
                <div class="nav-item px-3">
                    <div class="nav-link" @onclick="ToggleUsuarios" style="cursor: pointer;" title="Usuários">
                        <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
                        @if (!collapseSidebar)
                        {
                            <span class="nav-text">Usuários</span>
                            <i class="bi bi-chevron-@(expandUsuarios ? "up" : "down") ms-auto chevron-icon" aria-hidden="true"></i>
                        }
                    </div>
                    @if (expandUsuarios && !collapseSidebar)
                    {
                        <div class="nav-submenu">
                            <NavLink class="nav-link" href="/usuarios/cadastro">
                                <i class="bi bi-person-plus-fill" aria-hidden="true"></i>
                                <span class="nav-text">Novo Usuário</span>
                            </NavLink>
                            <NavLink class="nav-link" href="/usuarios" Match="NavLinkMatch.All">
                                <i class="bi bi-people-fill" aria-hidden="true"></i>
                                <span class="nav-text">Listar Usuários</span>
                            </NavLink>
                        </div>
                    }
                </div>
                 <!-- Menu Configurações -->
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/configuracoes">
                            <i class="bi bi-gear"></i> Configurações
                        </NavLink>
                    </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseSidebar = false;
    private bool expandClientes = false;
    private bool expandVeiculos = false;
    private bool expandServicos = false;
    private bool expandOS = false;
    private bool expandUsuarios = false;

    private void ToggleSidebar()
    {
        collapseSidebar = !collapseSidebar;
        if (collapseSidebar)
        {
            expandClientes = false;
            expandVeiculos = false;
            expandServicos = false;
            expandOS = false;
            expandUsuarios = false;
        }
    }

    private void ToggleClientes()
    {
        if (collapseSidebar) collapseSidebar = false;
        expandClientes = !expandClientes;
    }

    private void ToggleVeiculos()
    {
        if (collapseSidebar) collapseSidebar = false;
        expandVeiculos = !expandVeiculos;
    }

    private void ToggleServicos()
    {
        if (collapseSidebar) collapseSidebar = false;
        expandServicos = !expandServicos;
    }

    private void ToggleOS()
    {
        if (collapseSidebar) collapseSidebar = false;
        expandOS = !expandOS;
    }

    private void ToggleUsuarios()
    {
        if (collapseSidebar) collapseSidebar = false;
        expandUsuarios = !expandUsuarios;
    }
}