@inherits LayoutComponentBase

<div class="page">
    @* O .sidebar (largura + rótulos) é renderizado inteiramente pelo NavMenu a partir do SidebarState. *@
    <NavMenu />

    <div class="sidebar-backdrop d-md-none" onclick="closeSidebar()"></div>

    <main>
        <div class="top-row px-4">
            <button type="button" class="sidebar-toggler d-md-none" onclick="toggleSidebar()" aria-label="Abrir menu">
                <i class="bi bi-list"></i>
            </button>
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle" style="font-size: 1.2rem; color: var(--accent);"></i>
                        <span>@(context.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? context.User.Identity?.Name ?? "Usuário")</span>
                    </div>
                    <form method="post" action="/api/auth/logout" class="ms-auto">
                        <button type="submit" class="btn btn-link text-decoration-none p-0 d-flex align-items-center gap-1 btn-logout">
                            <i class="bi bi-box-arrow-right btn-logout-icon" aria-hidden="true"></i>
                            Sair
                        </button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger shadow-sm my-4" role="alert">
                        <h5 class="alert-heading fw-bold">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Não foi possível exibir esta tela
                        </h5>
                        <p class="mb-3">Ocorreu um erro inesperado ao carregar este conteúdo. Tente novamente ou volte para o início.</p>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => errorBoundary?.Recover()">
                                <i class="bi bi-arrow-clockwise me-1"></i>Tentar novamente
                            </button>
                            <a href="/" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-house me-1"></i>Ir para o início
                            </a>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet role="alert">
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <button type="button" class="dismiss btn btn-link p-0 border-0" aria-label="Fechar">🗙</button>
</div>

@code {
    private ErrorBoundary? errorBoundary;
}
