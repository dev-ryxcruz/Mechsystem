@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle" style="font-size: 1.2rem; color: var(--accent);"></i>
                        <span>@(context.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? context.User.Identity?.Name ?? "Usuário")</span>
                    </div>
                    <form method="post" action="/api/auth/logout" class="ms-auto">
                        <button type="submit" class="btn btn-link text-decoration-none p-0 d-flex align-items-center gap-1" style="color: var(--text-on-dark-muted); font-size: 0.85rem;">
                            <i class="bi bi-box-arrow-right" style="font-size: 1rem;"></i>
                            Sair
                        </button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

