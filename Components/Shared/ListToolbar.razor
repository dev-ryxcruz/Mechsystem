@namespace mechsystem.Components.Shared

<div class="card border-0 shadow-sm mb-4 list-toolbar-card">
    <div class="card-body p-3 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="search-box flex-grow-1" style="min-width: 240px; max-width: 480px;">
            <i class="bi bi-search text-muted me-2" aria-hidden="true"></i>
            <input type="text"
                   class="form-control form-control-sm border-0 shadow-none ps-0 bg-transparent"
                   placeholder="@Placeholder"
                   value="@SearchTerm"
                   @oninput="OnSearchInput" />
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
            @if (Filters != null)
            {
                @Filters
            }
            <span class="badge bg-light text-dark border px-3 py-2 list-count-chip text-nowrap">
                <i class="bi @(string.IsNullOrWhiteSpace(CountIcon) ? "bi-collection" : CountIcon) me-1" aria-hidden="true"></i>
                @TotalCount @CountLabel
            </span>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string SearchTerm { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SearchTermChanged { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Buscar...";

    [Parameter]
    public RenderFragment? Filters { get; set; }

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public string CountLabel { get; set; } = "registro(s)";

    [Parameter]
    public string? CountIcon { get; set; }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        await SearchTermChanged.InvokeAsync(SearchTerm);
    }
}
