@page "/acompanhar/{token}"
@attribute [AllowAnonymous]
@layout PublicLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using mechsystem.Data
@using mechsystem.Models
@inject AppDbContext DbContext
@inject NavigationManager NavigationManager

<PageTitle>Acompanhamento de O.S. - MechSystem</PageTitle>

<div class="public-container">
    @if (os == null)
    {
        @if (carregando)
        {
            <div class="text-center mt-5" aria-live="polite">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
                <p class="mt-3 text-muted">Buscando informações da ordem de serviço...</p>
            </div>
        }
        else if (erroCarregamento)
        {
            <div class="alert alert-warning shadow-sm mt-5 mx-auto text-dark" style="max-width: 500px;" role="alert">
                <h4 class="alert-heading"><i class="bi bi-wifi-off me-2"></i>Não foi possível carregar</h4>
                <p>Ocorreu uma falha ao consultar os dados da ordem de serviço. Verifique sua conexão e tente novamente.</p>
                <button type="button" class="btn btn-warning fw-semibold" @onclick="CarregarOrdemAsync">
                    <i class="bi bi-arrow-clockwise me-1"></i>Tentar novamente
                </button>
            </div>
        }
        else
        {
            <div class="alert alert-danger shadow-sm mt-5 mx-auto" style="max-width: 500px;" role="alert">
                <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Link Inválido</h4>
                <p class="mb-0">Não foi possível encontrar a ordem de serviço informada. Verifique se o link está correto ou entre em contato com a oficina.</p>
            </div>
        }
    }
    else
    {
        <div class="tracking-card">
            <div class="tracking-header">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-white fw-bold d-flex align-items-center">
                        <i class="bi bi-tools me-2 text-warning"></i> MechSystem Auto Center
                    </h5>
                    <span class="badge bg-dark bg-opacity-50 text-light border border-secondary border-opacity-25 rounded-pill px-3 py-2">OS Nº @os.Id.ToString("D4")</span>
                </div>
                
                <h3 class="mb-1 text-white">@os.Veiculo?.Marca / @os.Veiculo?.Modelo</h3>
                <p class="mb-0 text-white-50 fs-5 font-monospace">@os.Veiculo?.Placa</p>
            </div>

            <div class="tracking-body">
                <!-- Status Timeline/Progress -->
                <div class="status-section text-center mb-5 mt-2">
                    @{
                        int step = GetProgressStep(os.Status);
                    }

                    @if (os.Status == OrdemServicoStatus.Cancelada)
                    {
                        <div class="alert alert-danger d-inline-flex align-items-center mb-0 px-4 py-3 border-0 shadow-sm rounded-4">
                            <i class="bi bi-x-circle-fill fs-3 me-3 text-danger"></i>
                            <div class="text-start">
                                <h5 class="mb-0 fw-bold text-danger">Serviço Cancelado</h5>
                                <small class="text-danger opacity-75">Entre em contato para mais detalhes.</small>
                            </div>
                        </div>
                    }
                    else if (os.Status == OrdemServicoStatus.Recusada)
                    {
                        <div class="alert alert-warning d-inline-flex align-items-center mb-0 px-4 py-3 border-0 shadow-sm rounded-4">
                            <i class="bi bi-hand-thumbs-down-fill fs-3 me-3 text-warning"></i>
                            <div class="text-start">
                                <h5 class="mb-0 fw-bold text-dark">Orçamento Recusado</h5>
                                <small class="text-muted">Entre em contato para mais detalhes.</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <h4 class="fw-bold mb-4" style="color: @GetStatusColor(os.Status)">
                            <i class="@GetStatusIcon(os.Status) me-2"></i> @GetStatusName(os.Status)
                        </h4>

                        <div class="progress-track">
                            <div class="progress-step @(step >= 1 ? "active" : "")">
                                <div class="step-icon"><i class="bi bi-file-earmark-text"></i></div>
                                <span class="step-label">Orçamento</span>
                            </div>
                            <div class="progress-line @(step >= 2 ? "active" : "")"></div>

                            <div class="progress-step @(step >= 2 ? "active" : "")">
                                <div class="step-icon"><i class="bi bi-check-circle"></i></div>
                                <span class="step-label">Aprovada</span>
                            </div>
                            <div class="progress-line @(step >= 3 ? "active" : "")"></div>

                            <div class="progress-step @(step >= 3 ? "active" : "")">
                                <div class="step-icon"><i class="bi bi-gear-wide-connected"></i></div>
                                <span class="step-label">Execução</span>
                            </div>
                            <div class="progress-line @(step >= 4 ? "active" : "")"></div>

                            <div class="progress-step @(step >= 4 ? "active" : "")">
                                <div class="step-icon"><i class="bi bi-flag-fill"></i></div>
                                <span class="step-label">Concluída</span>
                            </div>
                            <div class="progress-line @(step >= 5 ? "active" : "")"></div>

                            <div class="progress-step @(step >= 5 ? "active" : "")">
                                <div class="step-icon"><i class="bi bi-patch-check-fill"></i></div>
                                <span class="step-label">Entregue</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-sm-6">
                        <div class="info-box">
                            <div class="info-icon text-secondary"><i class="bi bi-calendar-event"></i></div>
                            <div>
                                <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Entrada</small>
                                <span class="fw-bold fs-6">@os.DataEmissao.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        @{
                            var hojeBrasilia = DateTimeExtensions.TodayBrasilia();
                            var diasAtraso = (hojeBrasilia - os.DataPrevisaoEntrega.Date).Days;
                            bool estaFinalizada = os.Status == OrdemServicoStatus.Concluida
                                || os.Status == OrdemServicoStatus.Entregue
                                || os.Status == OrdemServicoStatus.Cancelada
                                || os.Status == OrdemServicoStatus.Recusada;
                            bool isAtrasado = diasAtraso > 0 && !estaFinalizada;
                            var diasRestantes = (os.DataPrevisaoEntrega.Date - hojeBrasilia).Days;
                        }
                        <div class="info-box @(isAtrasado ? "border-danger bg-danger bg-opacity-10" : "")">
                            <div class="info-icon @(isAtrasado ? "text-danger" : "text-primary")"><i class="bi bi-calendar-check"></i></div>
                            <div>
                                <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Previsão de Entrega</small>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="fw-bold fs-6 @(isAtrasado ? "text-danger" : "")">
                                        @os.DataPrevisaoEntrega.ToString("dd/MM/yyyy")
                                    </span>
                                    @if (!estaFinalizada)
                                    {
                                        @if (isAtrasado)
                                        {
                                            <span class="badge bg-danger">Atrasado @diasAtraso dia(s)</span>
                                        }
                                        else if (diasRestantes == 0)
                                        {
                                            <span class="badge bg-warning text-dark">É Hoje!</span>
                                        }
                                        else if (diasRestantes == 1)
                                        {
                                            <span class="badge bg-info text-dark">Amanhã</span>
                                        }
                                        else if (diasRestantes > 1)
                                        {
                                            <span class="badge bg-secondary">em @diasRestantes dias</span>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="service-details p-4 rounded-4 bg-light border">
                    <h6 class="text-muted text-uppercase fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                        <i class="bi bi-card-text me-1"></i> Serviços Listados
                    </h6>
                    @if (os.ServicosAExecutarList != null && os.ServicosAExecutarList.Any())
                    {
                        <p class="mb-0 text-dark mech-pre-wrap">@string.Join("\n", os.ServicosAExecutarList.Select(s => $"- {s.Quantidade}x {s.Servico?.Nome ?? "Serviço"}"))</p>
                    }
                    else
                    {
                        <p class="mb-0 text-dark mech-pre-wrap">Aguardando diagnóstico...</p>
                    }
                </div>
            </div>
            
            <div class="tracking-footer">
                <div class="d-flex align-items-center justify-content-center text-muted">
                    <i class="bi bi-shield-check me-2 fs-5"></i>
                    <small>Este é um link seguro e exclusivo para o seu acompanhamento.</small>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Token { get; set; } = "";

    private OrdemServico? os;
    private bool carregando = true;
    private bool erroCarregamento = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarOrdemAsync();
    }

    private async Task CarregarOrdemAsync()
    {
        carregando = true;
        erroCarregamento = false;
        try
        {
            os = await DbContext.OrdensServico
                .Include(o => o.Veiculo)
                .Include(o => o.ServicosAExecutarList)
                    .ThenInclude(s => s.Servico)
                .FirstOrDefaultAsync(o => o.TokenAcompanhamento == Token);
        }
        catch
        {
            erroCarregamento = true;
        }
        finally
        {
            carregando = false;
        }
    }

    public static int GetProgressStep(OrdemServicoStatus status) => status switch
    {
        OrdemServicoStatus.Orcamento => 1,
        OrdemServicoStatus.Aprovada => 2,
        OrdemServicoStatus.EmAndamento or OrdemServicoStatus.AguardandoPecas or OrdemServicoStatus.Pausada or OrdemServicoStatus.AguardandoCliente => 3,
        OrdemServicoStatus.Concluida => 4,
        OrdemServicoStatus.Entregue => 5,
        OrdemServicoStatus.Recusada or OrdemServicoStatus.Cancelada => 0,
        _ => throw new ArgumentOutOfRangeException(nameof(status), status, "Status de O.S. não mapeado.")
    };

    public static string GetStatusName(OrdemServicoStatus status) => status switch
    {
        OrdemServicoStatus.Orcamento => "Orçamento em análise",
        OrdemServicoStatus.Aprovada => "Orçamento aprovado",
        OrdemServicoStatus.AguardandoPecas => "Aguardando peças",
        OrdemServicoStatus.EmAndamento => "Serviço em andamento",
        OrdemServicoStatus.Pausada => "Serviço pausado",
        OrdemServicoStatus.AguardandoCliente => "Aguardando sua autorização",
        OrdemServicoStatus.Concluida => "Serviço concluído, pronto para retirada",
        OrdemServicoStatus.Entregue => "Veículo entregue",
        OrdemServicoStatus.Recusada => "Orçamento recusado",
        OrdemServicoStatus.Cancelada => "Cancelada",
        _ => throw new ArgumentOutOfRangeException(nameof(status), status, "Status de O.S. não mapeado.")
    };

    public static string GetStatusColor(OrdemServicoStatus status) => status switch
    {
        OrdemServicoStatus.Orcamento => "#5c636a",         // Secondary (contraste >= 4.5:1)
        OrdemServicoStatus.Aprovada => "#087990",          // Info escuro (contraste >= 4.5:1)
        OrdemServicoStatus.AguardandoPecas => "#b84400",   // Orange escuro (contraste >= 4.5:1)
        OrdemServicoStatus.EmAndamento => "#0d6efd",       // Primary
        OrdemServicoStatus.Pausada => "#997404",           // Amber escuro (contraste >= 4.5:1)
        OrdemServicoStatus.AguardandoCliente => "#b84400", // Orange escuro (contraste >= 4.5:1)
        OrdemServicoStatus.Concluida => "#146c43",         // Success
        OrdemServicoStatus.Entregue => "#146c43",          // Success
        OrdemServicoStatus.Recusada => "#997404",          // Amber escuro
        OrdemServicoStatus.Cancelada => "#dc3545",         // Danger
        _ => throw new ArgumentOutOfRangeException(nameof(status), status, "Status de O.S. não mapeado.")
    };

    public static string GetStatusIcon(OrdemServicoStatus status) => status switch
    {
        OrdemServicoStatus.Orcamento => "bi bi-file-earmark-text",
        OrdemServicoStatus.Aprovada => "bi bi-check-circle",
        OrdemServicoStatus.AguardandoPecas => "bi bi-box-seam",
        OrdemServicoStatus.EmAndamento => "bi bi-tools",
        OrdemServicoStatus.Pausada => "bi bi-pause-circle",
        OrdemServicoStatus.AguardandoCliente => "bi bi-hourglass-split",
        OrdemServicoStatus.Concluida => "bi bi-flag-fill",
        OrdemServicoStatus.Entregue => "bi bi-patch-check-fill",
        OrdemServicoStatus.Recusada => "bi bi-hand-thumbs-down-fill",
        OrdemServicoStatus.Cancelada => "bi bi-x-circle",
        _ => throw new ArgumentOutOfRangeException(nameof(status), status, "Status de O.S. não mapeado.")
    };
}
