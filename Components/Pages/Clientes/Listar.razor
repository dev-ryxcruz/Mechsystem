@page "/clientes"
@rendermode InteractiveServer

@using mechsystem.Models
@using mechsystem.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador, Atendimento")]

@inject IClienteRepository ClienteRepository
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h3><i class="bi bi-people"></i> Clientes Registados</h3>
        <div class="d-flex gap-2 align-items-center">
            <div class="btn-group" role="group" aria-label="Alternar visualização">
                <button type="button" class="btn btn-outline-secondary @(!IsGridView ? "active" : "")" @onclick="() => ToggleView(false)">
                    <i class="bi bi-list-ul"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary @(IsGridView ? "active" : "")" @onclick="() => ToggleView(true)">
                    <i class="bi bi-grid-fill"></i>
                </button>
            </div>
            <button class="btn btn-primary" @onclick="NovoCliente">
                <i class="bi bi-plus-lg"></i> Novo Cliente
            </button>
        </div>
    </div>

    @* Se a lista ainda estiver nula, mostramos que está a carregar *@
    @if (clientes == null)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">A carregar clientes...</p>
        </div>
    }
    @* Se a lista estiver vazia, damos um aviso amigável *@
    else if (!clientes.Any())
    {
        <div class="alert alert-info" role="alert">
            Nenhum cliente registado no sistema ainda.
        </div>
    }
    @* Se existirem clientes, montamos a tabela *@
    else
    {
        @if (IsGridView)
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var cliente in clientes)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <h5>@cliente.Nome</h5>
                                <p class="mb-1 text-muted"><i class="bi bi-person-vcard"></i> @FormatCpf(cliente.Cpf)</p>
                                <p class="mb-0 text-muted"><i class="bi bi-telephone"></i> @FormatTelefone(cliente.Telefone)</p>
                            </div>
                            <div class="card-footer bg-transparent border-0 d-flex justify-content-end gap-2">
                                <button class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => IrParaEdicao(cliente.Id)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <AuthorizeView Roles="Administrador">
                                    <Authorized>
                                        <button class="btn btn-sm btn-outline-warning" title="Inativar" @onclick="() => ApagarCliente(cliente.Id)">
                                            <i class="bi bi-archive"></i>
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>CPF</th>
                            <th>Telefone</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in clientes)
                        {
                            <tr>
                                <td>@cliente.Id</td>
                                <td><strong>@cliente.Nome</strong></td>
                                <td>@FormatCpf(cliente.Cpf)</td>
                                <td>@FormatTelefone(cliente.Telefone)</td>

                            <td class="text-end">
                                @* O botão Editar vai enviar o Id do cliente pela barra de endereço *@
                                <button class="btn btn-sm btn-outline-primary me-1" title="Editar" @onclick="() => IrParaEdicao(cliente.Id)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                
                                <AuthorizeView Roles="Administrador">
                                    <Authorized>
                                        @* O botão Eliminar chama a função de apagar diretamente *@
                                        <button class="btn btn-sm btn-outline-warning" title="Inativar" @onclick="() => ApagarCliente(cliente.Id)">
                                            <i class="bi bi-archive"></i>
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </td>                                
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
        }
    }
</div>

@code {
    private List<Cliente>? clientes;
    private Cliente _cliente = new Cliente();
    private bool IsGridView = false;

    private void ToggleView(bool gridView) => IsGridView = gridView;


    // Este método nativo do Blazor corre sozinho assim que o ecrã é aberto
    protected override async Task OnInitializedAsync()
    {
        // Pede ao repositório para ir à base de dados e trazer todos os clientes
        clientes = await ClienteRepository.Listar();
    }

    private void NovoCliente()
    {
        NavigationManager.NavigateTo("/clientes/cadastro");
    }

private void IrParaEdicao(int id)
    {
        // Redireciona para o ecrã de edição passando o ID do cliente
        NavigationManager.NavigateTo($"/clientes/editar/{id}");
    }

    private async Task ApagarCliente(int id)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.IsInRole("Administrador"))
        {
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Tem certeza que deseja inativar este cliente? Ele não aparecerá mais nas buscas, mas seu histórico será mantido.");
        if (!confirmed) return;

        // 1. Vai à base de dados e inativa o cliente
        await ClienteRepository.Deletar(id);
        
        // 2. Consulta a base de dados novamente para atualizar a tabela no ecrã
        clientes = await ClienteRepository.Listar();
    }

    private string FormatCpf(string? cpf)
    {
        if (string.IsNullOrWhiteSpace(cpf)) return string.Empty;
        var digits = new string(cpf.Where(char.IsDigit).ToArray());
        if (digits.Length != 11) return cpf;
        return $"{digits.Substring(0, 3)}.{digits.Substring(3, 3)}.{digits.Substring(6, 3)}-{digits.Substring(9, 2)}";
    }

    private string FormatTelefone(string? telefone)
    {
        if (string.IsNullOrWhiteSpace(telefone)) return string.Empty;
        var digits = new string(telefone.Where(char.IsDigit).ToArray());
        if (digits.Length == 11)
            return $"({digits.Substring(0, 2)}) {digits.Substring(2, 5)}-{digits.Substring(7, 4)}";
        else if (digits.Length == 10)
            return $"({digits.Substring(0, 2)}) {digits.Substring(2, 4)}-{digits.Substring(6, 4)}";
        return telefone;
    }
}