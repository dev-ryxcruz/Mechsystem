@page "/clientes"
@rendermode InteractiveServer

@using mechsystem.Models
@using mechsystem.Interfaces
@using mechsystem.Services
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize(Roles = "Administrador, Atendimento")]

@inject IClienteRepository ClienteRepository
@inject InativacaoService InativacaoService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ILogger<Listar> Logger

<PageTitle>Clientes Cadastrados — Mechsystem</PageTitle>

<div class="page-container">
    <PageHeader Icon="bi-people-fill" Title="Clientes Cadastrados" Subtitle="Gerencie os clientes e seus dados de contato">
        <Actions>
            <button class="btn btn-accent text-nowrap" @onclick="NovoCliente">
                <i class="bi bi-plus-lg"></i> Novo Cliente
            </button>
        </Actions>
    </PageHeader>

    <ListToolbar Placeholder="Buscar cliente por nome, CPF ou telefone..."
                 SearchTerm="@termoPesquisa"
                 SearchTermChanged="AoBuscar"
                 TotalCount="@totalRegistros"
                 CountLabel="cliente(s)"
                 CountIcon="bi-people">
        <Filters>
            <AuthorizeView Roles="Administrador">
                <Authorized>
                    <div class="btn-group" role="group" aria-label="Filtrar por estado">
                        <button type="button" id="btn-filtro-ativos" class="btn btn-sm btn-outline-success text-nowrap @(!MostrarInativos ? "active" : "")" @onclick="() => AlternarFiltro(false)">
                            <i class="bi bi-person-check"></i> Ativos
                        </button>
                        <button type="button" id="btn-filtro-inativos" class="btn btn-sm btn-outline-secondary text-nowrap @(MostrarInativos ? "active" : "")" @onclick="() => AlternarFiltro(true)">
                            <i class="bi bi-archive"></i> Inativos
                        </button>
                    </div>
                </Authorized>
            </AuthorizeView>
            <div class="btn-group" role="group" aria-label="Alternar visualização">
                <button type="button" class="btn btn-sm btn-outline-secondary @(!IsGridView ? "active" : "")" @onclick="() => ToggleView(false)" title="Visualização em Lista">
                    <i class="bi bi-list-ul"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary @(IsGridView ? "active" : "")" @onclick="() => ToggleView(true)" title="Visualização em Grade">
                    <i class="bi bi-grid-fill"></i>
                </button>
            </div>
        </Filters>
    </ListToolbar>

    @if (clientes == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Carregando clientes...</p>
        </div>
    }
    else if (!clientes.Any())
    {
        <div class="alert alert-info" role="alert">
            @(MostrarInativos ? "Nenhum cliente inativo encontrado." : "Nenhum cliente encontrado.")
        </div>
    }
    else
    {
        @if (IsGridView)
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var cliente in clientes)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <h5>@cliente.Nome</h5>
                                <p class="mb-1 text-muted"><i class="bi bi-person-vcard"></i> @FormatCpf(cliente.Cpf)</p>
                                <p class="mb-0 text-muted"><i class="bi bi-telephone"></i> @FormatTelefone(cliente.Telefone)</p>
                                @if (!cliente.Ativo && !string.IsNullOrWhiteSpace(cliente.MotivoInativacao))
                                {
                                    <small class="text-muted d-block mt-2">
                                        <i class="bi bi-info-circle me-1"></i>Motivo: @cliente.MotivoInativacao
                                    </small>
                                }
                            </div>
                            <div class="card-footer bg-transparent border-0 d-flex justify-content-end gap-2">
                                <button class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => IrParaEdicao(cliente.Id)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <AuthorizeView Roles="Administrador">
                                    <Authorized>
                                        @if (cliente.Ativo)
                                        {
                                            <button class="btn btn-sm btn-outline-warning" title="Inativar" @onclick="() => AbrirModalInativar(cliente)">
                                                <i class="bi bi-archive"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success" title="Reativar" @onclick="() => AbrirModalReativar(cliente)">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-custom align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th width="5%" class="text-center">ID</th>
                                    <th width="40%" class="text-start">Nome</th>
                                    <th width="20%" class="text-start">CPF</th>
                                    <th width="20%" class="text-start">Telefone</th>
                                    <th width="15%" class="actions-col text-end">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cliente in clientes)
                                {
                                    <tr>
                                        <td class="text-center text-muted fw-bold">#@cliente.Id</td>
                                        <td class="text-start">
                                            <strong>@cliente.Nome</strong>
                                            @if (!cliente.Ativo && !string.IsNullOrWhiteSpace(cliente.MotivoInativacao))
                                            {
                                                <small class="text-muted d-block">Motivo: @cliente.MotivoInativacao</small>
                                            }
                                        </td>
                                        <td class="text-start">@FormatCpf(cliente.Cpf)</td>
                                        <td class="text-start">@FormatTelefone(cliente.Telefone)</td>
                                        <td class="text-end text-nowrap">
                                            <button class="btn btn-sm btn-outline-primary me-1" title="Editar" @onclick="() => IrParaEdicao(cliente.Id)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <AuthorizeView Roles="Administrador">
                                                <Authorized>
                                                    @if (cliente.Ativo)
                                                    {
                                                        <button class="btn btn-sm btn-outline-warning" title="Inativar" @onclick="() => AbrirModalInativar(cliente)">
                                                            <i class="bi bi-archive"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-outline-success" title="Reativar" @onclick="() => AbrirModalReativar(cliente)">
                                                            <i class="bi bi-arrow-counterclockwise"></i>
                                                        </button>
                                                    }
                                                </Authorized>
                                            </AuthorizeView>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <SimplePagination CurrentPage="@paginaAtual"
                          PageSize="@tamanhoPagina"
                          TotalItems="@totalRegistros"
                          OnPageChanged="MudarPagina"
                          OnPageSizeChanged="MudarTamanhoPagina" />
    }
</div>

@if (ShowConfirmModal && clienteSelecionado != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-label="Confirmar Inativação de Cliente" style="background-color: rgba(0,0,0,0.5);" @onkeydown='e => { if (e.Key == "Escape") CloseConfirmModal(); }'>
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-warning text-dark border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirmar Inativação de Cliente</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseConfirmModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(erroModal))
                    {
                        <div class="alert alert-danger py-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@erroModal
                        </div>
                    }
                    <p class="mb-2 fs-5">Deseja inativar o cliente <strong>@clienteSelecionado.Nome</strong>?</p>
                    <div class="alert @(veiculosAtivosImpactados > 0 ? "alert-warning" : "alert-secondary") py-2 mb-3">
                        <i class="bi bi-car-front-fill me-1"></i>
                        @if (veiculosAtivosImpactados > 0)
                        {
                            <span><strong>Impacto em cascata:</strong> este cliente possui <strong>@veiculosAtivosImpactados veículo(s) ativo(s)</strong> que também serão inativados automaticamente.</span>
                        }
                        else
                        {
                            <span>Este cliente não possui veículos ativos vinculados no momento.</span>
                        }
                    </div>
                    <p class="text-muted small mb-3">
                        O histórico de Ordens de Serviço será preservado. Caso o cliente seja reativado futuramente, seus veículos permanecerão inativos até serem reativados individualmente.
                    </p>
                    <div class="mb-2">
                        <label class="form-label fw-bold">Motivo da inativação <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="2" placeholder="Informe o motivo (mínimo de 5 caracteres)..." @bind="motivoInativacao" @bind:event="oninput"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseConfirmModal">Cancelar</button>
                    <button type="button" class="btn btn-warning fw-bold" disabled="@( string.IsNullOrWhiteSpace(motivoInativacao) || motivoInativacao.Trim().Length < 5 )" @onclick="ConfirmInativar">
                        Inativar Cliente
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowReativarModal && clienteSelecionado != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-label="Confirmar Reativação" style="background-color: rgba(0,0,0,0.5);" @onkeydown='e => { if (e.Key == "Escape") CloseReativarModal(); }'>
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-arrow-counterclockwise me-2"></i> Confirmar Reativação</h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Fechar" @onclick="CloseReativarModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(erroModal))
                    {
                        <div class="alert alert-danger py-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@erroModal
                        </div>
                    }
                    <p class="mb-2 fs-5">Deseja reativar o cliente <strong>@clienteSelecionado.Nome</strong>?</p>
                    <p class="text-muted mb-0"><small>Ele voltará a aparecer nas buscas e poderá ser utilizado em novas ordens de serviço. Seus veículos inativos não são reativados automaticamente.</small></p>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseReativarModal">Cancelar</button>
                    <button type="button" id="btn-confirmar-reativar" class="btn btn-success" @onclick="ConfirmReativar">Reativar Cliente</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Cliente>? clientes;
    private string termoPesquisa = "";
    private int paginaAtual = 1;
    private int tamanhoPagina = 10;
    private int totalRegistros = 0;

    private bool IsGridView = false;
    private bool MostrarInativos = false;

    private bool ShowConfirmModal = false;
    private bool ShowReativarModal = false;
    private Cliente? clienteSelecionado;
    private int veiculosAtivosImpactados = 0;
    private string motivoInativacao = "";
    private string? erroModal;

    private void ToggleView(bool gridView) => IsGridView = gridView;

    protected override async Task OnInitializedAsync()
    {
        await CarregarClientes();
    }

    private async Task CarregarClientes()
    {
        var resultado = await ClienteRepository.ListarPaginadoAsync(MostrarInativos, termoPesquisa, paginaAtual, tamanhoPagina);
        clientes = resultado.Itens;
        totalRegistros = resultado.TotalCount;
    }

    private async Task AoBuscar(string termo)
    {
        termoPesquisa = termo;
        paginaAtual = 1;
        await CarregarClientes();
    }

    private async Task MudarPagina(int novaPagina)
    {
        paginaAtual = novaPagina;
        await CarregarClientes();
    }

    private async Task MudarTamanhoPagina(int novoTamanho)
    {
        tamanhoPagina = novoTamanho;
        paginaAtual = 1;
        await CarregarClientes();
    }

    private async Task AlternarFiltro(bool inativos)
    {
        if (MostrarInativos == inativos) return;
        MostrarInativos = inativos;
        paginaAtual = 1;
        clientes = null;
        await CarregarClientes();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var isMobile = await JS.InvokeAsync<bool>("isMobileScreen");
            if (isMobile && !IsGridView)
            {
                IsGridView = true;
                StateHasChanged();
            }
        }
    }

    private void NovoCliente() => NavigationManager.NavigateTo("/clientes/cadastro");
    private void IrParaEdicao(int id) => NavigationManager.NavigateTo($"/clientes/editar/{id}");

    private async Task AbrirModalInativar(Cliente cliente)
    {
        clienteSelecionado = cliente;
        motivoInativacao = "";
        erroModal = null;
        veiculosAtivosImpactados = await InativacaoService.ContarVeiculosAtivosDoClienteAsync(cliente.Id);
        ShowConfirmModal = true;
    }

    private void CloseConfirmModal()
    {
        ShowConfirmModal = false;
        clienteSelecionado = null;
        motivoInativacao = "";
        erroModal = null;
    }

    private async Task ConfirmInativar()
    {
        if (clienteSelecionado == null) return;

        try
        {
            erroModal = null;
            var (usuarioId, perfil) = await ObterUsuarioLogadoAsync();
            await InativacaoService.InativarClienteAsync(clienteSelecionado.Id, motivoInativacao, usuarioId, perfil);
            await CarregarClientes();
            CloseConfirmModal();
        }
        catch (Exception ex)
        {
            erroModal = DomainErrorHelper.ObterMensagemSegura(ex, Logger, "Não foi possível inativar o cliente.");
        }
    }

    private void AbrirModalReativar(Cliente cliente)
    {
        clienteSelecionado = cliente;
        erroModal = null;
        ShowReativarModal = true;
    }

    private void CloseReativarModal()
    {
        ShowReativarModal = false;
        clienteSelecionado = null;
        erroModal = null;
    }

    private async Task ConfirmReativar()
    {
        if (clienteSelecionado == null) return;

        try
        {
            erroModal = null;
            var (usuarioId, perfil) = await ObterUsuarioLogadoAsync();
            await InativacaoService.ReativarClienteAsync(clienteSelecionado.Id, usuarioId, perfil);
            await CarregarClientes();
            CloseReativarModal();
        }
        catch (Exception ex)
        {
            erroModal = DomainErrorHelper.ObterMensagemSegura(ex, Logger, "Não foi possível reativar o cliente.");
        }
    }

    private async Task<(int usuarioId, PerfilUsuario? perfil)> ObterUsuarioLogadoAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var idStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var roleStr = user.FindFirst(ClaimTypes.Role)?.Value;

        int.TryParse(idStr, out var usuarioId);
        PerfilUsuario? perfil = Enum.TryParse<PerfilUsuario>(roleStr, out var p) ? p : null;
        return (usuarioId, perfil);
    }

    private string FormatCpf(string? cpf)
    {
        if (string.IsNullOrWhiteSpace(cpf)) return string.Empty;
        var digits = new string(cpf.Where(char.IsDigit).ToArray());
        if (digits.Length != 11) return cpf;
        return $"{digits.Substring(0, 3)}.{digits.Substring(3, 3)}.{digits.Substring(6, 3)}-{digits.Substring(9, 2)}";
    }

    private string FormatTelefone(string? telefone)
    {
        if (string.IsNullOrWhiteSpace(telefone)) return string.Empty;
        var digits = new string(telefone.Where(char.IsDigit).ToArray());
        if (digits.Length == 11)
            return $"({digits.Substring(0, 2)}) {digits.Substring(2, 5)}-{digits.Substring(7, 4)}";
        else if (digits.Length == 10)
            return $"({digits.Substring(0, 2)}) {digits.Substring(2, 4)}-{digits.Substring(6, 4)}";
        return telefone;
    }
}
