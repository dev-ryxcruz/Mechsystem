@page "/clientes"
@rendermode InteractiveServer

@using mechsystem.Models
@using mechsystem.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador, Atendimento")]

@inject IClienteRepository ClienteRepository
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="mb-0"><i class="bi bi-people"></i> Clientes Registados</h3>
        <button class="btn btn-primary text-nowrap" @onclick="NovoCliente">
            <i class="bi bi-plus-lg"></i> Novo Cliente
        </button>
    </div>

    @* Barra de ferramentas: pesquisa ocupa o espaço disponível, filtros à direita *@
    <div class="d-flex gap-2 align-items-center flex-wrap mb-4">
        <div class="input-group flex-grow-1" style="min-width: 240px; max-width: 520px;">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="pesquisa-cliente" class="form-control border-start-0 ps-0 shadow-none" placeholder="Pesquisar cliente..." @bind="termoPesquisa" @bind:event="oninput" />
        </div>
        <div class="d-flex gap-2 ms-auto flex-wrap">
            <AuthorizeView Roles="Administrador">
                <Authorized>
                    <div class="btn-group" role="group" aria-label="Filtrar por estado">
                        <button type="button" id="btn-filtro-ativos" class="btn btn-outline-success text-nowrap @(!MostrarInativos ? "active" : "")" @onclick="() => AlternarFiltro(false)">
                            <i class="bi bi-person-check"></i> Ativos
                        </button>
                        <button type="button" id="btn-filtro-inativos" class="btn btn-outline-secondary text-nowrap @(MostrarInativos ? "active" : "")" @onclick="() => AlternarFiltro(true)">
                            <i class="bi bi-archive"></i> Inativos
                        </button>
                    </div>
                </Authorized>
            </AuthorizeView>
            <div class="btn-group" role="group" aria-label="Alternar visualização">
                <button type="button" class="btn btn-outline-secondary @(!IsGridView ? "active" : "")" @onclick="() => ToggleView(false)">
                    <i class="bi bi-list-ul"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary @(IsGridView ? "active" : "")" @onclick="() => ToggleView(true)">
                    <i class="bi bi-grid-fill"></i>
                </button>
            </div>
        </div>
    </div>

    @* Se a lista ainda estiver nula, mostramos que está a carregar *@
    @if (clientes == null)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">A carregar clientes...</p>
        </div>
    }
    @* Se a lista estiver vazia, damos um aviso amigável *@
    else if (!clientes.Any())
    {
        <div class="alert alert-info" role="alert">
            @(MostrarInativos ? "Nenhum cliente inativo." : "Nenhum cliente registado no sistema ainda.")
        </div>
    }
    @* Se existirem clientes, montamos a tabela *@
    else
    {
        @if (IsGridView)
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var cliente in ClientesFiltrados!)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <h5>@cliente.Nome</h5>
                                <p class="mb-1 text-muted"><i class="bi bi-person-vcard"></i> @FormatCpf(cliente.Cpf)</p>
                                <p class="mb-0 text-muted"><i class="bi bi-telephone"></i> @FormatTelefone(cliente.Telefone)</p>
                            </div>
                            <div class="card-footer bg-transparent border-0 d-flex justify-content-end gap-2">
                                <button class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => IrParaEdicao(cliente.Id)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <AuthorizeView Roles="Administrador">
                                    <Authorized>
                                        @if (cliente.Ativo)
                                        {
                                            <button class="btn btn-sm btn-outline-warning" title="Inativar" @onclick="() => ApagarCliente(cliente.Id)">
                                                <i class="bi bi-archive"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success" title="Reativar" @onclick="() => ReativarCliente(cliente.Id)">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-borderless align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th width="5%" class="text-center">ID</th>
                            <th width="40%" class="text-start">Nome</th>
                            <th width="20%" class="text-start">CPF</th>
                            <th width="20%" class="text-start">Telefone</th>
                            <th width="15%" class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in ClientesFiltrados!)
                        {
                            <tr>
                                <td class="text-center">@cliente.Id</td>
                                <td class="text-start"><strong>@cliente.Nome</strong></td>
                                <td class="text-start">@FormatCpf(cliente.Cpf)</td>
                                <td class="text-start">@FormatTelefone(cliente.Telefone)</td>

                            <td class="text-center">
                                @* O botão Editar vai enviar o Id do cliente pela barra de endereço *@
                                <button class="btn btn-sm btn-outline-primary me-1" title="Editar" @onclick="() => IrParaEdicao(cliente.Id)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                
                                <AuthorizeView Roles="Administrador">
                                    <Authorized>
                                        @if (cliente.Ativo)
                                        {
                                            @* O botão Inativar abre o modal de confirmação *@
                                            <button class="btn btn-sm btn-outline-warning" title="Inativar" @onclick="() => ApagarCliente(cliente.Id)">
                                                <i class="bi bi-archive"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            @* O botão Reativar devolve o cliente à lista de ativos *@
                                            <button class="btn btn-sm btn-outline-success" title="Reativar" @onclick="() => ReativarCliente(cliente.Id)">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }
                                    </Authorized>
                                </AuthorizeView>
                            </td>                                
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
        }
    }
</div>

@if (ShowConfirmModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-warning text-dark border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirmar Inativação</h5>
                    <button type="button" class="btn-close" @onclick="CloseConfirmModal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0 fs-5">Tem certeza que deseja inativar este cliente?</p>
                    <p class="text-muted mt-2 mb-0"><small>Ele não aparecerá mais nas buscas, mas o seu histórico será mantido e permanecerá associado às ordens de serviço existentes.</small></p>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseConfirmModal">Cancelar</button>
                    <button type="button" class="btn btn-warning" @onclick="ConfirmInativar">Inativar Cliente</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowReativarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-arrow-counterclockwise me-2"></i> Confirmar Reativação</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseReativarModal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0 fs-5">Tem certeza que deseja reativar este cliente?</p>
                    <p class="text-muted mt-2 mb-0"><small>Ele voltará a aparecer nas buscas e poderá ser utilizado em novas ordens de serviço.</small></p>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseReativarModal">Cancelar</button>
                    <button type="button" id="btn-confirmar-reativar" class="btn btn-success" @onclick="ConfirmReativar">Reativar Cliente</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Cliente>? clientes;
    private string termoPesquisa = "";
    private IEnumerable<Cliente>? ClientesFiltrados => string.IsNullOrWhiteSpace(termoPesquisa) 
        ? clientes 
        : clientes?.Where(c => 
            (c.Nome != null && c.Nome.Contains(termoPesquisa, StringComparison.OrdinalIgnoreCase)) ||
            (c.Cpf != null && c.Cpf.Contains(termoPesquisa, StringComparison.OrdinalIgnoreCase)) ||
            (c.Telefone != null && c.Telefone.Contains(termoPesquisa, StringComparison.OrdinalIgnoreCase)));

    private Cliente _cliente = new Cliente();
    private bool IsGridView = false;
    private bool MostrarInativos = false;

    private void ToggleView(bool gridView) => IsGridView = gridView;


    // Este método nativo do Blazor corre sozinho assim que o ecrã é aberto
    protected override async Task OnInitializedAsync()
    {
        // Pede ao repositório para ir à base de dados e trazer todos os clientes
        await CarregarClientes();
    }

    // Carrega os clientes ativos ou inativos conforme o filtro selecionado
    private async Task CarregarClientes()
    {
        clientes = MostrarInativos
            ? await ClienteRepository.ListarInativos()
            : await ClienteRepository.Listar();
    }

    private async Task AlternarFiltro(bool inativos)
    {
        if (MostrarInativos == inativos) return;
        MostrarInativos = inativos;
        clientes = null;
        await CarregarClientes();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var isMobile = await JS.InvokeAsync<bool>("isMobileScreen");
            if (isMobile && !IsGridView)
            {
                IsGridView = true;
                StateHasChanged();
            }
        }
    }

    private void NovoCliente()
    {
        NavigationManager.NavigateTo("/clientes/cadastro");
    }

private void IrParaEdicao(int id)
    {
        // Redireciona para o ecrã de edição passando o ID do cliente
        NavigationManager.NavigateTo($"/clientes/editar/{id}");
    }

    private bool ShowConfirmModal = false;
    private int ClienteIdToInactivate = 0;

    private void ApagarCliente(int id)
    {
        ClienteIdToInactivate = id;
        ShowConfirmModal = true;
    }

    private void CloseConfirmModal()
    {
        ShowConfirmModal = false;
        ClienteIdToInactivate = 0;
    }

    private async Task ConfirmInativar()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.IsInRole("Administrador"))
        {
            CloseConfirmModal();
            return;
        }

        // 1. Vai à base de dados e inativa o cliente
        await ClienteRepository.Deletar(ClienteIdToInactivate);
        
        // 2. Consulta a base de dados novamente para atualizar a tabela no ecrã
        await CarregarClientes();
        
        CloseConfirmModal();
    }

    private bool ShowReativarModal = false;
    private int ClienteIdToReactivate = 0;

    private void ReativarCliente(int id)
    {
        ClienteIdToReactivate = id;
        ShowReativarModal = true;
    }

    private void CloseReativarModal()
    {
        ShowReativarModal = false;
        ClienteIdToReactivate = 0;
    }

    private async Task ConfirmReativar()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.IsInRole("Administrador"))
        {
            CloseReativarModal();
            return;
        }

        // 1. Vai à base de dados e reativa o cliente
        await ClienteRepository.Reativar(ClienteIdToReactivate);

        // 2. Atualiza a lista no ecrã (o cliente sai da lista de inativos)
        await CarregarClientes();

        CloseReativarModal();
    }

    private string FormatCpf(string? cpf)
    {
        if (string.IsNullOrWhiteSpace(cpf)) return string.Empty;
        var digits = new string(cpf.Where(char.IsDigit).ToArray());
        if (digits.Length != 11) return cpf;
        return $"{digits.Substring(0, 3)}.{digits.Substring(3, 3)}.{digits.Substring(6, 3)}-{digits.Substring(9, 2)}";
    }

    private string FormatTelefone(string? telefone)
    {
        if (string.IsNullOrWhiteSpace(telefone)) return string.Empty;
        var digits = new string(telefone.Where(char.IsDigit).ToArray());
        if (digits.Length == 11)
            return $"({digits.Substring(0, 2)}) {digits.Substring(2, 5)}-{digits.Substring(7, 4)}";
        else if (digits.Length == 10)
            return $"({digits.Substring(0, 2)}) {digits.Substring(2, 4)}-{digits.Substring(6, 4)}";
        return telefone;
    }
}