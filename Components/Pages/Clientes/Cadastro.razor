@page "/clientes/cadastro"
@rendermode InteractiveServer

@using mechsystem.Models
@using mechsystem.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador, Atendimento")]

@inject IClienteRepository ClienteRepository
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ILogger<Cadastro> Logger

<PageTitle>Novo Cliente — Mechsystem</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Novo Cliente</h2>
        <p class="text-muted mb-0">Cadastre um novo cliente no sistema</p>
    </div>
    <a href="/clientes" class="btn btn-outline-secondary shadow-sm">
        <i class="bi bi-arrow-left me-2"></i>Voltar
    </a>
</div>

<div class="card shadow-sm dash-card">
    <div class="card-body p-4">
        @if (!string.IsNullOrEmpty(erroMensagem))
        {
            <div class="alert alert-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@erroMensagem
            </div>
        }

        <EditForm Model="@cliente" OnValidSubmit="SalvarCliente">
            <DataAnnotationsValidator />

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Nome Completo <span class="text-danger">*</span></label>
                        <InputText @bind-Value="cliente.Nome" class="form-control" placeholder="Ex: João da Silva" />
                        <ValidationMessage For="@(() => cliente.Nome)" class="text-danger mt-1 small" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">CPF <span class="text-danger">*</span></label>
                        <InputText @bind-Value="cliente.Cpf" class="form-control mask-cpf" placeholder="Apenas números" />
                        <ValidationMessage For="@(() => cliente.Cpf)" class="text-danger mt-1 small" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">E-mail</label>
                        <InputText @bind-Value="cliente.Email" class="form-control" placeholder="joao@email.com" />
                        <ValidationMessage For="@(() => cliente.Email)" class="text-danger mt-1 small" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Telefone</label>
                        <InputText @bind-Value="cliente.Telefone" class="form-control mask-telefone" placeholder="(00) 00000-0000" />
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Endereço</label>
                        <InputText @bind-Value="cliente.Endereco" class="form-control" placeholder="Rua, Número, Bairro, Cidade" />
                    </div>
                </div>
            </div>

            <hr class="my-4 text-muted" />

            <div class="d-flex justify-content-end gap-2">
                <a href="/clientes" class="btn btn-light px-4 border">Cancelar</a>
                <button type="submit" class="btn btn-success px-4 shadow-sm">
                    <i class="bi bi-save me-1"></i> Salvar Cliente
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private Cliente cliente = new Cliente();
    private string? erroMensagem;

    private async Task SalvarCliente()
    {
        try
        {
            erroMensagem = null;
            await ClienteRepository.Salvar(cliente);
            NavigationManager.NavigateTo("/clientes");
        }
        catch (Exception ex)
        {
            erroMensagem = DomainErrorHelper.ObterMensagemSegura(ex, Logger, "Ocorreu um erro ao salvar o cliente. Verifique se o CPF já está cadastrado.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("applyMasks");
        }
    }
}
