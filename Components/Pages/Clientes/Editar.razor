@page "/clientes/editar/{Id:int}"
@rendermode InteractiveServer

@using mechsystem.Models
@using mechsystem.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador, Atendimento")]

@inject IClienteRepository ClienteRepository
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ILogger<Editar> Logger

<PageTitle>Editar Cliente — Mechsystem</PageTitle>

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Editar Cliente</h4>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(erroMensagem))
            {
                <div class="alert alert-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@erroMensagem
                </div>
            }

            <EditForm Model="@cliente" OnValidSubmit="SalvarEdicao">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nome Completo</label>
                        <InputText @bind-Value="cliente.Nome" class="form-control" />
                        <ValidationMessage For="@(() => cliente.Nome)" class="text-danger" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">CPF</label>
                        <InputText @bind-Value="cliente.Cpf" class="form-control mask-cpf" />
                        <ValidationMessage For="@(() => cliente.Cpf)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">E-mail</label>
                        <InputText @bind-Value="cliente.Email" class="form-control" />
                        <ValidationMessage For="@(() => cliente.Email)" class="text-danger" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Telefone</label>
                        <InputText @bind-Value="cliente.Telefone" class="form-control mask-telefone" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Endereço</label>
                    <InputText @bind-Value="cliente.Endereco" class="form-control" />
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-warning fw-bold">
                        <i class="bi bi-save"></i> Salvar Alterações
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                        Cancelar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Cliente cliente = new Cliente();
    private string? erroMensagem;

    protected override async Task OnInitializedAsync()
    {
        var clienteEncontrado = await ClienteRepository.BuscarPorId(Id);
        if (clienteEncontrado != null)
        {
            cliente = clienteEncontrado;
        }
        else
        {
            NavigationManager.NavigateTo("/clientes");
        }
    }

    private async Task SalvarEdicao()
    {
        try
        {
            erroMensagem = null;
            await ClienteRepository.Atualizar(cliente);
            NavigationManager.NavigateTo("/clientes");
        }
        catch (Exception ex)
        {
            erroMensagem = DomainErrorHelper.ObterMensagemSegura(ex, Logger, "Ocorreu um erro ao atualizar o cliente. Verifique se o CPF já está cadastrado.");
        }
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo("/clientes");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("applyMasks");
        }
    }
}
