@page "/usuarios"
@rendermode InteractiveServer
@using mechsystem.Models
@using mechsystem.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@inject UsuarioService UsuarioService

<PageTitle>Gerenciar Usuários - Mechsystem</PageTitle>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="bi bi-people-fill"></i> Usuários</h3>
        <a href="/usuarios/cadastro" class="btn btn-primary">
            <i class="bi bi-person-plus-fill"></i> Novo Usuário
        </a>
    </div>

@if (usuarios == null)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
    </div>
}
else if (!usuarios.Any())
{
    <div class="text-center mt-5 text-muted">
        <i class="bi bi-inbox fs-1"></i>
        <p class="mt-2">Nenhum usuário encontrado.</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nome Completo</th>
                        <th>Usuário (Login)</th>
                        <th>Perfil</th>
                        <th>Cadastrado em</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in usuarios)
                    {
                        <tr>
                            <td><strong>@usuario.NomeCompleto</strong></td>
                            <td>@usuario.Username</td>
                            <td>
                                @switch (usuario.Perfil)
                                {
                                    case PerfilUsuario.Administrador:
                                        <span class="badge bg-danger shadow-sm"><i class="bi bi-shield-lock-fill me-1"></i>Admin</span>
                                        break;
                                    case PerfilUsuario.Atendimento:
                                        <span class="badge bg-info shadow-sm text-dark"><i class="bi bi-headset me-1"></i>Atendimento</span>
                                        break;
                                    case PerfilUsuario.Mecanico:
                                        <span class="badge bg-warning shadow-sm text-dark"><i class="bi bi-wrench-adjustable me-1"></i>Mecânico</span>
                                        break;
                                }
                            </td>
                            <td>@usuario.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (usuario.Ativo)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i>Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2"><i class="bi bi-x-circle me-1"></i>Inativo</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a href="/usuarios/editar/@usuario.Id" class="btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                @if (usuario.Username != "admin" || !usuario.Ativo)
                                {
                                    @if(usuario.Username != "admin")
                                    {
                                         <button @onclick="() => ToggleStatus(usuario)" class="btn btn-sm btn-outline-@(usuario.Ativo ? "danger" : "success") ms-2 d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-@(usuario.Ativo ? "person-dash-fill" : "person-check-fill")"></i>
                                            @(usuario.Ativo ? "Desativar" : "Ativar")
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
</div>

@code {
    private List<Usuario>? usuarios;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsuarios();
    }

    private async Task LoadUsuarios()
    {
        usuarios = await UsuarioService.GetUsuariosAsync();
    }

    private async Task ToggleStatus(Usuario usuario)
    {
        if (usuario.Username == "admin") return;

        usuario.Ativo = !usuario.Ativo;
        await UsuarioService.UpdateUsuarioAsync(usuario);
        await LoadUsuarios();
    }
}
