@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager

<PageTitle>Login — Mechsystem</PageTitle>

<div class="login-card">
    <div class="login-header">
        <div class="login-logo">
            <i class="bi bi-gear-wide-connected"></i>
        </div>
        <h1 class="login-title">Mechsystem</h1>
        <p class="login-subtitle">Acesse sua conta para continuar</p>
    </div>

    <form method="post" action="/api/auth/login" class="login-form">
        <div class="form-group">
            <label for="username" class="form-label">
                <i class="bi bi-person"></i>
                Usuário
            </label>
            <input
                id="username"
                name="username"
                type="text"
                class="form-input"
                placeholder="Digite seu usuário"
                required
                autocomplete="username" />
        </div>

        <div class="form-group">
            <label for="password" class="form-label">
                <i class="bi bi-lock"></i>
                Senha
            </label>
            <input
                id="password"
                name="password"
                type="password"
                class="form-input"
                placeholder="Digite sua senha"
                required
                autocomplete="current-password" />
        </div>

        @if (showError)
        {
            <div class="login-error">
                <i class="bi bi-exclamation-triangle"></i>
                Usuário ou senha inválidos.
            </div>
        }

        <button type="submit" class="login-btn">
            <span>Entrar</span>
            <i class="bi bi-arrow-right"></i>
        </button>
    </form>

    <div class="login-footer">
        <i class="bi bi-shield-lock"></i>
        Conexão segura
    </div>
</div>

@code {
    private bool showError;

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    protected override void OnInitialized()
    {
        showError = !string.IsNullOrEmpty(Error);
    }
}