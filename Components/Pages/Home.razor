@page "/"
@page "/home"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using mechsystem.Data
@using mechsystem.Models
@using mechsystem.Services
@inject AppDbContext DbContext
@inject EstoqueService EstoqueService

<PageTitle>Painel Estratégico (BI) — Mechsystem</PageTitle>

<div class="dashboard pb-5">

    <!-- Header -->
    <div class="dash-header mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-graph-up-arrow me-2" style="color: var(--accent);"></i>Visão Executiva</h2>
            <p class="text-muted mb-0">Painel Financeiro, Operacional e Inteligência de Mercado / @GetPeriodLabel()</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            @if (totalAtrasadas > 0)
            {
                <div class="pulse-alert bg-danger text-white px-3 py-2 rounded shadow-sm d-flex align-items-center me-2">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>
                        <span class="d-block fw-bold" style="font-size: 0.85rem; line-height: 1;">Atenção Operacional</span>
                        <span style="font-size: 0.75rem;">@totalAtrasadas O.S. Atrasadas!</span>
                    </div>
                </div>
            }
            @if (pecasEmRuptura != null && pecasEmRuptura.Any())
            {
                <a href="/estoque" class="pulse-alert bg-warning text-dark px-3 py-2 rounded shadow-sm d-flex align-items-center me-2 text-decoration-none">
                    <i class="bi bi-box-seam-fill me-2 fs-5"></i>
                    <div>
                        <span class="d-block fw-bold" style="font-size: 0.85rem; line-height: 1;">Ruptura de Estoque</span>
                        <span style="font-size: 0.75rem;">@pecasEmRuptura.Count peça(s) abaixo do mínimo!</span>
                    </div>
                </a>
            }
            <a href="/ordens-servico/nova" class="btn btn-accent shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Nova O.S.
            </a>
        </div>
    </div>

    <!-- Filtro de Período -->
    <div class="period-filter d-flex align-items-center gap-2 mb-4 flex-wrap">
        <div class="btn-group shadow-sm" role="group">
            <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousMonth" disabled="@isAllTime" title="Mês anterior">
                <i class="bi bi-chevron-left"></i>
            </button>
            <span class="btn btn-sm btn-outline-secondary px-3 fw-bold pe-none" style="min-width: 180px; opacity: 1 !important; color: var(--text-color, #333) !important;">
                <i class="bi bi-calendar3 me-1"></i>@GetPeriodLabel()
            </span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="NextMonth" disabled="@(isAllTime || IsCurrentMonth())" title="Próximo mês">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
        <button class="btn btn-sm @(isAllTime ? "btn-accent text-white shadow-sm" : "btn-outline-secondary")" @onclick="ToggleAllTime">
            <i class="bi bi-calendar-range me-1"></i>Acumulado Geral
        </button>
        @if (!isAllTime && !IsCurrentMonth())
        {
            <button class="btn btn-sm btn-link text-muted text-decoration-none" @onclick="async () => { selectedMonth = DateTime.Today.Month; selectedYear = DateTime.Today.Year; await LoadDashboardData(); }">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Voltar ao mês atual
            </button>
        }
    </div>

    <!-- ROW 1: KPIs Rápidos (Dono e Chefe) -->
    <div class="row g-3 mb-4">
        
        <!-- Previsão de Caixa (Dinheiro em Andamento) -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card shadow-sm stat-card border-top-accent">
                <div class="stat-body flex-row align-items-center justify-content-between w-100">
                    <div>
                        <span class="kpi-label">Previsão de Caixa</span>
                        <span class="kpi-value text-accent d-block">@dinheiroNaMesa.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
                        <span class="stat-subtext mt-1 text-muted">@totalEmAndamento O.S. Em Andamento</span>
                    </div>
                    <div class="stat-icon bg-light-accent text-accent fs-3 opacity-75">
                        <i class="bi bi-safe"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ticket Médio -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card shadow-sm stat-card border-top-primary">
                <div class="stat-body flex-row align-items-center justify-content-between w-100">
                    <div>
                        <span class="kpi-label">Ticket Médio (OS Concluída)</span>
                        <span class="kpi-value text-primary d-block">@ticketMedio.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
                        <span class="stat-subtext mt-1 text-muted">@totalOSConcluidasMes O.S. pagas no mês</span>
                    </div>
                    <div class="stat-icon bg-light-primary text-primary fs-3 opacity-75">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Faturamento Realizado do Mês Total Numerico -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card shadow-sm stat-card border-top-success">
                <div class="stat-body flex-row align-items-center justify-content-between w-100">
                    <div>
                        <span class="kpi-label">Faturamento Total (Mês)</span>
                        <span class="kpi-value text-success d-block">@faturamentoMes.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
                        <span class="stat-subtext mt-1 text-muted">Lucro Bruto + Peças</span>
                    </div>
                    <div class="stat-icon bg-light-success text-success fs-3 opacity-75">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Capital Imobilizado em Estoque -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card shadow-sm stat-card border-top-dark">
                <div class="stat-body flex-row align-items-center justify-content-between w-100">
                    <div>
                        <span class="kpi-label">Capital Imobilizado</span>
                        <span class="kpi-value text-dark d-block">@capitalImobilizado.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
                        <span class="stat-subtext mt-1 text-muted">Valor parado em peças</span>
                    </div>
                    <div class="stat-icon bg-light text-dark fs-3 opacity-75">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ROW 1.5: Margem de Lucro Real + Idade Frota + Alerta Ruptura -->
    <div class="row g-3 mb-4">
        <!-- Margem de Lucro Real -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card shadow-sm stat-card" style="border-top: 4px solid #27ae60 !important;">
                <div class="stat-body flex-row align-items-center justify-content-between w-100">
                    <div>
                        <span class="kpi-label">Margem Real (Peças)</span>
                        <span class="kpi-value d-block" style="color: #27ae60;">@margemLucroReal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
                        <span class="stat-subtext mt-1 text-muted">Lucro líquido peças no mês</span>
                    </div>
                    <div class="stat-icon fs-3 opacity-75" style="background: #e8f8f0; color: #27ae60;">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Idade Média da Frota -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card shadow-sm stat-card border-top-dark">
                <div class="stat-body flex-row align-items-center justify-content-between w-100">
                    <div>
                        <span class="kpi-label">Idade Média da Frota</span>
                        <span class="kpi-value text-dark d-block">@idadeMediaFrota.ToString("0.#") Anos</span>
                        <span class="stat-subtext mt-1 text-muted">@totalVeiculos Veículos na base</span>
                    </div>
                    <div class="stat-icon bg-light text-dark fs-3 opacity-75">
                        <i class="bi bi-car-front"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alerta de Ruptura -->
        <div class="col-sm-12 col-xl-6">
            <div class="kpi-card shadow-sm h-100" style="border-top: 4px solid @(pecasEmRuptura != null && pecasEmRuptura.Any() ? "#dc3545" : "#28a745") !important;">
                <div class="w-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="kpi-label">
                            <i class="bi bi-exclamation-triangle-fill me-1" style="color: @(pecasEmRuptura != null && pecasEmRuptura.Any() ? "#dc3545" : "#28a745")"></i>
                            Alerta de Ruptura
                        </span>
                        <a href="/estoque" class="badge bg-dark text-decoration-none" style="font-size: 0.7rem;">Ver Estoque →</a>
                    </div>
                    @if (pecasEmRuptura != null && pecasEmRuptura.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var peca in pecasEmRuptura.Take(6))
                            {
                                <div class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1" style="font-size: 0.78rem;">
                                    <i class="bi bi-exclamation-circle me-1"></i>@peca.Sku — <strong>@peca.EstoqueAtual un.</strong>
                                </div>
                            }
                            @if (pecasEmRuptura.Count > 6)
                            {
                                <div class="badge bg-light text-dark border">+@(pecasEmRuptura.Count - 6) mais</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-success d-flex align-items-center gap-2" style="font-size: 0.9rem;">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Estoque OK — nenhuma peça abaixo do mínimo.</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ROW 2: DONUTS E GAUGES -->
    <div class="row g-3 mb-4 d-flex align-items-stretch">
        
        <!-- Distribuição de Receita -->
        <div class="col-md-4">
            <div class="card shadow-sm dash-card h-100">
                <div class="card-body text-center p-4">
                    <h6 class="fw-bold mb-3 text-start text-muted"><i class="bi bi-pie-chart me-2"></i>Distribuição de Receita</h6>
                    
                    @{
                        var pctMaoObra = faturamentoMes > 0 ? (faturamentoMaoDeObra / faturamentoMes) * 100 : 0;
                        var pctPecas = faturamentoMes > 0 ? (faturamentoPecas / faturamentoMes) * 100 : 0;
                    }

                    <div class="d-flex justify-content-center mb-4 mt-2">
                        <div class="donut-chart" style="background: conic-gradient(#198754 0% @pctMaoObra.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%, #fd7e14 @pctMaoObra.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)% 100%);">
                            <div class="donut-hole d-flex flex-column align-items-center justify-content-center bg-white">
                                <span class="d-block text-muted" style="font-size: 0.75rem; text-transform: uppercase; font-weight: bold; letter-spacing: 1px;">Receita</span>
                                <span class="fs-4 fw-bold text-dark" style="line-height: 1.1;">@faturamentoMes.ToString("C0", new System.Globalization.CultureInfo("pt-BR"))</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-around px-2">
                        <div class="text-start">
                            <span class="d-flex align-items-center gap-1 mb-1" style="font-size: 0.85rem;"><span class="dot bg-success"></span>Mão de Obra</span>
                            <strong class="d-block">@Math.Round(pctMaoObra)%</strong>
                            <small class="text-muted">@faturamentoMaoDeObra.ToString("C0", new System.Globalization.CultureInfo("pt-BR"))</small>
                        </div>
                        <div class="text-start">
                             <span class="d-flex align-items-center gap-1 mb-1" style="font-size: 0.85rem;"><span class="dot" style="background-color: #fd7e14;"></span>Peças</span>
                            <strong class="d-block">@Math.Round(pctPecas)%</strong>
                            <small class="text-muted">@faturamentoPecas.ToString("C0", new System.Globalization.CultureInfo("pt-BR"))</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Marcas Mais Atendidas (Mercado) -->
        <div class="col-md-4">
            <div class="card shadow-sm dash-card h-100">
                <div class="card-body text-center p-4">
                    <h6 class="fw-bold mb-3 text-start text-muted"><i class="bi bi-bullseye me-2"></i>Market Share (Marcas Atendidas)</h6>
                    
                    @if (topMarcas != null && topMarcas.Any())
                    {
                        var totalTopMarcas = topMarcas.Sum(x => x.Quantidade);
                        var cores = new string[] { "#4e73df", "#1cc88a", "#36b9cc", "#f6c23e", "#e74c3c" };
                        
                        var stops = "";
                        double sum = 0;
                        for(int i = 0; i < topMarcas.Count; i++)
                        {
                            var pct = totalTopMarcas > 0 ? (topMarcas[i].Quantidade * 100.0) / totalTopMarcas : 0;
                            stops += $"{cores[i]} {sum.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}% {(sum + pct).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%,";
                            sum += pct;
                        }
                        stops = stops.TrimEnd(',');

                        <div class="d-flex justify-content-center mb-4 mt-2">
                            <div class="donut-chart" style="background: conic-gradient(@stops);">
                                <div class="donut-hole bg-white d-flex flex-column align-items-center justify-content-center">
                                    <span class="fs-4 fw-bold text-dark">Top 5</span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 text-start justify-content-center" style="font-size: 0.85rem;">
                            @for(int i=0; i<topMarcas.Count; i++)
                            {
                                <div class="col-auto d-flex align-items-center mb-1 px-3">
                                    <span class="dot me-2" style="background-color: @cores[i]"></span>
                                    <span class="text-truncate" style="max-width: 100px;" title="@topMarcas[i].Nome">@topMarcas[i].Nome</span>
                                    <strong class="ms-2 text-dark">@topMarcas[i].Quantidade</strong>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="bi bi-car-front fs-2 mb-2"></i>
                            <p>Sem dados suficientes neste mês.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Taxa de Conversão Funcional (Orçamentos vs Recusados/Aprovados) -->
        <div class="col-md-4">
            <div class="card shadow-sm dash-card h-100">
                 <div class="card-body text-center p-4">
                    <h6 class="fw-bold mb-3 text-start text-muted"><i class="bi bi-funnel me-2"></i>Taxa de Conversão do Mês</h6>
                    
                    <div class="d-flex justify-content-center mb-4 mt-2">
                        <div class="donut-chart" style="background: conic-gradient(var(--accent) @taxaConversao.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%, #e9ecef 0);">
                            <div class="donut-hole bg-white d-flex align-items-center justify-content-center" style="box-shadow: inset 0 2px 5px rgba(0,0,0,0.05);">
                                <span class="h2 fw-bold mb-0 text-dark">@Math.Round(taxaConversao)%</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="text-start bg-light rounded p-3">
                        <p class="text-muted small mb-0" style="font-size: 0.85rem;">
                            Avaliando todos os Orçamentos abertos este mês:<br/>
                            <strong class="text-success">@totalAprovadasMes aprovados</strong> contra <br/>
                            <strong class="text-danger">@totalCanceladasMes cancelados/perdidos</strong> (Desconsiderando os que ainda aguardam resposta).
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ROW 3: BARRAS E LISTAS (Operacional) -->
    <div class="row g-3">
        
        <!-- Funil Operacional Vertical -->
        <div class="col-lg-7">
            <div class="card shadow-sm dash-card h-100">
                <div class="card-header bg-white border-bottom-0 pb-0 pt-3">
                    <h6 class="mb-0 fw-bold text-muted"><i class="bi bi-bar-chart-fill me-2"></i>Funil da Oficina (Volume do Mês)</h6>
                </div>
                <div class="card-body px-4 pb-4 pt-2">
                    <p class="small text-muted mb-4">Acompanha onde estão paralisados os veículos no fluxo de trabalho.</p>
                    
                    <div class="funnel-container d-flex justify-content-between align-items-end mt-4" style="height: 200px; padding-bottom: 30px; border-bottom: 2px solid #e9ecef;">
                        
                        @{
                            var labels = new string[] { "Orçamento", "Aguardando Peças", "Andamento", "Concluídas", "Canceladas" };
                            var colors = new string[] { "#f6c23e", "#36b9cc", "#4e73df", "#1cc88a", "#e74c3c" };
                        }

                        @for (int i = 0; i < 5; i++)
                        {
                            var hPct = maxFunil > 0 ? (funilData[i] * 100.0) / maxFunil : 0;
                            if (hPct < 3) hPct = 3; // min height
                            
                            <div class="funnel-bar-wrapper d-flex flex-column align-items-center" style="width: 19%;">
                                <div class="bg-white px-2 py-1 rounded shadow-sm fw-bold border" style="font-size: 0.85rem; z-index: 2; margin-bottom: -15px; position:relative;">@funilData[i]</div>
                                <div class="funnel-bar" style="height: @(hPct)%; background-color: @colors[i]; width: 70%; border-radius: 4px 4px 0 0; transition: height 1s ease;">
                                </div>
                                <span class="funnel-label position-absolute w-100 start-0" style="bottom: -28px; font-size: 0.72rem; font-weight: 600; text-align: center; color: #555; white-space: nowrap;">@labels[i]</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Top 5 Serviços Realizados -->
        <div class="col-lg-5">
            <div class="card shadow-sm dash-card h-100">
                <div class="card-header bg-white border-bottom-0 pb-0 pt-3">
                    <h6 class="mb-0 fw-bold text-muted"><i class="bi bi-list-stars me-2"></i>Top 5 Serviços (Campeões)</h6>
                </div>
                <div class="card-body p-0 mt-3">
                    @if (topServicos != null && topServicos.Any())
                    {
                        var maxServico = topServicos.First().Quantidade;
                        
                        <div class="list-group list-group-flush pb-2">
                            @foreach(var servico in topServicos)
                            {
                                var pctServ = maxServico > 0 ? (servico.Quantidade * 100.0) / maxServico : 0;
                                <div class="list-group-item border-0 py-2">
                                    <div class="d-flex justify-content-between mb-1" style="font-size: 0.85rem;">
                                        <span class="fw-bold text-dark text-truncate pe-2">@servico.Nome</span>
                                        <span class="badge bg-light text-dark border">@servico.Quantidade vezes</span>
                                    </div>
                                    <div class="progress" style="height: 6px; border-radius: 3px;">
                                        <div class="progress-bar" style="background-color: var(--accent); width: @pctServ.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted h-100 d-flex flex-column justify-content-center">
                            <i class="bi bi-tools fs-2 mb-2"></i>
                            <p class="mb-0 small">Nenhum serviço registrado neste mês ainda.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- ROW 4: RELATÓRIOS INSTANTÂNEOS (Demonstração POO: Classe Abstrata + Override + Polimorfismo) -->
    <div class="row g-3 mt-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-muted mb-0"><i class="bi bi-file-earmark-bar-graph me-2"></i>Relatórios Instantâneos</h6>
                <span class="badge bg-dark bg-opacity-75 px-3 py-2" style="font-size: 0.72rem;">
                    <i class="bi bi-cpu me-1"></i>Gerados via Polimorfismo (POO)
                </span>
            </div>
        </div>

        @if (relatoriosGerados != null)
        {
            @foreach (var relatorio in relatoriosGerados)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm dash-card h-100 report-card" style="border-left: 5px solid @relatorio.GetCorTema() !important;">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center mb-2">
                                <div class="report-icon me-3 d-flex align-items-center justify-content-center rounded" style="width: 42px; height: 42px; background: @(relatorio.GetCorTema())15; flex-shrink: 0;">
                                    <i class="bi @relatorio.GetIcone() fs-5" style="color: @relatorio.GetCorTema();"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0" style="font-size: 0.9rem; color: @relatorio.GetCorTema();">@relatorio.Titulo</h6>
                                    <small class="text-muted" style="font-size: 0.7rem;">@relatorio.GetDataFormatada()</small>
                                </div>
                            </div>
                            <div class="bg-light rounded p-2 mt-2" style="font-size: 0.78rem; line-height: 1.7; word-break: break-word;">
                                @foreach (var parte in relatorio.GerarResumo().Split(" | "))
                                {
                                    <span class="d-block"><i class="bi bi-dot text-muted"></i>@parte</span>
                                }
                            </div>
                            <div class="text-end mt-2">
                                <small class="text-muted fst-italic" style="font-size: 0.65rem;">
                                    @relatorio.GetCabecalho()
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

</div>

<style>
    /* Clean Exec Dashboard Styles */
    :root {
        --dark-bg: #1e222d;
        --light-primary: #e6f0ff;
        --light-accent: #f0ecfc;
        --light-success: #e8f5e9;
        --light-warning: #fff8e1;
    }

    body {
        background-color: #f8f9fc; /* Super soft background */
    }

    .border-top-accent { border-top: 4px solid var(--accent) !important; }
    .border-top-primary { border-top: 4px solid #4e73df !important; }
    .border-top-success { border-top: 4px solid #1cc88a !important; }
    .border-top-dark { border-top: 4px solid #5a5c69 !important; }

    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .btn-accent {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
        font-weight: 600;
        padding: 0.5rem 1.2rem;
        border-radius: 0.5rem;
    }
    .btn-accent:hover {
        background: var(--accent-hover);
        color: #fff;
        box-shadow: 0 4px 15px var(--accent-glow);
    }

    .bg-light-primary { background-color: var(--light-primary); }
    .bg-light-accent { background-color: var(--light-accent); }
    .bg-light-success { background-color: var(--light-success); }
    .text-accent { color: var(--accent); }

    /* Standard KPI Card */
    .kpi-card {
        display: flex;
        align-items: center;
        padding: 1.5rem;
        border-radius: 0.75rem;
        background: #fff;
        border: 1px solid rgba(0,0,0,0.05); /* Soft border instead of all white */
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
    }
    .kpi-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.07) !important;
    }
    
    .stat-card {
        flex-direction: row;
        align-items: center;
        width: 100%;
    }
    .stat-body {
        display: flex;
        width: 100%;
    }
    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .kpi-value {
        font-size: 1.6rem;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.5px;
    }
    .kpi-label {
        font-size: 0.75rem;
        color: #858796; /* Clean crisp gray */
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.25rem;
        display: block;
    }
    .stat-subtext {
        font-size: 0.75rem;
        font-weight: 500;
        display: block;
    }

    /* Donut Charts */
    .donut-chart {
        width: 160px;
        height: 160px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
    .donut-hole {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        box-shadow: inset 0 2px 5px rgba(0,0,0,0.05);
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }

    /* Dash Cards */
    .dash-card {
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 0.5rem; /* Slightly tighter radius for formal look */
        transition: box-shadow 0.2s;
    }
    .dash-card:hover {
        box-shadow: 0 8px 15px rgba(0,0,0,0.05) !important;
    }

    /* Funnel Layout */
    .funnel-container {
        position: relative;
    }
    .funnel-bar-wrapper {
        position: relative;
        height: 100%;
        justify-content: flex-end;
    }
    .funnel-bar {
        box-shadow: 0 -2px 5px rgba(0,0,0,0.1);
    }

    /* Animations */
    .pulse-alert {
        animation: pulse-red 2s infinite;
    }
    
    @@keyframes pulse-red {
        0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
        70% { box-shadow: 0 0 0 6px rgba(220, 53, 69, 0); }
        100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }

    /* ── Responsividade Mobile ── */
    @@media (max-width: 768px) {

        /* Dashboard header: empilhar e centralizar botão */
        .dash-header {
            flex-direction: column;
            align-items: stretch;
        }
        .dash-header > div:last-child {
            justify-content: stretch;
        }
        .dash-header .btn-accent {
            width: 100%;
            justify-content: center;
        }

        /* Pulse alerts: empilhar */
        .pulse-alert {
            width: 100%;
            justify-content: center;
        }

        /* KPI values: reduzir fonte */
        .kpi-value {
            font-size: 1.25rem;
        }

        /* KPI card: padding menor */
        .kpi-card {
            padding: 1rem;
        }

        /* Stat icon: menor */
        .stat-icon {
            width: 40px;
            height: 40px;
            font-size: 1.2rem !important;
        }

        /* Donut charts: reduzir tamanho */
        .donut-chart {
            width: 120px;
            height: 120px;
        }
        .donut-hole {
            width: 88px;
            height: 88px;
        }

        /* Funnel: labels menores, sem nowrap */
        .funnel-label {
            font-size: 0.62rem !important;
            white-space: normal !important;
            text-align: center !important;
        }
        .funnel-container {
            height: 160px !important;
        }
    }

    @@media (max-width: 480px) {
        .kpi-value {
            font-size: 1.1rem;
        }

        .donut-chart {
            width: 100px;
            height: 100px;
        }
        .donut-hole {
            width: 72px;
            height: 72px;
        }

        /* Donut center text: reduzir */
        .donut-hole .fs-4 {
            font-size: 0.95rem !important;
        }
    }

    /* Period Filter Bar */
    .period-filter .btn-group .btn {
        border-color: #dee2e6;
        font-size: 0.82rem;
    }
    .period-filter .btn-group .btn:hover:not(:disabled) {
        background-color: #f0f0f0;
    }
    .period-filter .btn-outline-secondary:disabled {
        opacity: 0.5;
    }

    /* Report Cards (POO: Polimorfismo) */
    .report-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 0.5rem;
    }
    .report-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.08) !important;
    }
    .report-icon {
        border-radius: 0.5rem;
    }

</style>

@code {
    // Filtro de Período
    private int selectedMonth;
    private int selectedYear;
    private bool isAllTime;

    // Totais e Informações Base
    private int totalVeiculos;
    private int totalAtrasadas;
    private decimal idadeMediaFrota;
    
    // Status e Fluxo (Previsão de Caixa)
    private int totalEmAndamento;
    private decimal dinheiroNaMesa;

    // Métricas Financeiras e Médias
    private decimal faturamentoMes;
    private decimal faturamentoMaoDeObra;
    private decimal faturamentoPecas;
    private decimal ticketMedio;
    private int totalOSConcluidasMes;

    // Inteligência e Conversão
    private double taxaConversao;
    private int totalAprovadasMes;
    private int totalCanceladasMes;

    // Estoque / BI
    private decimal capitalImobilizado;
    private decimal margemLucroReal;
    private List<mechsystem.Models.Peca> pecasEmRuptura = new();

    // Relatórios POO (Classe Abstrata + Override + Polimorfismo)
    private List<Relatorio> relatoriosGerados = new();

    // Listas e Rankings
    private int[] funilData = new int[5];
    private int maxFunil = 1;

    private List<TopRankingItem> topMarcas = new();
    private List<TopRankingItem> topServicos = new();

    public class TopRankingItem
    {
        public string Nome { get; set; } = "N/A";
        public int Quantidade { get; set; }
    }

    [Inject] NavigationManager Nav { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        selectedMonth = DateTime.Today.Month;
        selectedYear = DateTime.Today.Year;
        isAllTime = false;
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        var hoje = DateTime.Today;
        DateTime? filtroInicio = isAllTime ? null : new DateTime(selectedYear, selectedMonth, 1);
        DateTime? filtroFim = isAllTime ? null : filtroInicio?.AddMonths(1);

        // 1. Idade Média da Frota (sempre geral)
        var veiculosComAno = await DbContext.Veiculos.Where(v => v.Ano > 1900 && v.Ano <= hoje.Year).ToListAsync();
        totalVeiculos = veiculosComAno.Count;
        idadeMediaFrota = veiculosComAno.Any() ? (decimal)veiculosComAno.Average(v => hoje.Year - v.Ano) : 0;

        // 2. Faturamento e Ticket Médio (OS Concluídas no período)
        var queryConc = DbContext.OrdensServico
            .Include(o => o.PecasUtilizadas)
            .Where(o => o.Status == OrdemServicoStatus.Concluida);
        if (filtroInicio != null) queryConc = queryConc.Where(o => o.DataAutorizacao >= filtroInicio);
        if (filtroFim != null) queryConc = queryConc.Where(o => o.DataAutorizacao < filtroFim);
        var osConcluidas = await queryConc.ToListAsync();
            
        totalOSConcluidasMes = osConcluidas.Count;
        faturamentoMaoDeObra = osConcluidas.Sum(o => o.ValorMaoDeObra);
        faturamentoPecas = osConcluidas.Sum(o => o.ValorPecasEfetivo);
        faturamentoMes = faturamentoMaoDeObra + faturamentoPecas;
        ticketMedio = totalOSConcluidasMes > 0 ? faturamentoMes / totalOSConcluidasMes : 0;

        // 3. Previsão de Caixa (Em Andamento — sempre real-time)
        var osEmAndamento = await DbContext.OrdensServico
            .Where(o => o.Status == OrdemServicoStatus.EmAndamento)
            .ToListAsync();
        totalEmAndamento = osEmAndamento.Count;
        dinheiroNaMesa = osEmAndamento.Sum(o => o.ValorTotal);

        // 4. Atrasos Operacionais (sempre real-time)
        totalAtrasadas = await DbContext.OrdensServico
            .CountAsync(o => (o.Status == OrdemServicoStatus.EmAndamento || o.Status == OrdemServicoStatus.AguardandoPecas) 
                              && o.DataPrevisaoEntrega.Date < hoje);

        // 5. Funil de OS (período selecionado)
        var queryFunil = DbContext.OrdensServico.AsQueryable();
        if (filtroInicio != null) queryFunil = queryFunil.Where(o => o.DataEmissao >= filtroInicio);
        if (filtroFim != null) queryFunil = queryFunil.Where(o => o.DataEmissao < filtroFim);
        var osPeriodo = await queryFunil
            .Select(o => new { o.Status, o.ServicoAExecutar, o.Veiculo })
            .ToListAsync();

        funilData[0] = osPeriodo.Count(o => o.Status == OrdemServicoStatus.Orcamento);
        funilData[1] = osPeriodo.Count(o => o.Status == OrdemServicoStatus.AguardandoPecas);
        funilData[2] = osPeriodo.Count(o => o.Status == OrdemServicoStatus.EmAndamento);
        funilData[3] = osPeriodo.Count(o => o.Status == OrdemServicoStatus.Concluida);
        funilData[4] = osPeriodo.Count(o => o.Status == OrdemServicoStatus.Cancelada);
        maxFunil = funilData.Max();
        if(maxFunil == 0) maxFunil = 1;

        // 6. Taxa de Conversão
        totalAprovadasMes = funilData[1] + funilData[2] + funilData[3];
        totalCanceladasMes = funilData[4];
        var totalDecididas = totalAprovadasMes + totalCanceladasMes;
        taxaConversao = totalDecididas > 0 ? (totalAprovadasMes * 100.0) / totalDecididas : 0;

        // 7. Top Marcas (período selecionado)
        var queryMarcas = DbContext.OrdensServico
            .Include(o => o.Veiculo)
            .Where(o => o.Veiculo != null && !string.IsNullOrEmpty(o.Veiculo.Marca));
        if (filtroInicio != null) queryMarcas = queryMarcas.Where(o => o.DataEmissao >= filtroInicio);
        if (filtroFim != null) queryMarcas = queryMarcas.Where(o => o.DataEmissao < filtroFim);
        var marcasAtendidas = await queryMarcas.Select(o => o.Veiculo!.Marca).ToListAsync();
            
        topMarcas = marcasAtendidas
            .GroupBy(m => m?.ToUpper().Trim() ?? "Outro")
            .Select(g => new TopRankingItem { Nome = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(g.Key.ToLower()), Quantidade = g.Count() })
            .OrderByDescending(x => x.Quantidade)
            .Take(5)
            .ToList();

        // 8. Top 5 Serviços Realizados
        topServicos = osPeriodo
            .Where(o => !string.IsNullOrEmpty(o.ServicoAExecutar))
            .GroupBy(o => o.ServicoAExecutar!.Trim().ToUpper())
            .Select(g => new TopRankingItem { Nome = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(g.Key.ToLower()), Quantidade = g.Count() })
            .OrderByDescending(x => x.Quantidade)
            .Take(5)
            .ToList();

        // 9. Estoque — Alertas de Ruptura (sempre real-time)
        pecasEmRuptura = await EstoqueService.GetAlertasRupturaAsync();

        // 10. Capital Imobilizado (sempre real-time)
        capitalImobilizado = await EstoqueService.GetCapitalImobilizadoAsync();

        // 11. Margem de Lucro Real (período selecionado)
        var margemInicio = filtroInicio ?? DateTime.MinValue;
        var margemFim = filtroFim ?? DateTime.MaxValue;
        var (lucro, _) = await EstoqueService.GetMargemLucroRealAsync(margemInicio, margemFim);
        margemLucroReal = lucro;

        // 12. Gerar Relatórios via Polimorfismo (POO: abstract + override)
        GerarRelatorios();
    }

    /// <summary>
    /// Demonstração de POLIMORFISMO: instancia classes filhas (RelatorioOS, RelatorioEstoque, RelatorioFinanceiro)
    /// e as armazena em uma lista do tipo base (List<Relatorio>).
    /// Ao renderizar no HTML, chamamos GerarResumo(), GetIcone() e GetCorTema() —
    /// métodos abstratos que cada classe filha sobrescreve (override).
    /// </summary>
    private void GerarRelatorios()
    {
        relatoriosGerados = new List<Relatorio>();

        // 1. Relatório de Ordens de Serviço (RelatorioOS : Relatorio)
        var relOS = new RelatorioOS
        {
            Titulo = "Ordens de Serviço",
            TotalOS = funilData.Sum(),
            TotalConcluidas = funilData[3],
            TotalCanceladas = funilData[4],
            TotalEmAndamento = funilData[2],
            TotalOrcamentos = funilData[0],
            FaturamentoTotal = faturamentoMes,
            TicketMedio = ticketMedio,
            TaxaConversao = taxaConversao
        };
        relatoriosGerados.Add(relOS); // Adicionado como Relatorio (tipo base)

        // 2. Relatório de Estoque (RelatorioEstoque : Relatorio)
        var totalPecas = DbContext.Pecas.Count();
        var pecasAtivas = DbContext.Pecas.Count(p => p.Ativo);
        var margemMedia = DbContext.Pecas.Where(p => p.Ativo && p.PrecoVenda > 0)
            .AsEnumerable()
            .Select(p => p.MargemLucro)
            .DefaultIfEmpty(0)
            .Average();
        var totalMov = DbContext.MovimentacoesEstoque.Count();

        var relEstoque = new RelatorioEstoque
        {
            Titulo = "Controle de Estoque",
            TotalPecasCadastradas = totalPecas,
            PecasAtivas = pecasAtivas,
            PecasAbaixoDoMinimo = pecasEmRuptura?.Count ?? 0,
            CapitalImobilizado = capitalImobilizado,
            MargemLucroMedia = (decimal)margemMedia,
            TotalMovimentacoes = totalMov
        };
        relatoriosGerados.Add(relEstoque); // Adicionado como Relatorio (tipo base)

        // 3. Relatório Financeiro (RelatorioFinanceiro : Relatorio)
        var relFinanceiro = new RelatorioFinanceiro
        {
            Titulo = "Panorama Financeiro",
            ReceitaMaoDeObra = faturamentoMaoDeObra,
            ReceitaPecas = faturamentoPecas,
            ReceitaTotal = faturamentoMes,
            LucroRealPecas = margemLucroReal,
            CapitalImobilizado = capitalImobilizado,
            TotalOSPagas = totalOSConcluidasMes
        };
        relatoriosGerados.Add(relFinanceiro); // Adicionado como Relatorio (tipo base)
    }

    // --- Navegação de Período ---
    private async Task PreviousMonth()
    {
        if (selectedMonth == 1) { selectedMonth = 12; selectedYear--; }
        else selectedMonth--;
        await LoadDashboardData();
    }

    private async Task NextMonth()
    {
        if (selectedMonth == 12) { selectedMonth = 1; selectedYear++; }
        else selectedMonth++;
        await LoadDashboardData();
    }

    private async Task ToggleAllTime()
    {
        isAllTime = !isAllTime;
        if (!isAllTime) { selectedMonth = DateTime.Today.Month; selectedYear = DateTime.Today.Year; }
        await LoadDashboardData();
    }

    private bool IsCurrentMonth() => selectedYear == DateTime.Today.Year && selectedMonth == DateTime.Today.Month;

    private string GetPeriodLabel()
    {
        if (isAllTime) return "ACUMULADO GERAL";
        return new DateTime(selectedYear, selectedMonth, 1)
            .ToString("MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR")).ToUpper();
    }

    private void NavigateTo(int id)
    {
        Nav.NavigateTo($"/ordens-servico/{id}");
    }
}
