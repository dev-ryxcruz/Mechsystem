@page "/veiculos/editar/{Id:int}"
@rendermode InteractiveServer

@using mechsystem.Models
@using mechsystem.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador, Atendimento")]

@inject IVeiculoRepository VeiculoRepository
@inject IClienteRepository ClienteRepository
@inject NavigationManager NavigationManager
@inject ILogger<Editar> Logger

<PageTitle>Editar Veículo — Mechsystem</PageTitle>

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Veículo</h4>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(erroMensagem))
            {
                <div class="alert alert-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@erroMensagem
                </div>
            }

            <EditForm Model="@veiculo" OnValidSubmit="SalvarEdicao">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label text-success fw-bold">Cliente (Proprietário do Veículo)</label>
                    <InputSelect @bind-Value="veiculo.ClienteId" class="form-select">
                        <option value="0">-- Selecione um Cliente --</option>
                        @if (clientes != null)
                        {
                            @foreach (var c in clientes)
                            {
                                <option value="@c.Id">@c.Nome (CPF: @c.Cpf)@(!c.Ativo ? " [Inativo]" : "")</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => veiculo.ClienteId)" class="text-danger" />
                </div>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Placa</label>
                        <InputText @bind-Value="veiculo.Placa" class="form-control text-uppercase" />
                        <ValidationMessage For="@(() => veiculo.Placa)" class="text-danger" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Marca</label>
                        <InputText @bind-Value="veiculo.Marca" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Modelo</label>
                        <InputText @bind-Value="veiculo.Modelo" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Cor</label>
                        <InputText @bind-Value="veiculo.Cor" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Ano</label>
                        <InputNumber @bind-Value="veiculo.Ano" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Quilometragem (Km)</label>
                        <InputNumber @bind-Value="veiculo.Quilometragem" class="form-control" />
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-warning fw-bold">
                        <i class="bi bi-save"></i> Salvar Alterações
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                        Cancelar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Veiculo veiculo = new Veiculo();
    private List<Cliente>? clientes;
    private string? erroMensagem;

    protected override async Task OnInitializedAsync()
    {
        clientes = await ClienteRepository.Listar();

        var veiculoEncontrado = await VeiculoRepository.BuscarPorId(Id);
        if (veiculoEncontrado != null)
        {
            veiculo = veiculoEncontrado;
            if (clientes.All(c => c.Id != veiculo.ClienteId))
            {
                var donoAtual = await ClienteRepository.BuscarPorId(veiculo.ClienteId);
                if (donoAtual != null)
                {
                    clientes.Add(donoAtual);
                }
            }
        }
        else
        {
            NavigationManager.NavigateTo("/veiculos");
        }
    }

    private async Task SalvarEdicao()
    {
        if (veiculo.ClienteId == 0)
        {
            erroMensagem = "Selecione o cliente proprietário do veículo.";
            return;
        }

        try
        {
            erroMensagem = null;
            await VeiculoRepository.Atualizar(veiculo);
            NavigationManager.NavigateTo("/veiculos");
        }
        catch (Exception ex)
        {
            erroMensagem = DomainErrorHelper.ObterMensagemSegura(ex, Logger, "Ocorreu um erro ao atualizar o veículo. Verifique se a placa já está cadastrada.");
        }
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo("/veiculos");
    }
}
