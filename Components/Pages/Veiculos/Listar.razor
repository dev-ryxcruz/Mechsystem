@page "/veiculos"
@rendermode InteractiveServer

@using mechsystem.Models
@using mechsystem.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador, Atendimento, Mecanico")]

@inject IVeiculoRepository VeiculoRepository
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="mb-0"><i class="bi bi-car-front"></i> Veículos Cadastrados</h3>
        <AuthorizeView Roles="Administrador, Atendimento">
            <button class="btn btn-success text-nowrap" @onclick="NovoVeiculo">
                <i class="bi bi-plus-lg"></i> Novo Veículo
            </button>
        </AuthorizeView>
    </div>

    @* Barra de ferramentas: pesquisa ocupa o espaço disponível, filtros à direita *@
    <div class="d-flex gap-2 align-items-center flex-wrap mb-4">
        <div class="input-group flex-grow-1" style="min-width: 240px; max-width: 520px;">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="pesquisa-veiculo" class="form-control border-start-0 ps-0 shadow-none" placeholder="Pesquisar veículo..." @bind="termoPesquisa" @bind:event="oninput" />
        </div>
        <div class="d-flex gap-2 ms-auto flex-wrap">
            <AuthorizeView Roles="Administrador">
                <div class="btn-group" role="group" aria-label="Filtrar por estado">
                    <button type="button" id="btn-filtro-veiculos-ativos" class="btn btn-outline-success text-nowrap @(!MostrarInativos ? "active" : "")" @onclick="() => AlternarFiltro(false)">
                        <i class="bi bi-check-circle"></i> Ativos
                    </button>
                    <button type="button" id="btn-filtro-veiculos-inativos" class="btn btn-outline-secondary text-nowrap @(MostrarInativos ? "active" : "")" @onclick="() => AlternarFiltro(true)">
                        <i class="bi bi-archive"></i> Inativos
                    </button>
                </div>
            </AuthorizeView>
            <div class="btn-group" role="group" aria-label="Alternar visualização">
                <button type="button" class="btn btn-outline-secondary @(!IsGridView ? "active" : "")" @onclick="() => ToggleView(false)">
                    <i class="bi bi-list-ul"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary @(IsGridView ? "active" : "")" @onclick="() => ToggleView(true)">
                    <i class="bi bi-grid-fill"></i>
                </button>
            </div>
        </div>
    </div>

    @if (veiculos == null)
    {
        <div class="text-center">
            <div class="spinner-border text-success" role="status"></div>
            <p class="mt-2">Carregando veículos...</p>
        </div>
    }
    else if (!veiculos.Any())
    {
        <div class="alert alert-info" role="alert">
            @(MostrarInativos ? "Nenhum veículo inativo." : "Nenhum veículo cadastrado no sistema ainda.")
        </div>
    }
    else
    {
        @if (IsGridView)
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var veiculo in VeiculosFiltrados!)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <h5>@veiculo.Marca @veiculo.Modelo</h5>
                                <p class="mb-1 text-muted"><i class="bi bi-calendar"></i> @veiculo.Ano - @veiculo.Cor</p>
                                <p class="mb-1"><span class="text-uppercase border px-2 py-1 rounded bg-light">@veiculo.Placa</span></p>
                                <AuthorizeView Roles="Administrador, Atendimento">
                                    <p class="mb-0 mt-2 text-muted small"><i class="bi bi-person"></i> Dono: @(veiculo.Cliente != null ? veiculo.Cliente.Nome : "Sem dono")</p>
                                </AuthorizeView>
                            </div>
                            <div class="card-footer bg-transparent border-0 d-flex justify-content-end gap-2">
                                <button class="btn btn-sm btn-outline-info" title="Prontuário" @onclick="() => IrParaDetalhes(veiculo.Id)">
                                    <i class="bi bi-journal-medical"></i>
                                </button>
                                <AuthorizeView Roles="Administrador, Atendimento">
                                    <button class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => IrParaEdicao(veiculo.Id)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </AuthorizeView>
                                <AuthorizeView Roles="Administrador">
                                    @if (veiculo.Ativo)
                                    {
                                        <button class="btn btn-sm btn-outline-warning" title="Inativar" @onclick="() => ApagarVeiculo(veiculo.Id)">
                                            <i class="bi bi-archive"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success" title="Reativar" @onclick="() => ReativarVeiculo(veiculo.Id)">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    }
                                </AuthorizeView>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-borderless align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th width="5%" class="text-center">ID</th>
                            <AuthorizeView Roles="Administrador, Atendimento">
                                <th width="20%" class="text-start">Dono (Cliente)</th>
                            </AuthorizeView>
                            <th width="15%" class="text-start">Placa</th>
                            <th width="25%" class="text-start">Marca/Modelo</th>
                            <th width="10%" class="text-center">Ano</th>
                            <th width="10%" class="text-center">Cor</th>
                            <th width="15%" class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var veiculo in VeiculosFiltrados!)
                        {
                            <tr>
                                <td class="text-center">@veiculo.Id</td>
                                <AuthorizeView Roles="Administrador, Atendimento">
                                    <td class="text-start"><strong>@(veiculo.Cliente != null ? veiculo.Cliente.Nome : "Sem dono")</strong></td>
                                </AuthorizeView>
                                <td class="text-start"><span class="text-uppercase border px-2 py-1 rounded bg-light">@veiculo.Placa</span></td>
                                <td class="text-start">@veiculo.Marca @veiculo.Modelo</td>
                                <td class="text-center">@veiculo.Ano</td>
                                <td class="text-center">@veiculo.Cor</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-info me-1" title="Prontuário" @onclick="() => IrParaDetalhes(veiculo.Id)">
                                        <i class="bi bi-journal-medical"></i>
                                    </button>
                                    <AuthorizeView Roles="Administrador, Atendimento">
                                        <button class="btn btn-sm btn-outline-primary me-1" title="Editar" @onclick="() => IrParaEdicao(veiculo.Id)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </AuthorizeView>
                                    <AuthorizeView Roles="Administrador">
                                        @if (veiculo.Ativo)
                                        {
                                            <button class="btn btn-sm btn-outline-warning" title="Inativar" @onclick="() => ApagarVeiculo(veiculo.Id)">
                                                <i class="bi bi-archive"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success" title="Reativar" @onclick="() => ReativarVeiculo(veiculo.Id)">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }
                                    </AuthorizeView>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
        }
    }
</div>

@if (ShowConfirmModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-warning text-dark border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirmar Inativação</h5>
                    <button type="button" class="btn-close" @onclick="CloseConfirmModal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0 fs-5">Tem certeza que deseja inativar este veículo?</p>
                    <p class="text-muted mt-2 mb-0"><small>Ele não aparecerá mais nas buscas, mas o seu histórico será mantido e permanecerá associado às ordens de serviço existentes.</small></p>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseConfirmModal">Cancelar</button>
                    <button type="button" class="btn btn-warning" @onclick="ConfirmInativar">Inativar Veículo</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowReativarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-arrow-counterclockwise me-2"></i> Confirmar Reativação</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseReativarModal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0 fs-5">Tem certeza que deseja reativar este veículo?</p>
                    <p class="text-muted mt-2 mb-0"><small>Ele voltará a aparecer nas buscas e poderá ser utilizado em novas ordens de serviço.</small></p>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseReativarModal">Cancelar</button>
                    <button type="button" id="btn-confirmar-reativar-veiculo" class="btn btn-success" @onclick="ConfirmReativar">Reativar Veículo</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Veiculo>? veiculos;
    private string termoPesquisa = "";
    private IEnumerable<Veiculo>? VeiculosFiltrados => string.IsNullOrWhiteSpace(termoPesquisa) 
        ? veiculos 
        : veiculos?.Where(v => 
            (v.Placa != null && v.Placa.Contains(termoPesquisa, StringComparison.OrdinalIgnoreCase)) ||
            (v.Marca != null && v.Marca.Contains(termoPesquisa, StringComparison.OrdinalIgnoreCase)) ||
            (v.Modelo != null && v.Modelo.Contains(termoPesquisa, StringComparison.OrdinalIgnoreCase)) ||
            (v.Cliente?.Nome != null && v.Cliente.Nome.Contains(termoPesquisa, StringComparison.OrdinalIgnoreCase)));

    private bool IsGridView = false;
    private bool MostrarInativos = false;
    private bool ShowConfirmModal = false;
    private int VeiculoIdToInactivate = 0;
    private bool ShowReativarModal = false;
    private int VeiculoIdToReactivate = 0;

    private void ToggleView(bool gridView) => IsGridView = gridView;

    protected override async Task OnInitializedAsync()
    {
        await CarregarVeiculos();
    }

    // Carrega os veículos ativos ou inativos conforme o filtro selecionado
    private async Task CarregarVeiculos()
    {
        veiculos = MostrarInativos
            ? await VeiculoRepository.ListarInativos()
            : await VeiculoRepository.Listar();
    }

    private async Task AlternarFiltro(bool inativos)
    {
        if (MostrarInativos == inativos) return;
        MostrarInativos = inativos;
        veiculos = null;
        await CarregarVeiculos();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var isMobile = await JS.InvokeAsync<bool>("isMobileScreen");
            if (isMobile && !IsGridView)
            {
                IsGridView = true;
                StateHasChanged();
            }
        }
    }

    private void NovoVeiculo()
    {
        NavigationManager.NavigateTo("/veiculos/cadastro");
    }

    private void IrParaEdicao(int id)
    {
        NavigationManager.NavigateTo($"/veiculos/editar/{id}");
    }

    private void IrParaDetalhes(int id)
    {
        NavigationManager.NavigateTo($"/veiculos/detalhes/{id}");
    }

    private void ApagarVeiculo(int id)
    {
        VeiculoIdToInactivate = id;
        ShowConfirmModal = true;
    }

    private void CloseConfirmModal()
    {
        ShowConfirmModal = false;
        VeiculoIdToInactivate = 0;
    }

    private async Task ConfirmInativar()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.IsInRole("Administrador"))
        {
            CloseConfirmModal();
            return;
        }

        await VeiculoRepository.Deletar(VeiculoIdToInactivate);
        await CarregarVeiculos();
        CloseConfirmModal();
    }

    private void ReativarVeiculo(int id)
    {
        VeiculoIdToReactivate = id;
        ShowReativarModal = true;
    }

    private void CloseReativarModal()
    {
        ShowReativarModal = false;
        VeiculoIdToReactivate = 0;
    }

    private async Task ConfirmReativar()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.IsInRole("Administrador"))
        {
            CloseReativarModal();
            return;
        }

        await VeiculoRepository.Reativar(VeiculoIdToReactivate);
        await CarregarVeiculos();
        CloseReativarModal();
    }
}