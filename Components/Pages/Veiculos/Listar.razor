@page "/veiculos"
@rendermode InteractiveServer

@using mechsystem.Models
@using mechsystem.Interfaces

@inject IVeiculoRepository VeiculoRepository
@inject NavigationManager NavigationManager

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="bi bi-car-front"></i> Veículos Cadastrados</h3>
        <button class="btn btn-success" @onclick="NovoVeiculo">
            <i class="bi bi-plus-lg"></i> Novo Veículo
        </button>
    </div>

    @if (veiculos == null)
    {
        <div class="text-center">
            <div class="spinner-border text-success" role="status"></div>
            <p class="mt-2">Carregando veículos...</p>
        </div>
    }
    else if (!veiculos.Any())
    {
        <div class="alert alert-info" role="alert">
            Nenhum veículo cadastrado no sistema ainda.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Dono (Cliente)</th>
                            <th>Placa</th>
                            <th>Marca/Modelo</th>
                            <th>Ano</th>
                            <th>Cor</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var veiculo in veiculos)
                        {
                            <tr>
                                <td>@veiculo.Id</td>
                                @* A mágica do .Include() que fizemos no repositório permite ler o Nome do Cliente aqui! *@
                                <td><strong>@(veiculo.Cliente != null ? veiculo.Cliente.Nome : "Sem dono")</strong></td>
                                <td><span class="text-uppercase border px-2 py-1 rounded bg-light">@veiculo.Placa</span></td>
                                <td>@veiculo.Marca @veiculo.Modelo</td>
                                <td>@veiculo.Ano</td>
                                <td>@veiculo.Cor</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-info me-1" title="Prontuário / Linha do Tempo" @onclick="() => IrParaDetalhes(veiculo.Id)">
                                        <i class="bi bi-journal-medical"></i> Prontuário
                                    </button>
                                    <button class="btn btn-sm btn-outline-warning me-1" title="Editar" @onclick="() => IrParaEdicao(veiculo.Id)">
                                        Editar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" title="Excluir" @onclick="() => ApagarVeiculo(veiculo.Id)">
                                        Excluir
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<Veiculo>? veiculos;

    protected override async Task OnInitializedAsync()
    {
        veiculos = await VeiculoRepository.Listar();
    }

    private void NovoVeiculo()
    {
        NavigationManager.NavigateTo("/veiculos/cadastro");
    }

    private void IrParaEdicao(int id)
    {
        NavigationManager.NavigateTo($"/veiculos/editar/{id}");
    }

    private void IrParaDetalhes(int id)
    {
        NavigationManager.NavigateTo($"/veiculos/detalhes/{id}");
    }

    private async Task ApagarVeiculo(int id)
    {
        await VeiculoRepository.Deletar(id);
        veiculos = await VeiculoRepository.Listar();
    }
}