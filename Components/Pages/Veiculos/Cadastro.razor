@page "/veiculos/cadastro"
@rendermode InteractiveServer

@using mechsystem.Models
@using mechsystem.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador, Atendimento")]
@inject IVeiculoRepository VeiculoRepository
@inject IClienteRepository ClienteRepository
@inject NavigationManager NavigationManager

<PageTitle>Novo Veículo — Mechsystem</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Novo Veículo</h2>
        <p class="text-muted mb-0">Associe e registre um novo veículo no sistema</p>
    </div>
    <a href="/veiculos" class="btn btn-outline-secondary shadow-sm">
        <i class="bi bi-arrow-left me-2"></i>Voltar
    </a>
</div>

<div class="card shadow-sm dash-card">
    <div class="card-body p-4">

        <EditForm Model="@veiculo" OnValidSubmit="GuardarVeiculo">
            <DataAnnotationsValidator />

            <div class="row g-4">
                <div class="col-md-12">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Cliente (Proprietário) <span class="text-danger">*</span></label>
                        <InputSelect @bind-Value="veiculo.ClienteId" class="form-select">
                            <option value="0"> -- Selecione um Cliente -- </option>
                            @if (clientes != null)
                            {
                                @foreach (var cli in clientes)
                                {
                                    <option value="@cli.Id">@cli.Nome (CPF: @cli.Cpf)</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => veiculo.ClienteId)" class="text-danger mt-1 small" />
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Placa <span class="text-danger">*</span></label>
                        <InputText @bind-Value="veiculo.Placa" class="form-control text-uppercase" placeholder="ABC-1234" />
                        <ValidationMessage For="@(() => veiculo.Placa)" class="text-danger mt-1 small" />
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Marca</label>
                        <InputText @bind-Value="veiculo.Marca" class="form-control" placeholder="Ex: Toyota" />
                        <ValidationMessage For="@(() => veiculo.Marca)" class="text-danger mt-1 small" />
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Modelo</label>
                        <InputText @bind-Value="veiculo.Modelo" class="form-control" placeholder="Ex: Corolla" />
                        <ValidationMessage For="@(() => veiculo.Modelo)" class="text-danger mt-1 small" />
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Cor</label>
                        <InputText @bind-Value="veiculo.Cor" class="form-control" placeholder="Ex: Preto" />
                        <ValidationMessage For="@(() => veiculo.Cor)" class="text-danger mt-1 small" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Ano de Fabricação</label>
                        <InputNumber @bind-Value="veiculo.Ano" class="form-control" placeholder="2020" />
                        <ValidationMessage For="@(() => veiculo.Ano)" class="text-danger mt-1 small" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Quilometragem (Km)</label>
                        <InputNumber @bind-Value="veiculo.Quilometragem" class="form-control" placeholder="0" />
                        <ValidationMessage For="@(() => veiculo.Quilometragem)" class="text-danger mt-1 small" />
                    </div>
                </div>
            </div>

            <hr class="my-4 text-muted" />

            <div class="d-flex justify-content-end gap-2">
                <a href="/veiculos" class="btn btn-light px-4 border">Cancelar</a>
                <button type="submit" class="btn btn-success px-4 shadow-sm">
                    <i class="bi bi-save me-1"></i> Guardar Veículo
                </button>
            </div>

        </EditForm>
    </div>
</div>

@code
{
    private Veiculo veiculo = new Veiculo();

    // Lista para guardar clientes
    private List<Cliente>? clientes;

    protected override async Task OnInitializedAsync()
    {
        // Pegar clientes do repositório
        clientes = await ClienteRepository.Listar();
    }

    private async Task GuardarVeiculo()
    {
        if (veiculo.ClienteId == 0)
        {
            return;
        }

        await VeiculoRepository.Salvar(veiculo);
        NavigationManager.NavigateTo("/veiculos"); // Redireciona para lista de veiculos
    }
}