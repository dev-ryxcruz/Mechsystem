@page "/veiculos/detalhes/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using mechsystem.Data
@using mechsystem.Models
@using mechsystem.Interfaces

@inject AppDbContext DbContext
@inject NavigationManager NavigationManager

<PageTitle>Prontuário Médico - Veículo</PageTitle>

<div class="container mt-4 mb-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-0">
                <i class="bi bi-journal-medical text-primary me-2"></i>Prontuário do Veículo
            </h3>
            <p class="text-secondary mt-1 mb-0">Histórico completo de manutenções e serviços</p>
        </div>
        <button class="btn btn-outline-secondary" @onclick="Voltar">
            <i class="bi bi-arrow-left"></i> Voltar
        </button>
    </div>

    @if (veiculo == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-secondary">Carregando prontuário...</p>
        </div>
    }
    else
    {
        <!-- Header with Veículo Details -->
        <div class="card shadow-sm border-0 mb-4 bg-dark text-white rounded-4 overflow-hidden">
            <div class="card-body p-4 position-relative">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h2 class="fw-bold mb-1">@veiculo.Marca @veiculo.Modelo</h2>
                        <div class="d-flex flex-wrap gap-3 mt-3">
                            <span class="badge bg-secondary px-3 py-2 fs-6 rounded-pill">
                                <i class="bi bi-car-front me-1"></i> Placa: <span class="text-uppercase">@veiculo.Placa</span>
                            </span>
                            <span class="badge bg-secondary px-3 py-2 fs-6 rounded-pill">
                                <i class="bi bi-calendar-event me-1"></i> Ano: @veiculo.Ano
                            </span>
                            <span class="badge bg-secondary px-3 py-2 fs-6 rounded-pill">
                                <i class="bi bi-palette me-1"></i> Cor: @veiculo.Cor
                            </span>
                            <span class="badge bg-secondary px-3 py-2 fs-6 rounded-pill">
                                <i class="bi bi-speedometer2 me-1"></i> Km: @veiculo.Quilometragem
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end mt-4 mt-md-0 border-md-start border-secondary ps-md-4">
                        <p class="mb-1 text-secondary small">Proprietário</p>
                        <h5 class="mb-1 fw-bold">@(veiculo.Cliente != null ? veiculo.Cliente.Nome : "Não vinculado")</h5>
                        @if(veiculo.Cliente != null)
                        {
                            <p class="mb-0 text-white-50"><i class="bi bi-telephone text-success me-1"></i> @veiculo.Cliente.Telefone</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <h4 class="mb-4 d-flex align-items-center mt-5">
            <i class="bi bi-clock-history me-2 text-warning"></i> Linha do Tempo (Timeline)
        </h4>

        @if (!historicoOs.Any())
        {
            <div class="alert alert-dark border border-secondary text-center py-5 rounded-4">
                <i class="bi bi-inbox fs-1 text-secondary mb-3 d-block"></i>
                <h5 class="text-white-50">Nenhum histórico encontrado</h5>
                <p class="mb-0 text-secondary">Este veículo ainda não possui ordens de serviço registradas.</p>
            </div>
        }
        else
        {
            <div class="timeline-wrapper pb-5">
                @foreach (var os in historicoOs)
                {
                    <div class="timeline-item">
                        <div class="timeline-marker @GetStatusMarkerColor(os.Status)">
                            <i class="@GetStatusIcon(os.Status)"></i>
                        </div>
                        <div class="timeline-content card shadow-sm bg-dark border-secondary rounded-4">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <span class="badge @GetStatusBadgeColor(os.Status) mb-2">@os.Status.ToString()</span>
                                        <h5 class="card-title fw-bold text-white mb-0">OS #@os.Id.ToString("D4")</h5>
                                    </div>
                                    <div class="text-end">
                                        <span class="text-secondary small fw-bold d-block">
                                            <i class="bi bi-calendar3 me-1"></i> @os.DataEmissao.ToString("dd/MM/yyyy")
                                        </span>
                                        <span class="text-success fw-bold fs-5 d-block mt-1">@os.ValorTotal.ToString("C")</span>
                                    </div>
                                </div>
                                
                                @if(!string.IsNullOrEmpty(os.DescricaoProblemaRelatado))
                                {
                                    <div class="mb-3 bg-secondary bg-opacity-10 p-3 rounded-3 border border-secondary border-opacity-25">
                                        <p class="text-white-50 small mb-1"><i class="bi bi-exclamation-triangle me-1"></i> Relato / Diagnóstico</p>
                                        <p class="mb-0 text-light">@os.DescricaoProblemaRelatado</p>
                                    </div>
                                }
                                
                                @if(!string.IsNullOrEmpty(os.ServicoAExecutar))
                                {
                                    <div class="mb-3">
                                        <p class="text-white-50 small mb-1"><i class="bi bi-wrench me-1"></i> Serviços Executados / Peças</p>
                                        <p class="mb-0 text-light fw-medium">@os.ServicoAExecutar</p>
                                    </div>
                                }

                                <div class="mt-3 text-end">
                                    <a href="/ordens-servico/@os.Id" class="btn btn-sm btn-outline-info rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i> Ver OS
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<style>
    /* Styling the Timeline for dark mode */
    .timeline-wrapper {
        position: relative;
        padding-left: 2rem;
        margin-left: 1rem;
    }
    
    .timeline-wrapper::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 3px;
        background: linear-gradient(to bottom, #495057, #212529);
        border-radius: 3px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 2rem;
    }

    .timeline-marker {
        position: absolute;
        left: -2.9rem; /* adjusts based on padding-left of wrapper plus half marker size */
        top: 1rem;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        border: 4px solid #212529; /* Matches background to look detached */
        box-shadow: 0 0 10px rgba(0,0,0,0.5);
        z-index: 2;
    }

    .timeline-content {
        margin-left: 1.5rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .timeline-content:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.3)!important;
    }
    
    .timeline-content::before {
        content: '';
        position: absolute;
        top: 1.25rem;
        left: 1rem; /* Adjust to place arrow correctly */
        border-style: solid;
        border-width: 10px 15px 10px 0;
        border-color: transparent #343a40 transparent transparent;
        display: block;
        width: 0;
        z-index: 1;
    }

    @@media (max-width: 768px) {
        .timeline-wrapper {
            padding-left: 1rem;
            margin-left: 0.5rem;
        }
        .timeline-marker {
            left: -1.75rem;
            width: 1.5rem;
            height: 1.5rem;
            font-size: 0.75rem;
            top: 0.5rem;
        }
        .timeline-content {
            margin-left: 0.5rem;
        }
        .timeline-content::before {
            display: none; /* Hide arrow on small screens */
        }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private Veiculo? veiculo;
    private List<OrdemServico> historicoOs = new();

    protected override async Task OnInitializedAsync()
    {
        veiculo = await DbContext.Veiculos
            .Include(v => v.Cliente)
            .FirstOrDefaultAsync(v => v.Id == Id);

        if (veiculo != null)
        {
            historicoOs = await DbContext.OrdensServico
                .Where(os => os.VeiculoId == Id)
                .OrderByDescending(os => os.DataEmissao)
                .ToListAsync();
        }
    }

    private void Voltar()
    {
        NavigationManager.NavigateTo("/veiculos");
    }

    // Helper methods for UI based on status
    private string GetStatusBadgeColor(OrdemServicoStatus status) => status switch
    {
        OrdemServicoStatus.Orcamento => "bg-secondary text-white",
        OrdemServicoStatus.EmAndamento => "bg-primary text-white",
        OrdemServicoStatus.Concluida => "bg-success text-white",
        OrdemServicoStatus.Cancelada => "bg-danger text-white",
        _ => "bg-secondary"
    };

    private string GetStatusMarkerColor(OrdemServicoStatus status) => status switch
    {
        OrdemServicoStatus.Orcamento => "bg-secondary",
        OrdemServicoStatus.EmAndamento => "bg-primary",
        OrdemServicoStatus.Concluida => "bg-success",
        OrdemServicoStatus.Cancelada => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetStatusIcon(OrdemServicoStatus status) => status switch
    {
        OrdemServicoStatus.Orcamento => "bi bi-file-earmark-text",
        OrdemServicoStatus.EmAndamento => "bi bi-gear-wide-connected",
        OrdemServicoStatus.Concluida => "bi bi-award",
        OrdemServicoStatus.Cancelada => "bi bi-x-circle",
        _ => "bi bi-record-circle"
    };
}
