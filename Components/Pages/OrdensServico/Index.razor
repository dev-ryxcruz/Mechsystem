@page "/ordens-servico"
@rendermode InteractiveServer
@using mechsystem.Models
@using mechsystem.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject OrdemServicoService OrdemServicoService
@inject NavigationManager NavigationManager

<PageTitle>Ordens de Serviço — Mechsystem</PageTitle>

<div class="page-container">
    <PageHeader Icon="bi-clipboard2-pulse-fill" Title="Ordens de Serviço" Subtitle="Acompanhe os orçamentos, serviços em andamento e histórico de atendimentos">
        <Actions>
            <AuthorizeView Roles="Administrador, Atendimento">
                <a href="/ordens-servico/nova" class="btn btn-accent shadow-sm text-nowrap">
                    <i class="bi bi-plus-circle me-1"></i> Nova O.S.
                </a>
            </AuthorizeView>
        </Actions>
    </PageHeader>

    <ListToolbar Placeholder="Pesquisar O.S. por nº, placa, modelo ou cliente..."
                 SearchTerm="@termoPesquisa"
                 SearchTermChanged="AoBuscar"
                 TotalCount="@totalRegistros"
                 CountLabel="O.S."
                 CountIcon="bi-clipboard2-check" 
                 >
        <Filters>
            <select class="form-select form-select-sm" style="width:auto;min-width:11rem" value="@(statusFiltro.HasValue ? ((int)statusFiltro.Value).ToString() : "")" @onchange="AoFiltrarStatus" aria-label="Filtrar por status">
                <option value="">Todos os status</option>
                @foreach (var s in Enum.GetValues<OrdemServicoStatus>())
                {
                    <option value="@((int)s)">@RotuloStatus(s)</option>
                }
            </select>
        </Filters>
    </ListToolbar>

    @if (ordensServico == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-accent" role="status"></div>
            <p class="mt-2 text-muted">Carregando ordens de serviço...</p>
        </div>
    }
    else if (!ordensServico.Any())
    {
        <div class="alert alert-info">Nenhuma Ordem de Serviço encontrada.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-custom align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th width="10%" class="text-center">Nº OS</th>
                                <th width="10%" class="text-center">Emissão</th>
                                <th width="17%" class="text-start">Veículo (Placa)</th>
                                <th width="17%" class="text-start">Cliente</th>
                                <th width="13%" class="text-center">Status</th>
                                <th width="12%" class="text-start">Mecânico</th>
                                <th width="8%" class="text-center">Vistoria</th>
                                <AuthorizeView Roles="Administrador, Atendimento">
                                    <th width="10%" class="text-end">Total</th>
                                </AuthorizeView>
                                <th width="5%" class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var os in ordensServico)
                            {
                                <tr>
                                    <td class="text-center fw-bold">#@os.Id.ToString("D4")</td>
                                    <td class="text-center">@os.DataEmissao.ToBrasiliaTime().ToString("dd/MM/yyyy")</td>
                                    <td class="text-start">
                                        @os.VeiculoModelo — <span class="badge bg-light text-dark border">@os.VeiculoPlaca</span>
                                        @if (!string.IsNullOrEmpty(os.VeiculoPlaca) && !os.VeiculoAtivo)
                                        {
                                            <span class="badge bg-secondary ms-1">Veículo Inativo</span>
                                        }
                                    </td>
                                    <td class="text-start">
                                        @os.ClienteNome
                                        @if (!string.IsNullOrEmpty(os.ClienteNome) && !os.ClienteAtivo)
                                        {
                                            <span class="badge bg-secondary ms-1">Cliente Inativo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @ClasseStatus(os.Status)">@RotuloStatus(os.Status)</span>
                                        @if (OrcamentoVencido(os))
                                        {
                                            <span class="badge bg-danger ms-1" title="Validade do orçamento: @os.ValidadeOrcamentoAte.ToBrasiliaTime().ToString("dd/MM/yyyy")"><i class="bi bi-exclamation-triangle-fill"></i> Vencido</span>
                                        }
                                    </td>
                                    <td class="text-start">@(os.MecanicoNome ?? "—")</td>
                                    <td class="text-center">
                                        @if (os.PossuiVistoria)
                                        {
                                            <span class="badge bg-success" title="Realizada"><i class="bi bi-shield-check"></i> Feita</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger" title="Pendente">Pendente</span>
                                        }
                                    </td>
                                    <AuthorizeView Roles="Administrador, Atendimento">
                                        <td class="text-end fw-semibold">@os.ValorTotal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                                    </AuthorizeView>
                                    <td class="text-center">
                                        <a href="/ordens-servico/@os.Id" class="btn btn-sm btn-outline-primary" title="Visualizar / Editar">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <SimplePagination CurrentPage="@paginaAtual"
                          PageSize="@tamanhoPagina"
                          TotalItems="@totalRegistros"
                          OnPageChanged="MudarPagina"
                          OnPageSizeChanged="MudarTamanhoPagina" />
    }
</div>

@code {
    private List<OrdemServicoListaItemDto>? ordensServico;
    private string termoPesquisa = "";
    private int paginaAtual = 1;
    private int tamanhoPagina = 10;
    private int totalRegistros = 0;
    private OrdemServicoStatus? statusFiltro;

    private async Task AoFiltrarStatus(ChangeEventArgs e)
    {
        statusFiltro = int.TryParse(e.Value?.ToString(), out var v) ? (OrdemServicoStatus)v : null;
        paginaAtual = 1;
        await CarregarOrdensServico();
    }

    private static bool OrcamentoVencido(OrdemServicoListaItemDto os) =>
        os.Status == OrdemServicoStatus.Orcamento &&
        os.ValidadeOrcamentoAte.ToBrasiliaTime().Date < DateTimeExtensions.TodayBrasilia();

    private static string RotuloStatus(OrdemServicoStatus s) => s switch
    {
        OrdemServicoStatus.Orcamento => "Orçamento",
        OrdemServicoStatus.Aprovada => "Aprovada",
        OrdemServicoStatus.AguardandoCliente => "Aguardando Cliente",
        OrdemServicoStatus.AguardandoPecas => "Aguardando Peças",
        OrdemServicoStatus.EmAndamento => "Em Andamento",
        OrdemServicoStatus.Pausada => "Pausada",
        OrdemServicoStatus.Concluida => "Concluída",
        OrdemServicoStatus.Entregue => "Entregue",
        OrdemServicoStatus.Recusada => "Recusada",
        OrdemServicoStatus.Cancelada => "Cancelada",
        _ => s.ToString()
    };

    private static string ClasseStatus(OrdemServicoStatus s) => s switch
    {
        OrdemServicoStatus.Orcamento => "bg-warning text-dark",
        OrdemServicoStatus.Aprovada => "bg-success-subtle text-success-emphasis border",
        OrdemServicoStatus.AguardandoCliente => "bg-purple text-white",
        OrdemServicoStatus.AguardandoPecas => "bg-info text-dark",
        OrdemServicoStatus.EmAndamento => "bg-primary",
        OrdemServicoStatus.Pausada => "bg-secondary",
        OrdemServicoStatus.Concluida => "bg-success",
        OrdemServicoStatus.Entregue => "bg-dark",
        OrdemServicoStatus.Recusada => "bg-danger",
        OrdemServicoStatus.Cancelada => "bg-danger",
        _ => "bg-secondary"
    };

    protected override async Task OnInitializedAsync()
    {
        await CarregarOrdensServico();
    }

    private async Task CarregarOrdensServico()
    {
        var resultado = await OrdemServicoService.ListarResumoPaginadoAsync(termoPesquisa, paginaAtual, tamanhoPagina, statusFiltro);
        ordensServico = resultado.Itens;
        totalRegistros = resultado.TotalCount;
    }

    private async Task AoBuscar(string termo)
    {
        termoPesquisa = termo;
        paginaAtual = 1;
        await CarregarOrdensServico();
    }

    private async Task MudarPagina(int novaPagina)
    {
        paginaAtual = novaPagina;
        await CarregarOrdensServico();
    }

    private async Task MudarTamanhoPagina(int novoTamanho)
    {
        tamanhoPagina = novoTamanho;
        paginaAtual = 1;
        await CarregarOrdensServico();
    }
}
