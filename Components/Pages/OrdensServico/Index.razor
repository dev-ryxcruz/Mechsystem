@page "/ordens-servico"
@using Microsoft.EntityFrameworkCore
@using mechsystem.Data
@using mechsystem.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject AppDbContext DbContext
@inject NavigationManager NavigationManager

<PageTitle>Ordens de Serviço</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2>Ordens de Serviço</h2>
    <div class="d-flex gap-2 align-items-center flex-wrap flex-md-nowrap w-100" style="max-width: 600px;">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" class="form-control border-start-0 ps-0 shadow-none" placeholder="Pesquisar O.S..." @bind="termoPesquisa" @bind:event="oninput" />
        </div>
        <AuthorizeView Roles="Administrador, Atendimento">
            <a href="/ordens-servico/nova" class="btn btn-primary shadow-sm text-nowrap">
                <i class="bi bi-plus-circle me-1"></i> Nova O.S.
            </a>
        </AuthorizeView>
    </div>
</div>

@if (ordensServico == null)
{
    <p><em>Carregando...</em></p>
}
else if (!ordensServico.Any())
{
    <div class="alert alert-info">Nenhuma Ordem de Serviço cadastrada.</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-borderless align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th width="10%" class="text-center">Nº OS</th>
                            <th width="10%" class="text-center">Emissão</th>
                            <th width="20%" class="text-start">Veículo (Placa)</th>
                            <th width="20%" class="text-start">Cliente</th>
                            <th width="15%" class="text-center">Status</th>
                            <th width="10%" class="text-center">Vistoria</th>
                            <AuthorizeView Roles="Administrador, Atendimento">
                                <th width="10%" class="text-center">Total</th>
                            </AuthorizeView>
                            <th width="5%" class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var os in OrdensServicoFiltradas!)
                    {
                        <tr>
                            <td class="text-center">@os.Id.ToString("D4")</td>
                            <td class="text-center">@os.DataEmissao.ToString("dd/MM/yyyy")</td>
                            <td class="text-start">@os.Veiculo?.Modelo - @os.Veiculo?.Placa</td>
                            <td class="text-start">@os.Veiculo?.Cliente?.Nome</td>
                            <td class="text-center">
                                @if(os.Status == OrdemServicoStatus.Orcamento)
                                {
                                    <span class="badge bg-warning text-dark">Orçamento</span>
                                }
                                else if(os.Status == OrdemServicoStatus.EmAndamento)
                                {
                                    <span class="badge bg-primary">Em Andamento</span>
                                }
                                else if(os.Status == OrdemServicoStatus.Concluida)
                                {
                                    <span class="badge bg-success">Concluída</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@os.Status</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (os.Vistoria != null)
                                {
                                    <span class="badge bg-success" title="Realizada"><i class="bi bi-shield-check"></i> Feita</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger" title="Pendente"> Pendente</span>
                                }
                            </td>
                            <AuthorizeView Roles="Administrador, Atendimento">
                                <td class="text-center">@os.ValorTotal.ToString("C")</td>
                            </AuthorizeView>
                            <td class="text-center">
                                <a href="/ordens-servico/@os.Id" class="btn btn-sm btn-outline-primary" title="Visualizar / Editar">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private List<OrdemServico>? ordensServico;
    private string termoPesquisa = "";
    private IEnumerable<OrdemServico>? OrdensServicoFiltradas => string.IsNullOrWhiteSpace(termoPesquisa) 
        ? ordensServico 
        : ordensServico?.Where(o => 
            o.Id.ToString().Contains(termoPesquisa) ||
            (o.Veiculo?.Placa != null && o.Veiculo.Placa.Contains(termoPesquisa, StringComparison.OrdinalIgnoreCase)) ||
            (o.Veiculo?.Cliente?.Nome != null && o.Veiculo.Cliente.Nome.Contains(termoPesquisa, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        ordensServico = await DbContext.OrdensServico
            .Include(o => o.Veiculo)
                .ThenInclude(v => v!.Cliente)
            .Include(o => o.Vistoria)
            .OrderByDescending(o => o.Id)
            .ToListAsync();
    }
}
