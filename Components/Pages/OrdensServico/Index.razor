@page "/ordens-servico"
@rendermode InteractiveServer
@using mechsystem.Models
@using mechsystem.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject OrdemServicoService OrdemServicoService
@inject NavigationManager NavigationManager

<PageTitle>Ordens de Serviço — Mechsystem</PageTitle>

<div class="page-container">
    <PageHeader Icon="bi-clipboard2-pulse-fill" Title="Ordens de Serviço" Subtitle="Acompanhe os orçamentos, serviços em andamento e histórico de atendimentos">
        <Actions>
            <AuthorizeView Roles="Administrador, Atendimento">
                <a href="/ordens-servico/nova" class="btn btn-accent shadow-sm text-nowrap">
                    <i class="bi bi-plus-circle me-1"></i> Nova O.S.
                </a>
            </AuthorizeView>
        </Actions>
    </PageHeader>

    <ListToolbar Placeholder="Pesquisar O.S. por nº, placa, modelo ou cliente..."
                 SearchTerm="@termoPesquisa"
                 SearchTermChanged="AoBuscar"
                 TotalCount="@totalRegistros"
                 CountLabel="O.S."
                 CountIcon="bi-clipboard2-check" />

    @if (ordensServico == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-accent" role="status"></div>
            <p class="mt-2 text-muted">Carregando ordens de serviço...</p>
        </div>
    }
    else if (!ordensServico.Any())
    {
        <div class="alert alert-info">Nenhuma Ordem de Serviço encontrada.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-custom align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th width="10%" class="text-center">Nº OS</th>
                                <th width="10%" class="text-center">Emissão</th>
                                <th width="20%" class="text-start">Veículo (Placa)</th>
                                <th width="20%" class="text-start">Cliente</th>
                                <th width="15%" class="text-center">Status</th>
                                <th width="10%" class="text-center">Vistoria</th>
                                <AuthorizeView Roles="Administrador, Atendimento">
                                    <th width="10%" class="text-end">Total</th>
                                </AuthorizeView>
                                <th width="5%" class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var os in ordensServico)
                            {
                                <tr>
                                    <td class="text-center fw-bold">#@os.Id.ToString("D4")</td>
                                    <td class="text-center">@os.DataEmissao.ToBrasiliaTime().ToString("dd/MM/yyyy")</td>
                                    <td class="text-start">
                                        @os.Veiculo?.Modelo — <span class="badge bg-light text-dark border">@os.Veiculo?.Placa</span>
                                        @if (os.Veiculo != null && !os.Veiculo.Ativo)
                                        {
                                            <span class="badge bg-secondary ms-1">Veículo Inativo</span>
                                        }
                                    </td>
                                    <td class="text-start">
                                        @os.Veiculo?.Cliente?.Nome
                                        @if (os.Veiculo?.Cliente != null && !os.Veiculo.Cliente.Ativo)
                                        {
                                            <span class="badge bg-secondary ms-1">Cliente Inativo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (os.Status == OrdemServicoStatus.Orcamento)
                                        {
                                            <span class="badge bg-warning text-dark">Orçamento</span>
                                        }
                                        else if (os.Status == OrdemServicoStatus.EmAndamento)
                                        {
                                            <span class="badge bg-primary">Em Andamento</span>
                                        }
                                        else if (os.Status == OrdemServicoStatus.Pausada)
                                        {
                                            <span class="badge bg-secondary">Pausada</span>
                                        }
                                        else if (os.Status == OrdemServicoStatus.AguardandoPecas)
                                        {
                                            <span class="badge bg-info text-dark">Aguardando Peças</span>
                                        }
                                        else if (os.Status == OrdemServicoStatus.Concluida)
                                        {
                                            <span class="badge bg-success">Concluída</span>
                                        }
                                        else if (os.Status == OrdemServicoStatus.Cancelada)
                                        {
                                            <span class="badge bg-danger">Cancelada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@os.Status</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (os.Vistoria != null)
                                        {
                                            <span class="badge bg-success" title="Realizada"><i class="bi bi-shield-check"></i> Feita</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger" title="Pendente">Pendente</span>
                                        }
                                    </td>
                                    <AuthorizeView Roles="Administrador, Atendimento">
                                        <td class="text-end fw-semibold">@os.ValorTotal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                                    </AuthorizeView>
                                    <td class="text-center">
                                        <a href="/ordens-servico/@os.Id" class="btn btn-sm btn-outline-primary" title="Visualizar / Editar">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <SimplePagination CurrentPage="@paginaAtual"
                          PageSize="@tamanhoPagina"
                          TotalItems="@totalRegistros"
                          OnPageChanged="MudarPagina"
                          OnPageSizeChanged="MudarTamanhoPagina" />
    }
</div>

@code {
    private List<OrdemServico>? ordensServico;
    private string termoPesquisa = "";
    private int paginaAtual = 1;
    private int tamanhoPagina = 10;
    private int totalRegistros = 0;

    protected override async Task OnInitializedAsync()
    {
        await CarregarOrdensServico();
    }

    private async Task CarregarOrdensServico()
    {
        var resultado = await OrdemServicoService.ListarPaginadoAsync(termoPesquisa, paginaAtual, tamanhoPagina);
        ordensServico = resultado.Itens;
        totalRegistros = resultado.TotalCount;
    }

    private async Task AoBuscar(string termo)
    {
        termoPesquisa = termo;
        paginaAtual = 1;
        await CarregarOrdensServico();
    }

    private async Task MudarPagina(int novaPagina)
    {
        paginaAtual = novaPagina;
        await CarregarOrdensServico();
    }

    private async Task MudarTamanhoPagina(int novoTamanho)
    {
        tamanhoPagina = novoTamanho;
        paginaAtual = 1;
        await CarregarOrdensServico();
    }
}
