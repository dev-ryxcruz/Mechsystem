    private void AbrirModalCancelamento()
    {
        erroMensagem = null;
        motivoCancelamento = "";
        mostrarModalCancelamento = true;
    }

    private void FecharModalCancelamento()
    {
        mostrarModalCancelamento = false;
        erroMensagem = null;
    }

    private async Task CancelarOS()
    {
        if (os != null)
        {
            try
            {
                erroMensagem = null;
                var (usuarioId, perfil) = await GetUsuarioContextoAtual();
                if (perfil != PerfilUsuario.Administrador && perfil != PerfilUsuario.Atendimento)
                {
                    erroMensagem = "Apenas Administradores e Atendimento possuem permissão para cancelar ordens de serviço.";
                    return;
                }

                await OrdemServicoService.CancelarOSAsync(os.Id, motivoCancelamento, usuarioId, perfil);
                await LoadData();
                mostrarModalCancelamento = false;
            }
            catch (Exception ex)
            {
                erroMensagem = DomainErrorHelper.ObterMensagemSegura(ex, Logger, "Não foi possível cancelar a Ordem de Serviço.");
            }
        }
    }

    // ─── Peças ───────────────────────────────────────────────────────────────────

    private async Task AbrirModalPeca()
    {
        erroPeca = null;
        pecaSelecionadaId = 0;
        qtdPecaAdicionar = 1;
        valorCobradoModal = 0;
        precoBaseModal = 0;
        pecasDisponiveis = await PecaRepository.GetAllAsync();
        mostrarModalPeca = true;
    }

    private void OnPecaSelecionada()
    {
        if (pecaSelecionadaParaAdicionar != null)
        {
            precoBaseModal = pecaSelecionadaParaAdicionar.PrecoVenda;
            valorCobradoModal = pecaSelecionadaParaAdicionar.PrecoVenda;
        }
        else
        {
            precoBaseModal = 0;
            valorCobradoModal = 0;
        }
    }

    private void FecharModalPeca()
    {
        mostrarModalPeca = false;
    }

    private async Task AdicionarPecaOS()
    {
        if (os == null || pecaSelecionadaId == 0 || qtdPecaAdicionar <= 0) return;

        try
        {
            erroPeca = null;
            var (usuarioId, perfil) = await GetUsuarioContextoAtual();
            if (perfil != PerfilUsuario.Administrador && perfil != PerfilUsuario.Atendimento)
            {
                erroPeca = "Apenas Administradores e Atendimento possuem permissão para adicionar peças nesta tela.";
                return;
            }

            await OrdemServicoService.AdicionarPecaAsync(os.Id, pecaSelecionadaId, qtdPecaAdicionar, valorCobradoModal, usuarioId, perfil);
            await LoadData();
            mostrarModalPeca = false;
        }
        catch (Exception ex)
        {
            erroPeca = DomainErrorHelper.ObterMensagemSegura(ex, Logger, "Não foi possível adicionar a peça à Ordem de Serviço.");
        }
    }

    private async Task RemoverPecaOS(int osPecaId)
    {
        if (os == null) return;

        try
        {
            erroMensagem = null;
            var (usuarioId, perfil) = await GetUsuarioContextoAtual();
            if (perfil != PerfilUsuario.Administrador && perfil != PerfilUsuario.Atendimento)
            {
                erroMensagem = "Apenas Administradores e Atendimento possuem permissão para remover peças da ordem de serviço.";
                return;
            }

            await OrdemServicoService.RemoverPecaAsync(os.Id, osPecaId, usuarioId, perfil);
            await LoadData();
        }
        catch (Exception ex)
        {
            erroMensagem = DomainErrorHelper.ObterMensagemSegura(ex, Logger, "Não foi possível remover a peça da Ordem de Serviço.");
        }
    }

