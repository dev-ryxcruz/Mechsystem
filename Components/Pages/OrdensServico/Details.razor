    private async Task AdicionarContato()
    {
        if (os == null || string.IsNullOrWhiteSpace(novoContatoDescricao)) return;

        await Executar(async (uid, _, nome) =>
        {
            await OrdemServicoService.RegistrarContatoAsync(os.Id, novoContatoTipo, novoContatoDescricao, uid, nome);
            novoContatoDescricao = "";
