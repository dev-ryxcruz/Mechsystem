    private void AbrirModalConclusao()
    {
        erroMensagem = null;
        checkFluidos = checkLimpeza = checkFerramentas = false;
        justificativaConclusao = null;
        mostrarModalConclusao = true;
    }

    private Task ConcluirOS()
    {
        var checklist = System.Text.Json.JsonSerializer.Serialize(new
        {
            fluidos = checkFluidos,
            limpeza = checkLimpeza,
            ferramentas = checkFerramentas
        });
        return Executar(
            (uid, perfil, _) => OrdemServicoService.ConcluirOSAsync(os!.Id, checklist, justificativaConclusao, uid, perfil),
            "Não foi possível concluir a Ordem de Serviço.",
            () => mostrarModalConclusao = false);
    }

    // ─── Entrega ─────────────────────────────────────────────────────────────────
    private void AbrirModalEntrega()
    {
        if (os == null) return;
        erroMensagem = null;
        kmSaida = os.KmSaida ?? os.KmEntrada;
        observacaoSaldo = null;
        var restante = os.ValorTotal - os.Pagamentos.Sum(p => p.Valor);
        linhasPagamento = new() { new LinhaPagamento { Forma = FormaPagamento.Pix, Valor = restante > 0 ? restante : 0 } };
        mostrarModalEntrega = true;
    }

    private void AdicionarLinhaPagamento() => linhasPagamento.Add(new LinhaPagamento());

    private void RemoverLinhaPagamento(LinhaPagamento linha) => linhasPagamento.Remove(linha);

    private Task EntregarOS()
    {
        return Executar(
            (uid, perfil, _) =>
            {
                var pagamentos = linhasPagamento
                    .Where(l => l.Valor > 0)
                    .Select(l => new Pagamento
                    {
                        OrdemServicoId = os!.Id,
                        Forma = l.Forma,
                        Valor = l.Valor,
                        DataPagamento = DateTime.UtcNow,
                        RegistradoPorUsuarioId = uid
                    })
                    .ToList();
                return OrdemServicoService.EntregarOSAsync(os!.Id, kmSaida, pagamentos, uid, perfil,
                    isAdmin ? observacaoSaldo : null);
            },
            "Não foi possível registrar a entrega da Ordem de Serviço.",
            () => mostrarModalEntrega = false);
    }

