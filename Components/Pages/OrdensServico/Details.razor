@page "/ordens-servico/{id:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using mechsystem.Data
@using mechsystem.Models
@using mechsystem.Services
@using mechsystem.Interfaces
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject AppDbContext DbContext
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject EstoqueService EstoqueService
@inject IPecaRepository PecaRepository

<PageTitle>Ordem de Serviço Nº @Id.ToString("D4")</PageTitle>

@if (os == null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <!-- Toolbar (Hidden on Print) -->
    <div class="d-print-none mb-4 d-flex justify-content-between align-items-center">
        <div class="d-flex flex-wrap gap-2">
            <a href="/ordens-servico" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Voltar
            </a>
            <a href="/ordensdeservico/@os.Id/vistoria" class="btn btn-warning fw-bold text-dark">
                <i class="bi bi-clipboard-check me-1"></i>
                @(os.Vistoria == null ? "Realizar Vistoria" : "Ver Checklist de Vistoria")
            </a>
            <AuthorizeView Roles="Administrador, Atendimento">
                <a href="/imprimir/os/@os.Id" target="_blank" class="btn btn-secondary">
                    <i class="bi bi-printer me-1"></i>
                    @(os.Status == OrdemServicoStatus.Orcamento ? "Imprimir Orçamento" : "Imprimir O.S.")
                </a>
                @if (os.Vistoria != null)
                {
                    <a href="/imprimir/vistoria/@os.Id" target="_blank" class="btn btn-outline-secondary">
                        <i class="bi bi-file-earmark-check me-1"></i> Imprimir Vistoria
                    </a>
                }
            </AuthorizeView>
        </div>
        <div class="d-flex gap-2">
            <AuthorizeView Roles="Administrador, Atendimento">
                <Authorized>
                    @if (os.Status == OrdemServicoStatus.Orcamento)
                    {
                        @if (config != null && config.ObrigarVistoriaParaOS && os.Vistoria == null)
                        {
                            <button class="btn btn-secondary disabled" title="A configuração exige Vistoria prévia">
                                <i class="bi bi-lock-fill me-1"></i> Aprovar (Bloqueado)
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-success" @onclick="AbrirModalAprovacao">
                                <i class="bi bi-check-circle me-1"></i> Aprovar Orçamento
                            </button>
                        }
                    }
                </Authorized>
            </AuthorizeView>

            @if (os.Status == OrdemServicoStatus.EmAndamento || os.Status == OrdemServicoStatus.AguardandoPecas)
            {
                <button class="btn btn-primary" @onclick="ConcluirOS">
                    <i class="bi bi-flag me-1"></i> Concluir Serviço
                </button>
            }
            @if (os.Status == OrdemServicoStatus.EmAndamento || os.Status == OrdemServicoStatus.AguardandoPecas || os.Status == OrdemServicoStatus.Orcamento)
            {
                <button class="btn btn-outline-danger" @onclick="AbrirModalCancelamento">
                    <i class="bi bi-x-circle me-1"></i> Cancelar OS
                </button>
            }
        </div>
    </div>

    <!-- OS Document View -->
    <div class="card shadow-sm os-document">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">ORDEM DE SERVIÇO Nº @os.Id.ToString("D4")</h4>
            <div class="text-end">
                <small class="d-block">Status: <strong>@os.Status</strong></small>
                <small class="d-block">Emissão: @os.DataEmissao.ToString("dd/MM/yyyy")</small>
            </div>
        </div>
        <div class="card-body p-4">
            
            <div class="row border-bottom pb-3 mb-3">
                <div class="col-md-6">
                    <h5 class="fw-bold">Oficina Mecânica Mechsystem</h5>
                    <p class="mb-0">CNPJ: 00.000.000/0001-00</p>
                    <p class="mb-0">Telefone: (11) 99999-9999</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <h5 class="fw-bold">Dados do Cliente</h5>
                    <p class="mb-0">Nome: @os.Veiculo?.Cliente?.Nome</p>
                    <p class="mb-0">CPF: @os.Veiculo?.Cliente?.Cpf</p>
                    <p class="mb-0">Telefone: @os.Veiculo?.Cliente?.Telefone</p>
                </div>
            </div>

            <h5 class="fw-bold border-bottom pb-2">Identificação do Veículo</h5>
            <div class="row mb-4">
                <div class="col-sm-3"><small class="text-muted d-block">Placa</small><strong>@os.Veiculo?.Placa</strong></div>
                <div class="col-sm-3"><small class="text-muted d-block">Marca/Modelo</small><strong>@os.Veiculo?.Marca - @os.Veiculo?.Modelo</strong></div>
                <div class="col-sm-3"><small class="text-muted d-block">Cor</small><strong>@os.Veiculo?.Cor</strong></div>
                <div class="col-sm-3"><small class="text-muted d-block">Ano/Km</small><strong>@os.Veiculo?.Ano / @os.Veiculo?.Quilometragem km</strong></div>
            </div>

            <h5 class="fw-bold border-bottom pb-2">Diagnóstico e Serviços</h5>
            <div class="row mb-4">
                <div class="col-12 mb-3">
                    <small class="text-muted d-block fw-bold">Problema Relatado / Diagnóstico:</small>
                    <p class="mb-0 p-2 bg-light rounded" style="white-space: pre-wrap;">@os.DescricaoProblemaRelatado</p>
                </div>
                <div class="col-12">
                    <small class="text-muted d-block fw-bold">Serviços a Executar:</small>
                    <p class="mb-0 p-2 bg-light rounded" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(os.ServicoAExecutar) ? "A definir" : os.ServicoAExecutar)</p>
                </div>
            </div>

            <!-- SEÇÃO DE PEÇAS UTILIZADAS -->
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-box-seam me-2"></i>Peças Utilizadas
                </h5>
                @if (os.Status == OrdemServicoStatus.Orcamento || os.Status == OrdemServicoStatus.EmAndamento || os.Status == OrdemServicoStatus.AguardandoPecas)
                {
                    <AuthorizeView Roles="Administrador, Atendimento">
                        <Authorized>
                            <button class="btn btn-sm btn-outline-primary d-print-none" @onclick="AbrirModalPeca">
                                <i class="bi bi-plus-lg me-1"></i>Adicionar Peça
                            </button>
                        </Authorized>
                    </AuthorizeView>
                }
            </div>

            @if (os.PecasUtilizadas != null && os.PecasUtilizadas.Any())
            {
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>SKU</th>
                                <th>Peça</th>
                                <th class="text-center">Qtd</th>
                                <th class="text-end">Preço Base</th>
                                <th class="text-end">Valor Cobrado</th>
                                <th class="text-end">Subtotal</th>
                                @if (os.Status == OrdemServicoStatus.Orcamento || os.Status == OrdemServicoStatus.EmAndamento)
                                {
                                    <th class="text-center d-print-none" style="width: 60px;">Ação</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in os.PecasUtilizadas)
                            {
                                <tr class="@(item.TemDescontoAbaixoDoMinimo ? "table-warning" : "")">
                                    <td><span class="badge bg-dark font-monospace">@item.Peca?.Sku</span></td>
                                    <td>
                                        @item.Peca?.Nome
                                        @if (item.TemDescontoAbaixoDoMinimo)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill text-warning ms-1" title="Desconto abaixo do preço sugerido"></i>
                                        }
                                    </td>
                                    <td class="text-center fw-bold">@item.Quantidade</td>
                                    <td class="text-end text-muted">@item.PrecoBase.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                                    <td class="text-end @(item.TemDescontoAbaixoDoMinimo ? "text-danger fw-bold" : "")">@item.ValorCobrado.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                                    <td class="text-end fw-bold">@item.Subtotal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                                    @if (os.Status == OrdemServicoStatus.Orcamento || os.Status == OrdemServicoStatus.EmAndamento)
                                    {
                                        <td class="text-center d-print-none">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoverPecaOS(item.Id)" title="Remover">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="5" class="text-end fw-bold">Total Peças:</td>
                                <td class="text-end fw-bold text-success fs-6" colspan="2">
                                    @os.PecasUtilizadas.Sum(p => p.Subtotal).ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-3 mb-4 bg-light rounded">
                    <i class="bi bi-box-seam fs-4 mb-1 d-block"></i>
                    <small>Nenhuma peça adicionada a esta O.S.</small>
                    @if (os.Status == OrdemServicoStatus.Orcamento || os.Status == OrdemServicoStatus.EmAndamento)
                    {
                        <small class="d-block mt-1">Clique em <strong>"Adicionar Peça"</strong> acima para vincular peças do estoque.</small>
                    }
                </div>
            }

            <div class="row mt-5 mb-4">
                <!-- QR Code e Link de Acompanhamento -->
                <div class="col-md-5 mb-4 mb-md-0">
                    <h5 class="fw-bold border-bottom pb-2"><i class="bi bi-qr-code-scan me-2 text-primary"></i>Acompanhamento Online</h5>
                    <div class="card shadow-sm border-0 bg-light mt-3">
                        <div class="card-body text-center p-4">
                            @if (!string.IsNullOrEmpty(os.TokenAcompanhamento))
                            {
                                var qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=180x180&data={NavigationManager.ToAbsoluteUri($"/acompanhar/{os.TokenAcompanhamento}")}";
                                <img src="@qrUrl" alt="QR Code" class="img-fluid border p-2 bg-white rounded mb-3" style="width: 150px; height: 150px;" />
                                <p class="small text-muted mb-3">O cliente pode escanear este código para ver o status da O.S. pelo celular.</p>
                                <button class="btn btn-outline-primary btn-sm w-100 fw-bold" @onclick="CopiarLinkAcompanhamento">
                                    <i class="bi bi-link-45deg me-1"></i> Copiar Link
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <!-- Histórico de Contatos -->
                <div class="col-md-7">
                    <h5 class="fw-bold border-bottom pb-2"><i class="bi bi-chat-left-text me-2 text-primary"></i>Histórico de Contatos</h5>
                    <div class="card shadow-sm border-0 mt-3">
                        <div class="card-body p-0">
                            <!-- Novo Contato -->
                            <div class="bg-light p-3 border-bottom">
                                <div class="row g-2 align-items-center">
                                    <div class="col-auto">
                                        <select class="form-select form-select-sm" @bind="novoContatoTipo">
                                            @foreach (TipoContato tipo in Enum.GetValues(typeof(TipoContato)))
                                            {
                                                <option value="@tipo">@tipo</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col">
                                        <input type="text" class="form-control form-control-sm" placeholder="Ex: Cliente aprovou o orçamento" @bind="novoContatoDescricao" @bind:event="oninput" />
                                    </div>
                                    <div class="col-auto">
                                        <button class="btn btn-primary btn-sm" disabled="@(string.IsNullOrWhiteSpace(novoContatoDescricao))" @onclick="AdicionarContato">
                                            <i class="bi bi-plus-lg"></i> Adicionar
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Lista de Contatos -->
                            <ul class="list-group list-group-flush" style="max-height: 250px; overflow-y: auto;">
                                @if (os.Contatos == null || !os.Contatos.Any())
                                {
                                    <li class="list-group-item text-center text-muted py-4">
                                        <small>Nenhum contato registrado ainda.</small>
                                    </li>
                                }
                                else
                                {
                                    @foreach (var contato in os.Contatos.OrderByDescending(c => c.DataContato))
                                    {
                                        <li class="list-group-item py-3">
                                            <div class="d-flex w-100 justify-content-between mb-1">
                                                <h6 class="mb-0 fw-bold" style="font-size: 0.85rem;">
                                                    @if (contato.Tipo == TipoContato.WhatsApp) { <i class="bi bi-whatsapp text-success me-1"></i> }
                                                    else if (contato.Tipo == TipoContato.Ligacao) { <i class="bi bi-telephone text-primary me-1"></i> }
                                                    else if (contato.Tipo == TipoContato.Email) { <i class="bi bi-envelope text-warning me-1"></i> }
                                                    else if (contato.Tipo == TipoContato.Presencial) { <i class="bi bi-person-badge text-secondary me-1"></i> }
                                                    else { <i class="bi bi-chat text-info me-1"></i> }
                                                    @contato.Tipo
                                                </h6>
                                                <small class="text-muted">@contato.DataContato.ToString("dd/MM/yyyy HH:mm")</small>
                                            </div>
                                            <p class="mb-1 text-dark" style="font-size: 0.9rem;">@contato.Descricao</p>
                                            <small class="text-muted" style="font-size: 0.75rem;">Por: @contato.RegistradoPor</small>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <h5 class="fw-bold border-bottom pb-2">Prazos e Valores</h5>
            <div class="row mb-4">
                <div class="col-sm-4"><small class="text-muted d-block">Previsão de Início</small><strong>@(os.DataPrevisaoInicio?.ToString("dd/MM/yyyy") ?? "N/A")</strong></div>
                <div class="col-sm-4"><small class="text-muted d-block">Previsão de Entrega (CDC)</small><strong>@os.DataPrevisaoEntrega.ToString("dd/MM/yyyy")</strong></div>
                <div class="col-sm-4"><small class="text-muted d-block">Validade Orçamento</small><strong>@os.GetValidadeOrcamento(config?.ValidadeOrcamentoDias ?? 10).ToString("dd/MM/yyyy")</strong></div>
            </div>

            <AuthorizeView Roles="Administrador, Atendimento">
                <div class="row">
                    <div class="col-md-6 offset-md-6">
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr>
                                    <td>Mão de Obra</td>
                                    <td class="text-end">@os.ValorMaoDeObra.ToString("C")</td>
                                </tr>
                                <tr>
                                    <td>Peças</td>
                                    <td class="text-end">@os.ValorPecasEfetivo.ToString("C")</td>
                                </tr>
                                <tr class="table-active fw-bold">
                                    <td>Valor Total</td>
                                    <td class="text-end text-success fs-5">@os.ValorTotal.ToString("C")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </AuthorizeView>

            <!-- Termo de Autorização (Contrato) -->
            <div class="mt-5 p-4 border rounded bg-light term-box">
                <h6 class="fw-bold text-center mb-3">TERMO DE AUTORIZAÇÃO / APROVAÇÃO (LEI Nº 8.078/1990 - CDC)</h6>
                <p class="small text-justify mb-4">
                    Conforme o art. 40 do Código de Defesa do Consumidor, autorizo expressamente a execução dos serviços descritos acima 
                    pelo valor total acordado, bem como a aplicação das peças listadas. Compreendo que após o aceite, este orçamento passa a ter força de contrato e que serviços adicionais somente poderão ser incluídos mediante nova aprovação prévia.
                </p>
                
                @if (os.Status == OrdemServicoStatus.Orcamento)
                {
                    <div class="row text-center mt-5">
                        <div class="col-6 offset-3 border-top pt-2 mt-4">
                            <strong>Assinatura do Cliente</strong><br />
                            <small>@os.Veiculo?.Cliente?.Nome</small><br />
                            <small>Data: ___/___/_______</small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-success mt-3 mb-0 text-center">
                        <i class="bi bi-shield-check me-2"></i><strong>Orçamento Aprovado</strong><br />
                        <span class="small">Autorizado por: @(os.AutorizadoPor ?? os.Veiculo?.Cliente?.Nome) no dia @(os.DataAutorizacao?.ToString("dd/MM/yyyy HH:mm")) via @(os.MeioAutorizacao)</span>
                    </div>
                }
            </div>

        </div>
    </div>

    <!-- Modal Aprovação -->
    @if (mostrarModalAprovacao)
    {
        <div class="blazor-modal-backdrop" @onclick="FecharModalAprovacao"></div>
        <div class="blazor-modal d-print-none">
            <div class="blazor-modal-content">
                <div class="blazor-modal-header bg-success text-white">
                    <h5><i class="bi bi-check-circle me-2"></i>Aprovar Orçamento</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalAprovacao"></button>
                </div>
                <div class="blazor-modal-body text-dark">
                    @if (!string.IsNullOrEmpty(erroMensagem))
                    {
                        <div class="alert alert-danger">@erroMensagem</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Autorizado Por (Nome):</label>
                        <input type="text" class="form-control" @bind="autorizadoPor" placeholder="Ex: Próprio Cliente ou Representante" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Meio de Aprovação/Aceite:</label>
                        <select class="form-select" @bind="meioAutorizacao">
                            <option value="Assinatura Presencial">Assinatura Presencial</option>
                            <option value="WhatsApp">Mensagem via WhatsApp</option>
                            <option value="Telefone">Ligação Telefônica</option>
                            <option value="E-mail">E-mail</option>
                        </select>
                    </div>
                </div>
                <div class="blazor-modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalAprovacao">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="AprovarOS">
                        <i class="bi bi-check-lg me-1"></i> Confirmar Aprovação
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Adicionar Peça -->
    @if (mostrarModalPeca)
    {
        <div class="blazor-modal-backdrop" @onclick="FecharModalPeca"></div>
        <div class="blazor-modal d-print-none">
            <div class="blazor-modal-content" style="max-width: 550px;">
                <div class="blazor-modal-header" style="background: var(--accent); color: white;">
                    <h5><i class="bi bi-box-seam me-2"></i>Adicionar Peça à O.S.</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalPeca"></button>
                </div>
                <div class="blazor-modal-body text-dark">
                    @if (!string.IsNullOrEmpty(erroPeca))
                    {
                        <div class="alert alert-danger">@erroPeca</div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Buscar Peça</label>
                        <select class="form-select" @bind="pecaSelecionadaId" @bind:after="OnPecaSelecionada">
                            <option value="0">-- Selecione uma peça --</option>
                            @if (pecasDisponiveis != null)
                            {
                                foreach (var p in pecasDisponiveis)
                                {
                                    <option value="@p.Id">[@p.Sku] @p.Nome — Estoque: @p.EstoqueAtual — @p.PrecoVenda.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</option>
                                }
                            }
                        </select>
                    </div>

                    @if (pecaSelecionadaParaAdicionar != null)
                    {
                        <div class="alert bg-light border mb-3">
                            <div class="row text-center">
                                <div class="col-3">
                                    <small class="text-muted d-block">Estoque</small>
                                    <strong class="@(pecaSelecionadaParaAdicionar.AbaixoDoMinimo ? "text-danger" : "text-success")">@pecaSelecionadaParaAdicionar.EstoqueAtual</strong>
                                </div>
                                <div class="col-3">
                                    <small class="text-muted d-block">Custo</small>
                                    <strong>@pecaSelecionadaParaAdicionar.PrecoCusto.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong>
                                </div>
                                <div class="col-3">
                                    <small class="text-muted d-block">Venda (Base)</small>
                                    <strong class="text-success">@pecaSelecionadaParaAdicionar.PrecoVenda.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong>
                                </div>
                                <div class="col-3">
                                    <small class="text-muted d-block">Local</small>
                                    <strong>@(pecaSelecionadaParaAdicionar.Localizacao ?? "N/A")</strong>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label">Quantidade</label>
                            <input type="number" class="form-control" @bind="qtdPecaAdicionar" min="1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Valor Cobrado (R$)</label>
                            <input type="number" class="form-control @(temDescontoModal ? "border-warning" : "")" @bind="valorCobradoModal" step="0.01" min="0" />
                        </div>
                    </div>

                    @if (temDescontoModal)
                    {
                        <div class="alert alert-warning py-2 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span><strong>Atenção:</strong> O valor cobrado (@valorCobradoModal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))) está <strong>abaixo</strong> do preço base sugerido (@precoBaseModal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))).</span>
                        </div>
                    }
                </div>
                <div class="blazor-modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalPeca">Cancelar</button>
                    @if (temDescontoModal && !isAdmin)
                    {
                        <button type="button" class="btn btn-primary" disabled title="Apenas Administradores podem aplicar desconto abaixo do preço base">
                            <i class="bi bi-lock-fill me-1"></i> Bloqueado (Desconto)
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="AdicionarPecaOS"
                                disabled="@(pecaSelecionadaId == 0 || qtdPecaAdicionar <= 0)">
                            <i class="bi bi-plus-lg me-1"></i> Adicionar
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Modal Cancelamento -->
    @if (mostrarModalCancelamento)
    {
        <div class="blazor-modal-backdrop" @onclick="FecharModalCancelamento"></div>
        <div class="blazor-modal d-print-none">
            <div class="blazor-modal-content">
                <div class="blazor-modal-header bg-danger text-white">
                    <h5><i class="bi bi-x-circle me-2"></i>Cancelar Ordem de Serviço</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalCancelamento"></button>
                </div>
                <div class="blazor-modal-body text-dark">
                    @if (!string.IsNullOrEmpty(erroMensagem))
                    {
                        <div class="alert alert-danger">@erroMensagem</div>
                    }
                    <p>Tem certeza que deseja <strong>cancelar</strong> a O.S. Nº <strong>@os.Id.ToString("D4")</strong>?</p>
                    @if (os.PecasUtilizadas?.Any() == true)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>@os.PecasUtilizadas.Count peça(s)</strong> serão devolvidas ao estoque automaticamente (Estorno).
                        </div>
                    }
                </div>
                <div class="blazor-modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalCancelamento">Manter OS</button>
                    <button type="button" class="btn btn-danger" @onclick="CancelarOS">
                        <i class="bi bi-x-lg me-1"></i> Confirmar Cancelamento
                    </button>
                </div>
            </div>
        </div>
    }
}

<style>
    /* Blazor-controlled Modal */
    .blazor-modal-backdrop {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.5); z-index: 1040;
    }
    .blazor-modal {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        display: flex; align-items: center; justify-content: center;
        z-index: 1050;
    }
    .blazor-modal-content {
        background: white; border-radius: 0.5rem; width: 500px; max-width: 90%;
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.3);
    }
    .blazor-modal-header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1rem 1.25rem; border-radius: 0.5rem 0.5rem 0 0;
    }
    .blazor-modal-header h5 { margin: 0; }
    .blazor-modal-body { padding: 1.25rem; }
    .blazor-modal-footer {
        display: flex; justify-content: flex-end; gap: 0.5rem;
        padding: 1rem 1.25rem; border-top: 1px solid #dee2e6;
    }

    /* Print Formatting */
    @@media print {
        body { background: white; font-size: 12pt; }
        .d-print-none { display: none !important; }
        .sidebar { display: none !important; }
        .navbar-toggler { display: none !important; }
        main { margin: 0 !important; padding: 0 !important; width: 100% !important; }
        .os-document { border: none !important; box-shadow: none !important; }
        .card-header { background: transparent !important; color: black !important; border-bottom: 2px solid black !important; }
        .term-box { page-break-inside: avoid; border: 1px solid #ccc !important; }
        .blazor-modal-backdrop, .blazor-modal { display: none !important; }
    }

    /* ── Responsividade Mobile ── */
    @@media (max-width: 768px) {

        /* Toolbar: empilhar botões verticalmente */
        .d-print-none.mb-4.d-flex.justify-content-between {
            flex-direction: column;
            align-items: stretch;
            gap: 0.75rem;
        }
        .d-print-none.mb-4.d-flex.justify-content-between > div {
            width: 100%;
        }
        .d-print-none.mb-4.d-flex.justify-content-between .btn {
            width: 100%;
            justify-content: center;
        }

        /* Card header da OS: empilhar número e status */
        .os-document .card-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
            padding: 1rem;
        }
        .os-document .card-header h4 {
            font-size: 1.1rem;
            margin: 0;
        }
        .os-document .card-header .text-end {
            text-align: left !important;
        }

        /* Card body: padding menor */
        .os-document .card-body {
            padding: 1rem;
        }

        /* Dados do veículo: empilhar em 2 colunas (col-sm-3 já está, mas fonte fica pequena) */
        .os-document .row .col-sm-3,
        .os-document .row .col-sm-4 {
            margin-bottom: 0.5rem;
        }

        /* Tabela de peças: indicador de scroll */
        .table-responsive {
            -webkit-overflow-scrolling: touch;
        }
        .table-responsive::after {
            content: '';
            display: block;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(255,117,31,0.3), transparent);
            margin-top: -2px;
        }

        /* Modais: altura máxima e scroll interno */
        .blazor-modal-content {
            width: 95% !important;
            max-height: 85vh;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }

        /* Term box: padding menor */
        .term-box {
            padding: 1rem;
        }

        /* Tabela de valores: largura total */
        .col-md-6.offset-md-6 {
            margin-left: 0 !important;
            flex: 0 0 100%;
            max-width: 100%;
        }
    }

    @@media (max-width: 480px) {
        .os-document .card-header h4 {
            font-size: 1rem;
        }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private OrdemServico? os;
    private Configuracao? config;
    private bool mostrarModalAprovacao = false;
    private bool mostrarModalCancelamento = false;
    private string? erroMensagem;
    private string autorizadoPor = "";
    private string meioAutorizacao = "Assinatura Presencial";

    // Peças
    private bool mostrarModalPeca = false;
    private IEnumerable<Peca>? pecasDisponiveis;
    private int pecaSelecionadaId = 0;
    private int qtdPecaAdicionar = 1;
    private decimal valorCobradoModal = 0;
    private decimal precoBaseModal = 0;
    private string? erroPeca;
    private bool isAdmin = false;

    private Peca? pecaSelecionadaParaAdicionar => pecasDisponiveis?.FirstOrDefault(p => p.Id == pecaSelecionadaId);
    private bool temDescontoModal => pecaSelecionadaId > 0 && valorCobradoModal < precoBaseModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Administrador");
    }

    private async Task LoadData()
    {
        os = await DbContext.OrdensServico
            .Include(o => o.Vistoria)
            .Include(o => o.Veiculo)
                .ThenInclude(v => v!.Cliente)
            .Include(o => o.PecasUtilizadas)
                .ThenInclude(p => p.Peca)
            .Include(o => o.Contatos)
            .FirstOrDefaultAsync(o => o.Id == Id);
            
        if (os != null)
        {
            autorizadoPor = os.Veiculo?.Cliente?.Nome ?? "";

            // Gerar token se não existir
            if (string.IsNullOrEmpty(os.TokenAcompanhamento))
            {
                os.TokenAcompanhamento = Guid.NewGuid().ToString("N");
                await DbContext.SaveChangesAsync();
            }
        }
        
        config = await DbContext.Configuracoes.FirstOrDefaultAsync();
    }

    // ─── Comunicação e Contatos ──────────────────────────────────────────────────
    private string novoContatoDescricao = "";
    private TipoContato novoContatoTipo = TipoContato.WhatsApp;

    private async Task AdicionarContato()
    {
        if (os == null || string.IsNullOrWhiteSpace(novoContatoDescricao)) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var nomeUsuario = authState.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value 
                        ?? authState.User.Identity?.Name ?? "Usuário";

        var contato = new ContatoOS
        {
            OrdemServicoId = os.Id,
            Tipo = novoContatoTipo,
            Descricao = novoContatoDescricao,
            RegistradoPor = nomeUsuario,
            DataContato = DateTime.Now
        };

        DbContext.ContatosOS.Add(contato);
        await DbContext.SaveChangesAsync();

        novoContatoDescricao = ""; // limpar campo
        await LoadData(); // atualizar grid
    }

    private async Task CopiarLinkAcompanhamento()
    {
        if (os?.TokenAcompanhamento != null)
        {
            var url = NavigationManager.ToAbsoluteUri($"/acompanhar/{os.TokenAcompanhamento}").ToString();
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
            // Optionally, we could show a toast here, but for simplicity we rely on the native action.
        }
    }

    // ─── Aprovação ───────────────────────────────────────────────────────────────

    private void AbrirModalAprovacao()
    {
        erroMensagem = null;
        mostrarModalAprovacao = true;
    }

    private void FecharModalAprovacao()
    {
        mostrarModalAprovacao = false;
    }

    private async Task<int> GetUsuarioIdAtual()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier);
        return userIdClaim != null ? int.Parse(userIdClaim.Value) : 1;
    }

    private async Task AprovarOS()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.IsInRole("Administrador") && !authState.User.IsInRole("Atendimento"))
        {
            return;
        }

        if (config != null && config.ObrigarVistoriaParaOS && os?.Vistoria == null)
        {
            erroMensagem = "Para aprovar este orçamento, as configurações da Oficina exigem a realização da Vistoria de Entrada. Cancele e realize a Vistoria na O.S. primeiro.";
            return;
        }

        if (os != null)
        {
            try 
            {
                erroMensagem = null;
                os.Status = OrdemServicoStatus.EmAndamento;
                os.DataAutorizacao = DateTime.Now;
                os.AutorizadoPor = autorizadoPor;
                os.MeioAutorizacao = meioAutorizacao;
                
                if (!os.DataPrevisaoInicio.HasValue)
                {
                    os.DataPrevisaoInicio = DateTime.Today;
                }

                await DbContext.SaveChangesAsync();

                // 🔑 BAIXA AUTOMÁTICA DO ESTOQUE
                if (os.PecasUtilizadas.Any())
                {
                    var usuarioId = await GetUsuarioIdAtual();
                    await EstoqueService.BaixarPecasDaOS(os.Id, usuarioId);
                }

                mostrarModalAprovacao = false;

                // Se aprovação presencial, abrir impressão automaticamente para assinatura do cliente
                if (meioAutorizacao == "Assinatura Presencial")
                {
                    await JSRuntime.InvokeVoidAsync("window.open", $"/imprimir/os/{os.Id}", "_blank");
                }
            }
            catch (Exception ex)
            {
                erroMensagem = $"Erro ao salvar: {ex.Message}";
            }
        }
    }

    private async Task ConcluirOS()
    {
        if (os != null)
        {
            os.Status = OrdemServicoStatus.Concluida;
            await DbContext.SaveChangesAsync();
        }
    }

    // ─── Cancelamento com Estorno ────────────────────────────────────────────────

    private void AbrirModalCancelamento()
    {
        erroMensagem = null;
        mostrarModalCancelamento = true;
    }

    private void FecharModalCancelamento()
    {
        mostrarModalCancelamento = false;
    }

    private async Task CancelarOS()
    {
        if (os != null)
        {
            try
            {
                erroMensagem = null;

                // 🔑 ESTORNO AUTOMÁTICO DO ESTOQUE (só se já foi aprovada/baixada)
                if (os.Status != OrdemServicoStatus.Orcamento && os.PecasUtilizadas.Any())
                {
                    var usuarioId = await GetUsuarioIdAtual();
                    await EstoqueService.EstornarPecasDaOS(os.Id, usuarioId);
                }

                os.Status = OrdemServicoStatus.Cancelada;
                await DbContext.SaveChangesAsync();
                mostrarModalCancelamento = false;
            }
            catch (Exception ex)
            {
                erroMensagem = $"Erro ao cancelar: {ex.Message}";
            }
        }
    }

    // ─── Peças ───────────────────────────────────────────────────────────────────

    private async Task AbrirModalPeca()
    {
        erroPeca = null;
        pecaSelecionadaId = 0;
        qtdPecaAdicionar = 1;
        valorCobradoModal = 0;
        precoBaseModal = 0;
        pecasDisponiveis = await PecaRepository.GetAllAsync();
        mostrarModalPeca = true;
    }

    private void OnPecaSelecionada()
    {
        if (pecaSelecionadaParaAdicionar != null)
        {
            precoBaseModal = pecaSelecionadaParaAdicionar.PrecoVenda;
            valorCobradoModal = pecaSelecionadaParaAdicionar.PrecoVenda;
        }
        else
        {
            precoBaseModal = 0;
            valorCobradoModal = 0;
        }
    }

    private void FecharModalPeca()
    {
        mostrarModalPeca = false;
    }

    private async Task AdicionarPecaOS()
    {
        if (os == null || pecaSelecionadaId == 0 || qtdPecaAdicionar <= 0) return;

        try
        {
            erroPeca = null;
            var peca = await PecaRepository.GetByIdAsync(pecaSelecionadaId);
            if (peca == null) { erroPeca = "Peça não encontrada."; return; }

            // Verificar se já existe essa peça na OS
            var existente = os.PecasUtilizadas?.FirstOrDefault(p => p.PecaId == pecaSelecionadaId);
            if (existente != null)
            {
                existente.Quantidade += qtdPecaAdicionar;
            }
            else
            {
                var osPeca = new OrdemServicoPeca
                {
                    OrdemServicoId = os.Id,
                    PecaId = peca.Id,
                    Quantidade = qtdPecaAdicionar,
                    PrecoBase = peca.PrecoVenda,
                    ValorCobrado = valorCobradoModal,
                    PrecoCustoSnapshot = peca.PrecoCusto
                };
                DbContext.OrdemServicoPecas.Add(osPeca);
            }

            await DbContext.SaveChangesAsync();

            // Reload para obter os dados frescos e recalcular
            await LoadData();

            // Sincronizar ValorPecas manual com a soma calculada (graceful degradation)
            if (os != null && os.PecasUtilizadas != null && os.PecasUtilizadas.Any())
            {
                os.ValorPecas = os.PecasUtilizadas.Sum(p => p.Subtotal);
                await DbContext.SaveChangesAsync();
            }

            mostrarModalPeca = false;
        }
        catch (Exception ex)
        {
            erroPeca = ex.Message;
        }
    }

    private async Task RemoverPecaOS(int osPecaId)
    {
        if (os == null) return;

        var item = await DbContext.OrdemServicoPecas.FindAsync(osPecaId);
        if (item != null)
        {
            DbContext.OrdemServicoPecas.Remove(item);
            await DbContext.SaveChangesAsync();

            // Reload e recalcular
            await LoadData();
            if (os != null)
            {
                os.ValorPecas = os.PecasUtilizadas?.Any() == true ? os.PecasUtilizadas.Sum(p => p.Subtotal) : 0;
                await DbContext.SaveChangesAsync();
            }
        }
    }

    private async Task PrintOS()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
