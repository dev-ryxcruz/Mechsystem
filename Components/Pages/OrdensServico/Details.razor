    private async Task CopiarLinkAcompanhamento()
    {
        if (os?.TokenAcompanhamento != null)
        {
            var url = NavigationManager.ToAbsoluteUri($"/acompanhar/{os.TokenAcompanhamento}").ToString();
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
        }
    }

    // ─── Aprovação / Recusa / Validade ───────────────────────────────────────────
    private void AbrirModalAprovacao()
    {
        if (os == null) return;
        erroMensagem = null;
        canalAutorizacao = TipoContato.Presencial;
        servicosSelecionados = os.ServicosAExecutarList.Where(s => s.StatusItem != StatusItem.Recusado).Select(s => s.Id).ToHashSet();
        pecasSelecionadas = os.PecasUtilizadas.Where(p => p.StatusItem != StatusItem.Recusado).Select(p => p.Id).ToHashSet();
        mostrarModalAprovacao = true;
    }

    private async Task AprovarOS()
    {
        if (os == null) return;
        var imprimir = canalAutorizacao == TipoContato.Presencial;
        var osId = os.Id;
        await Executar(
            (uid, perfil, _) => OrdemServicoService.AprovarOSAsync(
                osId, servicosSelecionados.ToList(), pecasSelecionadas.ToList(), autorizadoPor, canalAutorizacao, uid, perfil),
            "Não foi possível aprovar a Ordem de Serviço.",
            () => mostrarModalAprovacao = false);

        if (!mostrarModalAprovacao && string.IsNullOrEmpty(erroMensagem) && imprimir)
        {
            await JSRuntime.InvokeVoidAsync("window.open", $"/imprimir/os/{osId}", "_blank");
        }
    }

