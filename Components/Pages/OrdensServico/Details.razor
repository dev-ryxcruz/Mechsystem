@page "/ordens-servico/{id:int}"
@rendermode InteractiveServer
@implements IDisposable
@using mechsystem.Models
@using mechsystem.Services
@using mechsystem.Services.Queries
@using mechsystem.Interfaces
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using System.Reflection
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@inject OrdemServicoQueryService OrdemServicoQueryService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject EstoqueService EstoqueService
@inject OrdemServicoService OrdemServicoService
@inject IPecaRepository PecaRepository

<PageTitle>Ordem de Serviço Nº @Id.ToString("D4")</PageTitle>

@if (carregando)
{
    <div class="text-center p-5" aria-live="polite">
        <div class="spinner-border text-accent" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
        <p class="mt-2 text-muted">Carregando ordem de serviço...</p>
    </div>
}
else if (os == null)
{
    <div class="alert alert-warning my-4" role="alert">
        <h5 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Ordem de Serviço não encontrada</h5>
        <p class="mb-3">Não foi possível localizar a O.S. #@Id.ToString("D4").</p>
        <a href="/ordens-servico" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Voltar para Ordens de Serviço
        </a>
    </div>
}
else
{
    <!-- Toolbar (Hidden on Print) -->
    <div class="d-print-none mb-4 d-flex justify-content-between align-items-center">
        <div class="d-flex flex-wrap gap-2">
            <a href="/ordens-servico" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Voltar
            </a>
            @if (!OSFinalizada)
            {
                <a href="/ordensdeservico/@os.Id/vistoria" class="btn btn-warning fw-bold text-dark">
                    <i class="bi bi-clipboard-check me-1"></i>
                    @(os.Vistoria == null ? "Realizar Vistoria" : "Ver Checklist de Vistoria")
                </a>
            }
            else if (os.Vistoria != null)
            {
                <a href="/ordensdeservico/@os.Id/vistoria" class="btn btn-warning fw-bold text-dark">
                    <i class="bi bi-clipboard-check me-1"></i> Ver Checklist de Vistoria
                </a>
            }
            @if (podeGerenciar)
            {
                <a href="/imprimir/os/@os.Id" target="_blank" class="btn btn-secondary">
                    <i class="bi bi-printer me-1"></i>
                    @(os.Status == OrdemServicoStatus.Orcamento ? "Imprimir Orçamento" : "Imprimir O.S.")
                </a>
                @if (os.Vistoria != null)
                {
                    <a href="/imprimir/vistoria/@os.Id" target="_blank" class="btn btn-outline-secondary">
                        <i class="bi bi-file-earmark-check me-1"></i> Imprimir Vistoria
                    </a>
                }
                @if (os.Status == OrdemServicoStatus.Entregue)
                {
                    <a href="/imprimir/termo-garantia/@os.Id" target="_blank" class="btn btn-info text-dark fw-bold">
                        <i class="bi bi-shield-check me-1"></i> Termo de Garantia
                    </a>
                }
            }
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (podeGerenciar)
            {
                @if (os.Status == OrdemServicoStatus.Orcamento)
                {
                    <button class="btn btn-outline-primary" @onclick="AbrirModalEdicao">
                        <i class="bi bi-pencil-square me-1"></i> Editar Orçamento
                    </button>
                    @if (config != null && config.ObrigarVistoriaParaOS && os.Vistoria == null)
                    {
                        <button class="btn btn-secondary disabled" title="A configuração exige Vistoria prévia">
                            <i class="bi bi-lock-fill me-1"></i> Aprovar (Bloqueado)
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-success" @onclick="AbrirModalAprovacao">
                            <i class="bi bi-check-circle me-1"></i> Aprovar Orçamento
                        </button>
                    }
                    <button class="btn btn-outline-danger" @onclick="AbrirModalRecusa">
                        <i class="bi bi-hand-thumbs-down me-1"></i> Recusar Orçamento
                    </button>
                    @if (isAdmin)
                    {
                        <button class="btn btn-outline-secondary" @onclick="AbrirModalRenovar">
                            <i class="bi bi-calendar-plus me-1"></i> Renovar Validade
                        </button>
                    }
                }
                else if (!OSFinalizada)
                {
                    <button class="btn btn-outline-primary" @onclick="AbrirModalEdicao">
                        <i class="bi bi-pencil-square me-1"></i> Diagnóstico / Previsão
                    </button>
                }
            }
            else if (isMecanico && PodeEditarDiagnosticoMecanico)
            {
                <button class="btn btn-outline-primary" @onclick="AbrirModalEdicao">
                    <i class="bi bi-pencil-square me-1"></i> Editar Diagnóstico
                </button>
            }

            @* Atribuição de mecânico *@
            @if (!OSFinalizada && os.Status != OrdemServicoStatus.Orcamento)
            {
                @if (podeGerenciar)
                {
                    <button class="btn btn-outline-dark" @onclick="AbrirModalMecanico">
                        <i class="bi bi-person-gear me-1"></i> @(os.MecanicoResponsavelId == null ? "Atribuir mecânico" : "Reatribuir mecânico")
                    </button>
                }
                else if (isMecanico && os.MecanicoResponsavelId != usuarioIdAtual)
                {
                    <button class="btn btn-outline-dark" @onclick="AssumirOS">
                        <i class="bi bi-person-check me-1"></i> Assumir
                    </button>
                }
            }

            @* Execução *@
            @if (os.Status == OrdemServicoStatus.Aprovada || os.Status == OrdemServicoStatus.Pausada || os.Status == OrdemServicoStatus.AguardandoPecas)
            {
                <button class="btn btn-success" @onclick="IniciarOuRetomarOS">
                    <i class="bi bi-play-fill me-1"></i> @(os.Status == OrdemServicoStatus.Aprovada ? "Iniciar Execução" : "Retomar Serviço")
                </button>
            }
            @if (os.Status == OrdemServicoStatus.EmAndamento)
            {
                @if (apontamentoAbertoUsuario == null)
                {
                    <button class="btn btn-outline-success" @onclick="IniciarApontamento" title="Iniciar contagem de tempo">
                        <i class="bi bi-stopwatch me-1"></i> Iniciar apontamento
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-warning text-dark" @onclick="PausarApontamento" title="Encerrar contagem de tempo">
                        <i class="bi bi-stopwatch-fill me-1"></i> Pausar apontamento
                    </button>
                }
                <button class="btn btn-outline-warning text-dark" @onclick="PausarOS">
                    <i class="bi bi-pause-fill me-1"></i> Pausar
                </button>
                <button class="btn btn-outline-secondary" @onclick="AguardarPecasOS">
                    <i class="bi bi-hourglass-split me-1"></i> Aguardar Peças
                </button>
                <button class="btn btn-primary" @onclick="AbrirModalConclusao">
                    <i class="bi bi-flag me-1"></i> Marcar pronta
                </button>
            }
            @if (podeGerenciar && os.Status == OrdemServicoStatus.Concluida)
            {
                <button class="btn btn-success" @onclick="AbrirModalEntrega">
                    <i class="bi bi-box-arrow-right me-1"></i> Entregar
                </button>
            }
            @if (podeGerenciar && OrdemServicoService.PodeTransicionar(os.Status, OrdemServicoStatus.Cancelada))
            {
                <button class="btn btn-outline-danger" @onclick="AbrirModalCancelamento">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(erroMensagem) && !AlgumModalAberto)
    {
        <div class="alert alert-danger d-print-none mb-3">@erroMensagem</div>
    }

    <!-- Barra de progresso do ciclo -->
    <div class="d-print-none mb-4">
        @if (os.Status == OrdemServicoStatus.Cancelada)
        {
            <div class="alert alert-danger border-start border-danger border-4 shadow-sm mb-0">
                <div class="d-flex align-items-center mb-1">
                    <i class="bi bi-x-octagon-fill fs-5 me-2"></i>
                    <strong>Ordem de Serviço Cancelada</strong>
                </div>
                <div class="small">
                    <div><strong>Motivo:</strong> @(string.IsNullOrWhiteSpace(os.MotivoCancelamento) ? "Não informado" : os.MotivoCancelamento)</div>
                    <div>
                        <strong>Data/Hora:</strong> @(os.DataCancelamento.ToBrasiliaTime()?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                        <span class="mx-2">·</span>
                        <strong>Cancelada por:</strong> @(os.CanceladaPorUsuario?.NomeCompleto ?? "Usuário")
                    </div>
                </div>
            </div>
        }
        else if (os.Status == OrdemServicoStatus.Recusada)
        {
            <div class="alert alert-warning border-start border-warning border-4 shadow-sm mb-0">
                <div class="d-flex align-items-center mb-1">
                    <i class="bi bi-hand-thumbs-down-fill fs-5 me-2"></i>
                    <strong>Orçamento Recusado</strong>
                </div>
                <div class="small">
                    <strong>Motivo:</strong> @(string.IsNullOrWhiteSpace(os.MotivoCancelamento) ? "Não informado" : os.MotivoCancelamento)
                </div>
            </div>
        }
        else
        {
            var etapaAtual = EtapaAtual();
            <div class="os-stepper">
                @for (var i = 0; i < Etapas.Length; i++)
                {
                    var classe = i < etapaAtual ? "done" : (i == etapaAtual ? "current" : "");
                    <div class="os-step @classe">
                        <span class="os-step-dot">@(i < etapaAtual ? "✓" : (i + 1).ToString())</span>
                        <span class="os-step-label">@Etapas[i]</span>
                    </div>
                }
            </div>
            <div class="small text-muted mt-2">
                Situação atual: <strong>@NomeStatus(os.Status)</strong>
                @if (os.MecanicoResponsavel != null)
                {
                    <span class="mx-2">·</span><span>Mecânico: <strong>@os.MecanicoResponsavel.NomeCompleto</strong></span>
                }
            </div>
        }

        @if (OrcamentoVencido)
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center mt-3 mb-0">
                <span>
                    <i class="bi bi-clock-history me-1"></i>
                    <strong>Orçamento vencido</strong> em @os.ValidadeOrcamentoAte.ToBrasiliaTime().ToString("dd/MM/yyyy").
                    Os valores podem ter mudado.
                </span>
                @if (isAdmin)
                {
                    <button class="btn btn-sm btn-warning" @onclick="AbrirModalRenovar">
                        <i class="bi bi-calendar-plus me-1"></i> Renovar Validade
                    </button>
                }
            </div>
        }
    </div>

    <!-- Aditivos pendentes -->
    @if (aditivosServicosPendentes.Any() || aditivosPecasPendentes.Any())
    {
        <div class="card border-warning shadow-sm mb-4 d-print-none">
            <div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center">
                <strong><i class="bi bi-exclamation-triangle me-2"></i>Aditivos pendentes de aprovação do cliente</strong>
                @if (podeGerenciar)
                {
                    <button class="btn btn-sm btn-success" @onclick="AbrirModalAditivo">
                        <i class="bi bi-check2-square me-1"></i> Responder aditivos
                    </button>
                }
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var s in aditivosServicosPendentes)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span><span class="badge bg-secondary me-2">Serviço</span>@s.Quantidade x @(s.Servico?.Nome ?? "Serviço")</span>
                        @if (!isMecanico) { <strong>@Moeda(s.Subtotal)</strong> }
                    </li>
                }
                @foreach (var p in aditivosPecasPendentes)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span><span class="badge bg-dark me-2">Peça</span>@p.Quantidade x @(p.Peca?.Nome ?? "Peça") <small class="text-muted">(@NomeEnum(p.Origem))</small></span>
                        @if (!isMecanico) { <strong>@Moeda(p.Subtotal)</strong> }
                    </li>
                }
            </ul>
            @if (!podeGerenciar)
            {
                <div class="card-footer small text-muted">Somente Administrador ou Atendimento podem aprovar/recusar aditivos.</div>
            }
        </div>
    }

    <!-- OS Document View -->
    <div class="card shadow-sm os-document">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">ORDEM DE SERVIÇO Nº @os.Id.ToString("D4")</h4>
            <div class="text-end">
                <small class="d-block">Status: <strong>@NomeStatus(os.Status)</strong></small>
                <small class="d-block">Emissão: @os.DataEmissao.ToBrasiliaTime().ToString("dd/MM/yyyy")</small>
            </div>
        </div>
        <div class="card-body p-4">

            <div class="row border-bottom pb-3 mb-3">
                <div class="col-md-6">
                    <h5 class="fw-bold">@(config?.NomeFantasia ?? "Oficina Mecânica Mechsystem")</h5>
                    <p class="mb-0">CNPJ: @(string.IsNullOrWhiteSpace(config?.Cnpj) ? "00.000.000/0001-00" : config.Cnpj)</p>
                    <p class="mb-0">Telefone: @(string.IsNullOrWhiteSpace(config?.Telefone) ? "(11) 99999-9999" : config.Telefone)</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <h5 class="fw-bold">Dados do Cliente</h5>
                    <p class="mb-0">Nome: @os.Veiculo?.Cliente?.Nome</p>
                    <p class="mb-0">CPF: @os.Veiculo?.Cliente?.Cpf</p>
                    <p class="mb-0">Telefone: @os.Veiculo?.Cliente?.Telefone</p>
                </div>
            </div>

            <h5 class="fw-bold border-bottom pb-2">Identificação do Veículo</h5>
            <div class="row mb-4">
                <div class="col-sm-3"><small class="text-muted d-block">Placa</small><strong>@os.Veiculo?.Placa</strong></div>
                <div class="col-sm-3"><small class="text-muted d-block">Marca/Modelo</small><strong>@os.Veiculo?.Marca - @os.Veiculo?.Modelo</strong></div>
                <div class="col-sm-3"><small class="text-muted d-block">Cor</small><strong>@os.Veiculo?.Cor</strong></div>
                <div class="col-sm-3"><small class="text-muted d-block">Ano</small><strong>@os.Veiculo?.Ano</strong></div>
            </div>

            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                <h5 class="fw-bold mb-0">Queixa e Diagnóstico</h5>
                @if (PodeEditarDiagnostico)
                {
                    <button class="btn btn-sm btn-outline-primary d-print-none" @onclick="AbrirModalEdicao">
                        <i class="bi bi-pencil me-1"></i>@(os.Status == OrdemServicoStatus.Orcamento ? "Editar Queixa / Diagnóstico / Desconto" : "Editar Diagnóstico")
                    </button>
                }
            </div>
            <div class="row mb-4">
                <div class="col-12 mb-3">
                    <small class="text-muted d-block fw-bold">Queixa do Cliente:</small>
                    <p class="mb-0 p-2 bg-light rounded" style="white-space: pre-wrap;">@os.QueixaCliente</p>
                </div>
                <div class="col-12">
                    <small class="text-muted d-block fw-bold">Diagnóstico Técnico:</small>
                    <p class="mb-0 p-2 bg-light rounded" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(os.Diagnostico) ? "A definir" : os.Diagnostico)</p>
                </div>
            </div>

            <!-- SERVIÇOS -->
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-tools me-2"></i>Serviços</h5>
            </div>
            @if (os.ServicosAExecutarList != null && os.ServicosAExecutarList.Any())
            {
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Serviço</th>
                                <th class="text-center">Qtd</th>
                                @if (!isMecanico) { <th class="text-end">Valor</th><th class="text-end">Subtotal</th> }
                                <th class="text-center">Situação</th>
                                <th class="text-center">Executado</th>
                                <th>Mecânico</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var serv in os.ServicosAExecutarList.OrderBy(s => s.EhAditivo).ThenBy(s => s.Id))
                            {
                                <tr class="@(serv.StatusItem == StatusItem.Recusado ? "text-decoration-line-through text-muted" : "")">
                                    <td>
                                        @(serv.Servico?.Nome ?? "Serviço")
                                        @if (serv.EhAditivo) { <span class="badge bg-warning text-dark ms-1">Aditivo</span> }
                                    </td>
                                    <td class="text-center">@serv.Quantidade</td>
                                    @if (!isMecanico)
                                    {
                                        <td class="text-end">@Moeda(serv.ValorCobrado)</td>
                                        <td class="text-end fw-bold">@Moeda(serv.Subtotal)</td>
                                    }
                                    <td class="text-center"><span class="badge @BadgeStatusItem(serv.StatusItem)">@serv.StatusItem</span></td>
                                    <td class="text-center">
                                        @if (serv.Executado)
                                        {
                                            <i class="bi bi-check-circle-fill text-success" title="Executado"></i>
                                        }
                                        else if (PodeMarcarExecucao && serv.StatusItem == StatusItem.Aprovado)
                                        {
                                            <button class="btn btn-sm btn-outline-success d-print-none" @onclick="() => MarcarServicoExecutado(serv.Id)">
                                                <i class="bi bi-check2 me-1"></i>Marcar
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>@(serv.Mecanico?.NomeCompleto ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-4 p-2 bg-light rounded">A definir</p>
            }

            <!-- PEÇAS -->
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-box-seam me-2"></i>Peças Utilizadas
                </h5>
                @if (podeGerenciar && (os.Status == OrdemServicoStatus.Orcamento || EmExecucao))
                {
                    <button class="btn btn-sm btn-outline-primary d-print-none" @onclick="AbrirModalPeca">
                        <i class="bi bi-plus-lg me-1"></i>Adicionar Peça
                    </button>
                }
            </div>

            @if (os.PecasUtilizadas != null && os.PecasUtilizadas.Any())
            {
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>SKU</th>
                                <th>Peça</th>
                                <th class="text-center">Qtd</th>
                                <th>Origem</th>
                                @if (!isMecanico) { <th class="text-end">Preço Base</th><th class="text-end">Valor Cobrado</th><th class="text-end">Subtotal</th> }
                                <th class="text-center">Situação</th>
                                <th class="text-center">Aplicada</th>
                                @if (podeGerenciar && (os.Status == OrdemServicoStatus.Orcamento || EmExecucao))
                                {
                                    <th class="text-center d-print-none" style="width: 60px;">Ação</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in os.PecasUtilizadas.OrderBy(p => p.EhAditivo).ThenBy(p => p.Id))
                            {
                                <tr class="@(item.StatusItem == StatusItem.Recusado ? "text-decoration-line-through text-muted" : (item.TemDescontoAbaixoDoMinimo && !isMecanico ? "table-warning" : ""))">
                                    <td><span class="badge bg-dark font-monospace">@item.Peca?.Sku</span></td>
                                    <td>
                                        @item.Peca?.Nome
                                        @if (item.EhAditivo) { <span class="badge bg-warning text-dark ms-1">Aditivo</span> }
                                        @if (item.TemDescontoAbaixoDoMinimo && !isMecanico)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill text-warning ms-1" title="Desconto abaixo do preço sugerido"></i>
                                        }
                                    </td>
                                    <td class="text-center fw-bold">@item.Quantidade</td>
                                    <td><span class="badge bg-light text-dark border">@NomeEnum(item.Origem)</span></td>
                                    @if (!isMecanico)
                                    {
                                        <td class="text-end text-muted">@Moeda(item.PrecoBase)</td>
                                        <td class="text-end @(item.TemDescontoAbaixoDoMinimo ? "text-danger fw-bold" : "")">@Moeda(item.ValorCobrado)</td>
                                        <td class="text-end fw-bold">@Moeda(item.Subtotal)</td>
                                    }
                                    <td class="text-center"><span class="badge @BadgeStatusItem(item.StatusItem)">@item.StatusItem</span></td>
                                    <td class="text-center">
                                        @if (item.Aplicada)
                                        {
                                            <i class="bi bi-check-circle-fill text-success" title="Aplicada"></i>
                                        }
                                        else if (PodeMarcarExecucao && item.StatusItem == StatusItem.Aprovado)
                                        {
                                            <button class="btn btn-sm btn-outline-success d-print-none" @onclick="() => MarcarPecaAplicada(item.Id)">
                                                <i class="bi bi-check2 me-1"></i>Marcar
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    @if (podeGerenciar && (os.Status == OrdemServicoStatus.Orcamento || EmExecucao))
                                    {
                                        <td class="text-center d-print-none">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoverPecaOS(item.Id)" title="Remover">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                        @if (!isMecanico)
                        {
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="6" class="text-end fw-bold">Total Peças (não recusadas):</td>
                                    <td class="text-end fw-bold text-success fs-6" colspan="3">
                                        @Moeda(os.PecasUtilizadas.Where(p => p.StatusItem != StatusItem.Recusado).Sum(p => p.Subtotal))
                                    </td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-3 mb-4 bg-light rounded">
                    <i class="bi bi-box-seam fs-4 mb-1 d-block"></i>
                    <small>Nenhuma peça adicionada a esta O.S.</small>
                </div>
            }

            <!-- Apontamentos de tempo -->
            <div class="border-bottom pb-2 mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-stopwatch me-2"></i>Apontamentos de Tempo
                    @if (os.ApontamentosTempo.Any(a => a.Fim == null))
                    {
                        <span class="badge bg-primary ms-2 fs-6">
                            <i class="bi bi-stopwatch-fill me-1"></i>Cronômetro ativo: @FormatarMinutos(tempoRealTotal)
                        </span>
                    }
                </h5>
                <small class="text-muted">
                    Real: <strong>@FormatarMinutos(tempoRealTotal)</strong> × Estimado: <strong>@FormatarMinutos(os.TempoTotalEstimadoMinutos)</strong>
                </small>
            </div>
            @if (temposPorMecanico.Any())
            {
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Mecânico</th><th class="text-center">Apontamentos</th><th class="text-end">Tempo total</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in temposPorMecanico)
                            {
                                <tr>
                                    <td>@t.Nome</td>
                                    <td class="text-center">@t.Quantidade @(t.EmAberto ? "(em andamento)" : "")</td>
                                    <td class="text-end fw-bold">@FormatarMinutos(t.Minutos)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="2" class="text-end fw-bold">Total real × estimado:</td>
                                <td class="text-end fw-bold @(tempoRealTotal > os.TempoTotalEstimadoMinutos && os.TempoTotalEstimadoMinutos > 0 ? "text-danger" : "text-success")">
                                    @FormatarMinutos(tempoRealTotal) / @FormatarMinutos(os.TempoTotalEstimadoMinutos)
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-3 mb-4 bg-light rounded"><small>Nenhum apontamento de tempo registrado.</small></div>
            }

            <div class="row mt-5 mb-4">
                <!-- QR Code e Link de Acompanhamento -->
                <div class="col-md-5 mb-4 mb-md-0">
                    <h5 class="fw-bold border-bottom pb-2"><i class="bi bi-qr-code-scan me-2 text-primary"></i>Acompanhamento Online</h5>
                    <div class="card shadow-sm border-0 bg-light mt-3">
                        <div class="card-body text-center p-4">
                            @if (!string.IsNullOrEmpty(os.TokenAcompanhamento))
                            {
                                var trackingUrl = NavigationManager.ToAbsoluteUri($"/acompanhar/{os.TokenAcompanhamento}").ToString();
                                using var qrGenerator = new QRCoder.QRCodeGenerator();
                                using var qrCodeData = qrGenerator.CreateQrCode(trackingUrl, QRCoder.QRCodeGenerator.ECCLevel.Q);
                                using var qrCode = new QRCoder.PngByteQRCode(qrCodeData);
                                var qrUrl = $"data:image/png;base64,{Convert.ToBase64String(qrCode.GetGraphic(10))}";
                                <img src="@qrUrl" alt="QR Code" class="img-fluid border p-2 bg-white rounded mb-3" style="width: 150px; height: 150px;" />
                                <p class="small text-muted mb-3">O cliente pode escanear este código para ver o status da O.S. pelo celular.</p>
                                <button class="btn btn-outline-primary btn-sm w-100 fw-bold" @onclick="CopiarLinkAcompanhamento">
                                    <i class="bi bi-link-45deg me-1"></i> Copiar Link
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <!-- Histórico de Contatos -->
                <div class="col-md-7">
                    <h5 class="fw-bold border-bottom pb-2"><i class="bi bi-chat-left-text me-2 text-primary"></i>Histórico de Contatos</h5>
                    <div class="card shadow-sm border-0 mt-3">
                        <div class="card-body p-0">
                            @if (!OSFinalizada)
                            {
                                <div class="bg-light p-3 border-bottom d-print-none">
                                    <div class="row g-2 align-items-center">
                                        <div class="col-auto">
                                            <select class="form-select form-select-sm" @bind="novoContatoTipo">
                                                @foreach (TipoContato tipo in Enum.GetValues(typeof(TipoContato)))
                                                {
                                                    <option value="@tipo">@NomeEnum(tipo)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col">
                                            <input type="text" class="form-control form-control-sm" placeholder="Ex: Cliente aprovou o orçamento" @bind="novoContatoDescricao" @bind:event="oninput" />
                                        </div>
                                        <div class="col-auto">
                                            <button class="btn btn-primary btn-sm" disabled="@(string.IsNullOrWhiteSpace(novoContatoDescricao))" @onclick="AdicionarContato">
                                                <i class="bi bi-plus-lg"></i> Adicionar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }

                            <ul class="list-group list-group-flush" style="max-height: 250px; overflow-y: auto;">
                                @if (os.Contatos == null || !os.Contatos.Any())
                                {
                                    <li class="list-group-item text-center text-muted py-4">
                                        <small>Nenhum contato registrado ainda.</small>
                                    </li>
                                }
                                else
                                {
                                    @foreach (var contato in os.Contatos.OrderByDescending(c => c.DataContato))
                                    {
                                        <li class="list-group-item py-3">
                                            <div class="d-flex w-100 justify-content-between mb-1">
                                                <h6 class="mb-0 fw-bold" style="font-size: 0.85rem;">
                                                    @if (contato.Tipo == TipoContato.WhatsApp) { <i class="bi bi-whatsapp text-success me-1"></i> }
                                                    else if (contato.Tipo == TipoContato.Ligacao) { <i class="bi bi-telephone text-primary me-1"></i> }
                                                    else if (contato.Tipo == TipoContato.Email) { <i class="bi bi-envelope text-warning me-1"></i> }
                                                    else if (contato.Tipo == TipoContato.Presencial) { <i class="bi bi-person-badge text-secondary me-1"></i> }
                                                    else { <i class="bi bi-chat text-info me-1"></i> }
                                                    @NomeEnum(contato.Tipo)
                                                </h6>
                                                <small class="text-muted">@contato.DataContato.ToBrasiliaTime().ToString("dd/MM/yyyy HH:mm")</small>
                                            </div>
                                            <p class="mb-1 text-dark" style="font-size: 0.9rem;">@contato.Descricao</p>
                                            <small class="text-muted" style="font-size: 0.75rem;">Por: @contato.RegistradoPor</small>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                <h5 class="fw-bold mb-0">Prazos e Valores</h5>
                @if (podeGerenciar && !OSFinalizada && os.Status != OrdemServicoStatus.Orcamento)
                {
                    <button class="btn btn-sm btn-outline-primary d-print-none" @onclick="AbrirModalEdicao">
                        <i class="bi bi-calendar-event me-1"></i>Alterar Previsão de Entrega
                    </button>
                }
            </div>
            <div class="row mb-4 g-2">
                <div class="col-sm-4"><small class="text-muted d-block">KM de Entrada</small><strong>@os.KmEntrada.ToString("N0") km</strong></div>
                @if (os.KmSaida.HasValue)
                {
                    <div class="col-sm-4"><small class="text-muted d-block">KM de Saída</small><strong>@os.KmSaida.Value.ToString("N0") km</strong></div>
                }
                <div class="col-sm-4"><small class="text-muted d-block">Combustível (Entrada)</small><strong>@NomeEnum(os.NivelCombustivelEntrada)</strong></div>
                <div class="col-sm-4"><small class="text-muted d-block">Previsão de Entrega (CDC)</small><strong>@os.DataPrevisaoEntrega.ToString("dd/MM/yyyy")</strong></div>
                <div class="col-sm-4">
                    <small class="text-muted d-block">Validade Orçamento</small>
                    <strong class="@(OrcamentoVencido ? "text-danger" : "")">@os.ValidadeOrcamentoAte.ToBrasiliaTime().ToString("dd/MM/yyyy")</strong>
                </div>
                @if (os.DataConclusao.HasValue)
                {
                    <div class="col-sm-4"><small class="text-muted d-block">Conclusão</small><strong>@os.DataConclusao.ToBrasiliaTime()?.ToString("dd/MM/yyyy HH:mm")</strong></div>
                }
                @if (os.DataEntrega.HasValue)
                {
                    <div class="col-sm-4"><small class="text-muted d-block">Data da Entrega</small><strong>@os.DataEntrega.ToBrasiliaTime()?.ToString("dd/MM/yyyy HH:mm")</strong></div>
                }
                @if (os.GarantiaDias.HasValue)
                {
                    <div class="col-sm-4">
                        <small class="text-muted d-block">Garantia</small>
                        <strong>@os.GarantiaDias dias</strong>
                        @if (os.DataEntrega.HasValue)
                        {
                            <small class="text-muted"> (até @(os.DataEntrega.ToBrasiliaTime()?.AddDays(os.GarantiaDias.Value).ToString("dd/MM/yyyy")))</small>
                        }
                    </div>
                }
            </div>

            @if (podeGerenciar)
            {
                <div class="row">
                    <div class="col-md-6 offset-md-6">
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr><td>Mão de Obra</td><td class="text-end">@Moeda(os.ValorMaoDeObraEfetivo)</td></tr>
                                <tr><td>Peças</td><td class="text-end">@Moeda(os.ValorPecasEfetivo)</td></tr>
                                <tr>
                                    <td>Desconto</td>
                                    <td class="text-end @(os.ValorDesconto > 0 ? "text-danger fw-bold" : "text-muted")">
                                        @(os.ValorDesconto > 0 ? $"- {Moeda(os.ValorDesconto)}" : Moeda(os.ValorDesconto))
                                    </td>
                                </tr>
                                @if (os.ValorTotalAditivosPendentes > 0)
                                {
                                    <tr class="table-warning"><td>Aditivos pendentes (não incluídos)</td><td class="text-end">@Moeda(os.ValorTotalAditivosPendentes)</td></tr>
                                }
                                <tr class="table-active fw-bold">
                                    <td>Valor Total</td>
                                    <td class="text-end text-success fs-5">@Moeda(os.ValorTotal)</td>
                                </tr>
                            </tbody>
                        </table>

                        @if (os.Pagamentos != null && os.Pagamentos.Any())
                        {
                            <h6 class="fw-bold">Pagamentos</h6>
                            <table class="table table-sm table-bordered">
                                <tbody>
                                    @foreach (var pg in os.Pagamentos.OrderBy(p => p.DataPagamento))
                                    {
                                        <tr>
                                            <td>@NomeEnum(pg.Forma) <small class="text-muted">@pg.DataPagamento.ToBrasiliaTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                                            <td class="text-end">@Moeda(pg.Valor)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            }

            <!-- Termo de Autorização (Contrato) -->
            <div class="mt-5 p-4 border rounded bg-light term-box">
                <h6 class="fw-bold text-center mb-3">TERMO DE AUTORIZAÇÃO / APROVAÇÃO (LEI Nº 8.078/1990 - CDC)</h6>
                <p class="small text-justify mb-4">
                    Conforme o art. 40 do Código de Defesa do Consumidor, autorizo expressamente a execução dos serviços descritos acima
                    pelo valor total acordado, bem como a aplicação das peças listadas. Compreendo que após o aceite, este orçamento passa a ter força de contrato e que serviços adicionais somente poderão ser incluídos mediante nova aprovação prévia.
                </p>

                @if (os.Status == OrdemServicoStatus.Orcamento)
                {
                    <div class="row text-center mt-5">
                        <div class="col-6 offset-3 border-top pt-2 mt-4">
                            <strong>Assinatura do Cliente</strong><br />
                            <small>@os.Veiculo?.Cliente?.Nome</small><br />
                            <small>Data: ___/___/_______</small>
                        </div>
                    </div>
                }
                else if (os.DataAutorizacao.HasValue)
                {
                    <div class="alert alert-success mt-3 mb-0 text-center">
                        <i class="bi bi-shield-check me-2"></i><strong>Orçamento Aprovado</strong><br />
                        <span class="small">Autorizado por: @(os.AutorizadoPor ?? os.Veiculo?.Cliente?.Nome) no dia @(os.DataAutorizacao.ToBrasiliaTime()?.ToString("dd/MM/yyyy HH:mm")) via @(os.TipoContatoAutorizacao.HasValue ? NomeEnum(os.TipoContatoAutorizacao.Value) : "Outro")</span>
                    </div>
                }
            </div>

        </div>
    </div>

    <!-- Modal Edição da O.S. -->
    @if (mostrarModalEdicao)
    {
        var orcamento = os.Status == OrdemServicoStatus.Orcamento;
        <div class="blazor-modal-backdrop" @onclick="FecharModalEdicao"></div>
        <div class="blazor-modal d-print-none">
            <div class="blazor-modal-content" style="max-width: 650px;">
                <div class="blazor-modal-header bg-primary text-white">
                    <h5><i class="bi bi-pencil-square me-2"></i>@(orcamento ? "Editar Orçamento" : "Diagnóstico e Previsão de Entrega")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalEdicao"></button>
                </div>
                <div class="blazor-modal-body text-dark">
                    @if (!string.IsNullOrEmpty(erroMensagem)) { <div class="alert alert-danger">@erroMensagem</div> }

                    @if (orcamento)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Queixa do Cliente <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="3" @bind="editDescricaoProblema"></textarea>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info small">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            Após a aprovação, apenas o <strong>Diagnóstico</strong> @(podeGerenciar ? "e a Previsão de Entrega " : "")podem ser alterados.
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Diagnóstico Técnico</label>
                        <textarea class="form-control" rows="3" @bind="editDiagnostico"></textarea>
                    </div>

                    @if (podeGerenciar)
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Previsão de Entrega (CDC) <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" @bind="editDataPrevisaoEntrega" />
                            </div>
                            @if (orcamento)
                            {
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">
                                        Desconto na O.S. (R$)
                                        @if (!isAdmin) { <span class="badge bg-secondary ms-1"><i class="bi bi-lock-fill me-1"></i>Somente Admin</span> }
                                    </label>
                                    <input type="number" class="form-control" step="0.01" min="0" @bind="editValorDesconto" disabled="@(!isAdmin)" />
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="blazor-modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalEdicao">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="SalvarEdicaoOS"><i class="bi bi-check-lg me-1"></i> Salvar Alterações</button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Aprovação -->
    @if (mostrarModalAprovacao)
    {
        <div class="blazor-modal-backdrop" @onclick="FecharModais"></div>
        <div class="blazor-modal d-print-none">
            <div class="blazor-modal-content" style="max-width: 650px;">
                <div class="blazor-modal-header bg-success text-white">
                    <h5><i class="bi bi-check-circle me-2"></i>Aprovar Orçamento</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModais"></button>
                </div>
                <div class="blazor-modal-body text-dark">
                    @if (!string.IsNullOrEmpty(erroMensagem)) { <div class="alert alert-danger">@erroMensagem</div> }
                    <p class="small text-muted mb-2">Desmarque os itens que o cliente <strong>não</strong> autorizou. Itens desmarcados serão recusados.</p>

                    @if (os.ServicosAExecutarList?.Any(s => s.StatusItem != StatusItem.Recusado) == true)
                    {
                        <h6 class="fw-bold">Serviços</h6>
                        @foreach (var s in os.ServicosAExecutarList.Where(s => s.StatusItem != StatusItem.Recusado))
                        {
                            var sid = s.Id;
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="ap-s-@sid" checked="@servicosSelecionados.Contains(sid)" @onchange="e => AlternarSelecao(servicosSelecionados, sid, (bool)e.Value!)" />
                                <label class="form-check-label" for="ap-s-@sid">@s.Quantidade x @(s.Servico?.Nome ?? "Serviço") — @Moeda(s.Subtotal)</label>
                            </div>
                        }
                    }
                    @if (os.PecasUtilizadas?.Any(p => p.StatusItem != StatusItem.Recusado) == true)
                    {
                        <h6 class="fw-bold mt-3">Peças</h6>
                        @foreach (var p in os.PecasUtilizadas.Where(p => p.StatusItem != StatusItem.Recusado))
                        {
                            var pid = p.Id;
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="ap-p-@pid" checked="@pecasSelecionadas.Contains(pid)" @onchange="e => AlternarSelecao(pecasSelecionadas, pid, (bool)e.Value!)" />
                                <label class="form-check-label" for="ap-p-@pid">@p.Quantidade x @(p.Peca?.Nome ?? "Peça") (@NomeEnum(p.Origem)) — @Moeda(p.Subtotal)</label>
                            </div>
                        }
                    }

                    <hr />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Autorizado por (nome) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="autorizadoPor" placeholder="Ex: Próprio cliente ou representante" />
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-bold">Canal da autorização</label>
                        <select class="form-select" @bind="canalAutorizacao">
                            @foreach (TipoContato tipo in Enum.GetValues(typeof(TipoContato)))
                            {
                                <option value="@tipo">@NomeEnum(tipo)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="blazor-modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModais">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="AprovarOS" disabled="@(string.IsNullOrWhiteSpace(autorizadoPor))">
                        <i class="bi bi-check-lg me-1"></i> Confirmar Aprovação
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Recusa de Orçamento -->
    @if (mostrarModalRecusa)
    {
        <div class="blazor-modal-backdrop" @onclick="FecharModais"></div>
        <div class="blazor-modal d-print-none">
            <div class="blazor-modal-content">
                <div class="blazor-modal-header bg-danger text-white">
                    <h5><i class="bi bi-hand-thumbs-down me-2"></i>Recusar Orçamento</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModais"></button>
                </div>
                <div class="blazor-modal-body text-dark">
                    @if (!string.IsNullOrEmpty(erroMensagem)) { <div class="alert alert-danger">@erroMensagem</div> }
                    <label class="form-label fw-bold">Motivo da recusa <span class="text-danger">*</span></label>
                    <textarea class="form-control" rows="3" @bind="motivoRecusa" @bind:event="oninput" placeholder="Informe o motivo (mínimo de 5 caracteres)..."></textarea>
                </div>
                <div class="blazor-modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModais">Voltar</button>
                    <button type="button" class="btn btn-danger" @onclick="RecusarOrcamento" disabled="@(string.IsNullOrWhiteSpace(motivoRecusa) || motivoRecusa.Trim().Length < 5)">
                        <i class="bi bi-x-lg me-1"></i> Confirmar Recusa
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Renovar Validade -->
    @if (mostrarModalRenovar)
    {
        <div class="blazor-modal-backdrop" @onclick="FecharModais"></div>
        <div class="blazor-modal d-print-none">
            <div class="blazor-modal-content">
                <div class="blazor-modal-header bg-secondary text-white">
                    <h5><i class="bi bi-calendar-plus me-2"></i>Renovar Validade do Orçamento</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModais"></button>
                </div>
                <div class="blazor-modal-body text-dark">
                    @if (!string.IsNullOrEmpty(erroMensagem)) { <div class="alert alert-danger">@erroMensagem</div> }
                    <label class="form-label fw-bold">Nova validade</label>
                    <input type="date" class="form-control" @bind="novaValidade" />
                </div>
                <div class="blazor-modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModais">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="RenovarValidade"><i class="bi bi-check-lg me-1"></i> Renovar</button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Aditivos -->
    @if (mostrarModalAditivo)
    {
        <div class="blazor-modal-backdrop" @onclick="FecharModais"></div>
        <div class="blazor-modal d-print-none">
            <div class="blazor-modal-content" style="max-width: 650px;">
                <div class="blazor-modal-header bg-warning text-dark">
                    <h5><i class="bi bi-exclamation-triangle me-2"></i>Responder Aditivos</h5>
                    <button type="button" class="btn-close" @onclick="FecharModais"></button>
                </div>
                <div class="blazor-modal-body text-dark">
                    @if (!string.IsNullOrEmpty(erroMensagem)) { <div class="alert alert-danger">@erroMensagem</div> }
                    <p class="small text-muted">Marque os itens <strong>aprovados</strong> pelo cliente; os desmarcados serão <strong>recusados</strong>.</p>
                    @foreach (var s in aditivosServicosPendentes)
                    {
                        var sid = s.Id;
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="ad-s-@sid" checked="@servicosSelecionados.Contains(sid)" @onchange="e => AlternarSelecao(servicosSelecionados, sid, (bool)e.Value!)" />
                            <label class="form-check-label" for="ad-s-@sid">Serviço: @s.Quantidade x @(s.Servico?.Nome ?? "Serviço") — @Moeda(s.Subtotal)</label>
                        </div>
                    }
                    @foreach (var p in aditivosPecasPendentes)
                    {
                        var pid = p.Id;
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="ad-p-@pid" checked="@pecasSelecionadas.Contains(pid)" @onchange="e => AlternarSelecao(pecasSelecionadas, pid, (bool)e.Value!)" />
                            <label class="form-check-label" for="ad-p-@pid">Peça: @p.Quantidade x @(p.Peca?.Nome ?? "Peça") (@NomeEnum(p.Origem)) — @Moeda(p.Subtotal)</label>
                        </div>
                    }
                    <hr />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Autorizado por (nome) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="autorizadoPor" />
                    </div>
                    <div>
                        <label class="form-label fw-bold">Canal</label>
                        <select class="form-select" @bind="canalAutorizacao">
                            @foreach (TipoContato tipo in Enum.GetValues(typeof(TipoContato)))
                            {
                                <option value="@tipo">@NomeEnum(tipo)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="blazor-modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModais">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="ResponderAditivos" disabled="@(string.IsNullOrWhiteSpace(autorizadoPor))">
                        <i class="bi bi-check-lg me-1"></i> Confirmar
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Atribuir Mecânico -->
    @if (mostrarModalMecanico)
    {
        <div class="blazor-modal-backdrop" @onclick="FecharModais"></div>
        <div class="blazor-modal d-print-none">
            <div class="blazor-modal-content">
                <div class="blazor-modal-header bg-dark text-white">
                    <h5><i class="bi bi-person-gear me-2"></i>Atribuir Mecânico</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModais"></button>
                </div>
                <div class="blazor-modal-body text-dark">
                    @if (!string.IsNullOrEmpty(erroMensagem)) { <div class="alert alert-danger">@erroMensagem</div> }
                    <label class="form-label fw-bold">Mecânico</label>
                    <select class="form-select" @bind="mecanicoSelecionadoId">
                        <option value="0">-- Selecione --</option>
                        @foreach (var m in mecanicos)
                        {
                            <option value="@m.Id">@m.NomeCompleto</option>
                        }
                    </select>
                </div>
                <div class="blazor-modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModais">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="AtribuirMecanico" disabled="@(mecanicoSelecionadoId == 0)">
                        <i class="bi bi-check-lg me-1"></i> Atribuir
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Conclusão (Marcar pronta) -->
    @if (mostrarModalConclusao)
    {
        var pendentes = (os.ServicosAExecutarList?.Count(s => s.StatusItem == StatusItem.Aprovado && !s.Executado) ?? 0)
                      + (os.PecasUtilizadas?.Count(p => p.StatusItem == StatusItem.Aprovado && !p.Aplicada) ?? 0);
        <div class="blazor-modal-backdrop" @onclick="FecharModais"></div>
        <div class="blazor-modal d-print-none">
            <div class="blazor-modal-content">
                <div class="blazor-modal-header bg-primary text-white">
                    <h5><i class="bi bi-flag me-2"></i>Marcar O.S. como Pronta</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModais"></button>
                </div>
                <div class="blazor-modal-body text-dark">
                    @if (!string.IsNullOrEmpty(erroMensagem)) { <div class="alert alert-danger">@erroMensagem</div> }
                    <h6 class="fw-bold">Checklist de conclusão</h6>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="ck-fluidos" @bind="checkFluidos" /><label class="form-check-label" for="ck-fluidos">Níveis de fluidos conferidos</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="ck-limpeza" @bind="checkLimpeza" /><label class="form-check-label" for="ck-limpeza">Veículo limpo / área de trabalho limpa</label></div>
                    <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="ck-ferr" @bind="checkFerramentas" /><label class="form-check-label" for="ck-ferr">Ferramentas recolhidas</label></div>

                    @if (pendentes > 0)
                    {
                        <div class="alert alert-warning small">
                            Existem <strong>@pendentes</strong> item(ns) aprovado(s) não executados/aplicados. Informe uma justificativa para concluir assim mesmo.
                        </div>
                    }
                    <label class="form-label fw-bold">Justificativa @(pendentes > 0 ? "(obrigatória)" : "(opcional)")</label>
                    <textarea class="form-control" rows="3" @bind="justificativaConclusao"></textarea>
                </div>
                <div class="blazor-modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModais">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="ConcluirOS" disabled="@(pendentes > 0 && string.IsNullOrWhiteSpace(justificativaConclusao))">
                        <i class="bi bi-check-lg me-1"></i> Marcar pronta
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Entrega -->
    @if (mostrarModalEntrega)
    {
        var totalPago = linhasPagamento.Sum(l => l.Valor);
        var saldo = os.ValorTotal - totalPago - (os.Pagamentos?.Sum(p => p.Valor) ?? 0m);
        <div class="blazor-modal-backdrop" @onclick="FecharModais"></div>
        <div class="blazor-modal d-print-none">
            <div class="blazor-modal-content" style="max-width: 700px;">
                <div class="blazor-modal-header bg-success text-white">
                    <h5><i class="bi bi-box-arrow-right me-2"></i>Entregar Veículo</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModais"></button>
                </div>
                <div class="blazor-modal-body text-dark">
                    @if (!string.IsNullOrEmpty(erroMensagem)) { <div class="alert alert-danger">@erroMensagem</div> }
                    <div class="mb-3">
                        <label class="form-label fw-bold">KM de saída <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" min="@os.KmEntrada" @bind="kmSaida" />
                        <small class="text-muted">KM de entrada: @os.KmEntrada.ToString("N0")</small>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold mb-0">Pagamentos</h6>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AdicionarLinhaPagamento"><i class="bi bi-plus-lg me-1"></i>Adicionar linha</button>
                    </div>
                    @foreach (var l in linhasPagamento)
                    {
                        <div class="row g-2 mb-2 align-items-center">
                            <div class="col-6">
                                <select class="form-select form-select-sm" @bind="l.Forma">
                                    @foreach (FormaPagamento f in Enum.GetValues(typeof(FormaPagamento)))
                                    {
                                        <option value="@f">@NomeEnum(f)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-4"><input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="l.Valor" /></div>
                            <div class="col-2 text-end"><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoverLinhaPagamento(l)"><i class="bi bi-trash"></i></button></div>
                        </div>
                    }
                    <div class="border rounded p-2 bg-light mt-3">
                        <div class="d-flex justify-content-between"><span>Valor total</span><strong>@Moeda(os.ValorTotal)</strong></div>
                        @if (os.Pagamentos?.Any() == true)
                        {
                            <div class="d-flex justify-content-between"><span>Já pago</span><strong>@Moeda(os.Pagamentos.Sum(p => p.Valor))</strong></div>
                        }
                        <div class="d-flex justify-content-between"><span>Informado agora</span><strong>@Moeda(totalPago)</strong></div>
                        <div class="d-flex justify-content-between @(saldo > 0 ? "text-danger" : "text-success")"><span>Saldo restante</span><strong>@Moeda(saldo)</strong></div>
                    </div>

                    @if (saldo > 0)
                    {
                        @if (isAdmin)
                        {
                            <div class="mt-3">
                                <label class="form-label fw-bold">Observação do saldo em aberto</label>
                                <textarea class="form-control" rows="2" @bind="observacaoSaldo" placeholder="Justifique a entrega com saldo em aberto..."></textarea>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mt-3 mb-0 small">Existe saldo em aberto. Somente Administradores podem autorizar a entrega com saldo pendente.</div>
                        }
                    }
                </div>
                <div class="blazor-modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModais">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="EntregarOS" disabled="@(kmSaida < os.KmEntrada)">
                        <i class="bi bi-check-lg me-1"></i> Confirmar Entrega
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Adicionar Peça -->
    @if (mostrarModalPeca)
    {
        <div class="blazor-modal-backdrop" @onclick="FecharModalPeca"></div>
        <div class="blazor-modal d-print-none">
            <div class="blazor-modal-content" style="max-width: 550px;">
                <div class="blazor-modal-header" style="background: var(--accent); color: white;">
                    <h5><i class="bi bi-box-seam me-2"></i>Adicionar Peça à O.S.</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalPeca"></button>
                </div>
                <div class="blazor-modal-body text-dark">
                    @if (!string.IsNullOrEmpty(erroPeca)) { <div class="alert alert-danger">@erroPeca</div> }

                    <div class="mb-3">
                        <label class="form-label">Buscar Peça</label>
                        <select class="form-select" @bind="pecaSelecionadaId" @bind:after="OnPecaSelecionada">
                            <option value="0">-- Selecione uma peça --</option>
                            @if (pecasDisponiveis != null)
                            {
                                foreach (var p in pecasDisponiveis)
                                {
                                    <option value="@p.Id">[@p.Sku] @p.Nome — Estoque: @p.EstoqueAtual — @Moeda(p.PrecoVenda)</option>
                                }
                            }
                        </select>
                    </div>

                    @if (pecaSelecionadaParaAdicionar != null)
                    {
                        <div class="alert bg-light border mb-3">
                            <div class="row text-center">
                                <div class="col-4">
                                    <small class="text-muted d-block">Estoque</small>
                                    <strong class="@(pecaSelecionadaParaAdicionar.AbaixoDoMinimo ? "text-danger" : "text-success")">@pecaSelecionadaParaAdicionar.EstoqueAtual</strong>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted d-block">Venda (Base)</small>
                                    <strong class="text-success">@Moeda(pecaSelecionadaParaAdicionar.PrecoVenda)</strong>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted d-block">Local</small>
                                    <strong>@(pecaSelecionadaParaAdicionar.Localizacao ?? "N/A")</strong>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label">Quantidade</label>
                            <input type="number" class="form-control" @bind="qtdPecaAdicionar" min="1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Valor Cobrado (R$)</label>
                            <input type="number" class="form-control @(temDescontoModal ? "border-warning" : "")" @bind="valorCobradoModal" step="0.01" min="0" />
                        </div>
                    </div>

                    @if (os.Status != OrdemServicoStatus.Orcamento)
                    {
                        <div class="mb-3">
                            <label class="form-label">Origem da peça</label>
                            <select class="form-select" @bind="origemPecaAditiva">
                                @foreach (OrigemPeca o in Enum.GetValues(typeof(OrigemPeca)))
                                {
                                    <option value="@o">@NomeEnum(o)</option>
                                }
                            </select>
                            <small class="text-muted">Após a aprovação, a peça entra como <strong>aditivo</strong> pendente de aprovação do cliente.</small>
                        </div>
                    }

                    @if (temDescontoModal)
                    {
                        <div class="alert alert-warning py-2 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span><strong>Atenção:</strong> o valor cobrado (@Moeda(valorCobradoModal)) está <strong>abaixo</strong> do preço base sugerido (@Moeda(precoBaseModal)).</span>
                        </div>
                    }
                </div>
                <div class="blazor-modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalPeca">Cancelar</button>
                    @if (temDescontoModal && !isAdmin)
                    {
                        <button type="button" class="btn btn-primary" disabled title="Apenas Administradores podem aplicar desconto abaixo do preço base">
                            <i class="bi bi-lock-fill me-1"></i> Bloqueado (Desconto)
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="AdicionarPecaOS" disabled="@(pecaSelecionadaId == 0 || qtdPecaAdicionar <= 0)">
                            <i class="bi bi-plus-lg me-1"></i> Adicionar
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Modal Cancelamento -->
    @if (mostrarModalCancelamento)
    {
        <div class="blazor-modal-backdrop" @onclick="FecharModais"></div>
        <div class="blazor-modal d-print-none">
            <div class="blazor-modal-content">
                <div class="blazor-modal-header bg-danger text-white">
                    <h5><i class="bi bi-x-circle me-2"></i>Cancelar Ordem de Serviço</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModais"></button>
                </div>
                <div class="blazor-modal-body text-dark">
                    @if (!string.IsNullOrEmpty(erroMensagem)) { <div class="alert alert-danger">@erroMensagem</div> }
                    <p>Tem certeza que deseja <strong>cancelar</strong> a O.S. Nº <strong>@os.Id.ToString("D4")</strong>?</p>
                    @if (OrdemServicoService.EstaComEstoqueBaixado(os.Status) && os.PecasUtilizadas?.Any() == true)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>@os.PecasUtilizadas.Count peça(s)</strong> serão devolvidas ao estoque automaticamente (Estorno).
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label fw-bold">Motivo do Cancelamento <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" @bind="motivoCancelamento" @bind:event="oninput"
                                  placeholder="Informe o motivo do cancelamento (mínimo de 5 caracteres)..."></textarea>
                    </div>
                </div>
                <div class="blazor-modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModais">Manter OS</button>
                    <button type="button" class="btn btn-danger" @onclick="CancelarOS"
                            disabled="@(string.IsNullOrWhiteSpace(motivoCancelamento) || motivoCancelamento.Trim().Length < 5)">
                        <i class="bi bi-x-lg me-1"></i> Confirmar Cancelamento
                    </button>
                </div>
            </div>
        </div>
    }
}

<style>
    /* Blazor-controlled Modal */
    .blazor-modal-backdrop {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.5); z-index: 1040;
    }
    .blazor-modal {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        display: flex; align-items: center; justify-content: center;
        z-index: 1050;
    }
    .blazor-modal-content {
        background: white; border-radius: 0.5rem; width: 500px; max-width: 90%;
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.3);
        max-height: 90vh;
        overflow-y: auto;
    }
    .blazor-modal-header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1rem 1.25rem; border-radius: 0.5rem 0.5rem 0 0;
    }
    .blazor-modal-header h5 { margin: 0; }
    .blazor-modal-body { padding: 1.25rem; }
    .blazor-modal-footer {
        display: flex; justify-content: flex-end; gap: 0.5rem;
        padding: 1rem 1.25rem; border-top: 1px solid #dee2e6;
    }

    /* Barra de progresso do ciclo */
    .os-stepper { display: flex; align-items: center; gap: 0; }
    .os-step { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; color: #6c757d; }
    .os-step:not(:last-child)::after {
        content: ""; position: absolute; top: 15px; left: 50%; width: 100%; height: 3px; background: #dee2e6; z-index: 0;
    }
    .os-step.done:not(:last-child)::after { background: #198754; }
    .os-step-dot {
        width: 32px; height: 32px; border-radius: 50%; background: #dee2e6; color: #495057;
        display: flex; align-items: center; justify-content: center; font-weight: bold; z-index: 1;
    }
    .os-step.done .os-step-dot { background: #198754; color: white; }
    .os-step.current .os-step-dot { background: #0d6efd; color: white; box-shadow: 0 0 0 4px rgba(13,110,253,.25); }
    .os-step.current { color: #0d6efd; font-weight: 600; }
    .os-step.done { color: #198754; }
    .os-step-label { font-size: 0.8rem; margin-top: 0.25rem; }

    /* Print Formatting */
    @@media print {
        body { background: white; font-size: 12pt; }
        .d-print-none { display: none !important; }
        .sidebar { display: none !important; }
        .navbar-toggler { display: none !important; }
        main { margin: 0 !important; padding: 0 !important; width: 100% !important; }
        .os-document { border: none !important; box-shadow: none !important; }
        .card-header { background: transparent !important; color: black !important; border-bottom: 2px solid black !important; }
        .term-box { page-break-inside: avoid; border: 1px solid #ccc !important; }
        .blazor-modal-backdrop, .blazor-modal { display: none !important; }
    }

    /* ── Responsividade Mobile ── */
    @@media (max-width: 768px) {
        .d-print-none.mb-4.d-flex.justify-content-between {
            flex-direction: column;
            align-items: stretch;
            gap: 0.75rem;
        }
        .d-print-none.mb-4.d-flex.justify-content-between > div {
            width: 100%;
        }
        .d-print-none.mb-4.d-flex.justify-content-between .btn {
            width: 100%;
            justify-content: center;
        }
        .os-document .card-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
            padding: 1rem;
        }
        .os-document .card-header h4 {
            font-size: 1.1rem;
            margin: 0;
        }
        .os-document .card-header .text-end {
            text-align: left !important;
        }
        .os-document .card-body {
            padding: 1rem;
        }
        .os-document .row .col-sm-3,
        .os-document .row .col-sm-4 {
            margin-bottom: 0.5rem;
        }
        .table-responsive {
            -webkit-overflow-scrolling: touch;
        }
        .blazor-modal-content {
            width: 95% !important;
            max-height: 85vh;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }
        .term-box {
            padding: 1rem;
        }
        .col-md-6.offset-md-6 {
            margin-left: 0 !important;
            flex: 0 0 100%;
            max-width: 100%;
        }
        .os-step-label { font-size: 0.65rem; text-align: center; }
    }

    @@media (max-width: 480px) {
        .os-document .card-header h4 {
            font-size: 1rem;
        }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private static readonly string[] Etapas = { "Orçamento", "Aprovada", "Execução", "Concluída", "Entregue" };
    private static readonly CultureInfo PtBr = new("pt-BR");

    private OrdemServico? os;
    private Configuracao? config;
    private string? erroMensagem;
    private bool carregando = true;
    [Inject] private ILogger<Details> Logger { get; set; } = default!;

    // Contexto do usuário
    private bool isAdmin = false;
    private bool isAtendimento = false;
    private bool isMecanico = false;
    private int usuarioIdAtual = 0;
    private bool podeGerenciar => isAdmin || isAtendimento;

    // Modais
    private bool mostrarModalAprovacao, mostrarModalCancelamento, mostrarModalEdicao, mostrarModalRecusa,
                 mostrarModalRenovar, mostrarModalAditivo, mostrarModalMecanico, mostrarModalConclusao,
                 mostrarModalEntrega, mostrarModalPeca;
    private bool AlgumModalAberto => mostrarModalAprovacao || mostrarModalCancelamento || mostrarModalEdicao || mostrarModalRecusa
        || mostrarModalRenovar || mostrarModalAditivo || mostrarModalMecanico || mostrarModalConclusao || mostrarModalEntrega || mostrarModalPeca;

    // Aprovação / aditivos
    private string autorizadoPor = "";
    private TipoContato canalAutorizacao = TipoContato.Presencial;
    private HashSet<int> servicosSelecionados = new();
    private HashSet<int> pecasSelecionadas = new();
    private string motivoRecusa = "";
    private string motivoCancelamento = "";
    private DateTime novaValidade = DateTime.Today.AddDays(10);

    // Edição
    private string? editDescricaoProblema;
    private string? editDiagnostico;
    private DateTime editDataPrevisaoEntrega;
    private decimal editValorDesconto;

    // Mecânico
    private List<Usuario> mecanicos = new();
    private int mecanicoSelecionadoId = 0;

    // Conclusão
    private bool checkFluidos, checkLimpeza, checkFerramentas;
    private string? justificativaConclusao;

    // Entrega
    private class LinhaPagamento { public FormaPagamento Forma { get; set; } = FormaPagamento.Pix; public decimal Valor { get; set; } }
    private List<LinhaPagamento> linhasPagamento = new();
    private int kmSaida;
    private string? observacaoSaldo;

    // Peças
    private IEnumerable<Peca>? pecasDisponiveis;
    private int pecaSelecionadaId = 0;
    private int qtdPecaAdicionar = 1;
    private decimal valorCobradoModal = 0;
    private decimal precoBaseModal = 0;
    private OrigemPeca origemPecaAditiva = OrigemPeca.Estoque;
    private string? erroPeca;
    private Peca? pecaSelecionadaParaAdicionar => pecasDisponiveis?.FirstOrDefault(p => p.Id == pecaSelecionadaId);
    private bool temDescontoModal => pecaSelecionadaId > 0 && valorCobradoModal < precoBaseModal;

    // Derivados
    private bool OSFinalizada => os != null && (os.Status == OrdemServicoStatus.Concluida || os.Status == OrdemServicoStatus.Entregue
        || os.Status == OrdemServicoStatus.Cancelada || os.Status == OrdemServicoStatus.Recusada);
    private bool EmExecucao => os != null && (os.Status == OrdemServicoStatus.Aprovada || os.Status == OrdemServicoStatus.EmAndamento
        || os.Status == OrdemServicoStatus.Pausada || os.Status == OrdemServicoStatus.AguardandoPecas || os.Status == OrdemServicoStatus.AguardandoCliente);
    private bool OrcamentoVencido => os != null && os.Status == OrdemServicoStatus.Orcamento && os.ValidadeOrcamentoAte < DateTime.UtcNow;
    private bool PodeEditarDiagnostico => os != null && !OSFinalizada && (podeGerenciar || PodeEditarDiagnosticoMecanico);
    private bool PodeEditarDiagnosticoMecanico => os != null && isMecanico && !OSFinalizada && os.MecanicoResponsavelId == usuarioIdAtual;
    private bool PodeMarcarExecucao => os != null && os.Status == OrdemServicoStatus.EmAndamento && (podeGerenciar || isMecanico);

    private List<OrdemServicoServico> aditivosServicosPendentes =>
        os?.ServicosAExecutarList.Where(s => s.EhAditivo && s.StatusItem == StatusItem.Pendente).ToList() ?? new();
    private List<OrdemServicoPeca> aditivosPecasPendentes =>
        os?.PecasUtilizadas.Where(p => p.EhAditivo && p.StatusItem == StatusItem.Pendente).ToList() ?? new();

    private ApontamentoTempo? apontamentoAbertoUsuario =>
        os?.ApontamentosTempo.FirstOrDefault(a => a.MecanicoId == usuarioIdAtual && a.Fim == null);

    private record TempoMecanico(string Nome, int Quantidade, int Minutos, bool EmAberto);
    private List<TempoMecanico> temposPorMecanico => os?.ApontamentosTempo
        .GroupBy(a => a.MecanicoId)
        .Select(g => new TempoMecanico(
            g.First().Mecanico?.NomeCompleto ?? $"Mecânico #{g.Key}",
            g.Count(),
            g.Sum(a => a.DuracaoMinutos),
            g.Any(a => a.Fim == null)))
        .OrderByDescending(t => t.Minutos)
        .ToList() ?? new();
    private int tempoRealTotal => os?.ApontamentosTempo.Sum(a => a.DuracaoMinutos) ?? 0;

    private int EtapaAtual() => os?.Status switch
    {
        OrdemServicoStatus.Orcamento => 0,
        OrdemServicoStatus.Aprovada => 1,
        OrdemServicoStatus.EmAndamento or OrdemServicoStatus.Pausada or OrdemServicoStatus.AguardandoPecas or OrdemServicoStatus.AguardandoCliente => 2,
        OrdemServicoStatus.Concluida => 3,
        OrdemServicoStatus.Entregue => 4,
        _ => 0
    };

    // ─── Helpers de apresentação ─────────────────────────────────────────────────
    private static string Moeda(decimal v) => v.ToString("C", PtBr);

    private static string FormatarMinutos(int minutos) =>
        minutos <= 0 ? "0 min" : (minutos >= 60 ? $"{minutos / 60}h {minutos % 60:00}min" : $"{minutos} min");

    private static string NomeEnum(Enum valor)
    {
        var membro = valor.GetType().GetMember(valor.ToString()).FirstOrDefault();
        var display = membro?.GetCustomAttribute<DisplayAttribute>();
        return display?.GetName() ?? valor.ToString();
    }

    private static string NomeStatus(OrdemServicoStatus s) => s switch
    {
        OrdemServicoStatus.Orcamento => "Orçamento",
        OrdemServicoStatus.Aprovada => "Aprovada",
        OrdemServicoStatus.EmAndamento => "Em Andamento",
        OrdemServicoStatus.Pausada => "Pausada",
        OrdemServicoStatus.AguardandoPecas => "Aguardando Peças",
        OrdemServicoStatus.AguardandoCliente => "Aguardando Cliente",
        OrdemServicoStatus.Concluida => "Concluída (pronta)",
        OrdemServicoStatus.Entregue => "Entregue",
        OrdemServicoStatus.Recusada => "Recusada",
        OrdemServicoStatus.Cancelada => "Cancelada",
        _ => s.ToString()
    };

    private static string BadgeStatusItem(StatusItem s) => s switch
    {
        StatusItem.Aprovado => "bg-success",
        StatusItem.Recusado => "bg-danger",
        _ => "bg-warning text-dark"
    };

    private static void AlternarSelecao(HashSet<int> conjunto, int id, bool marcado)
    {
        if (marcado) conjunto.Add(id); else conjunto.Remove(id);
    }

    // ─── Carga ───────────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var contexto = await CurrentUserService.ObterContextoAtualAsync();
        usuarioIdAtual = contexto.UsuarioId;
        isAdmin = contexto.Perfil == PerfilUsuario.Administrador;
        isAtendimento = contexto.Perfil == PerfilUsuario.Atendimento;
        isMecanico = contexto.Perfil == PerfilUsuario.Mecanico;

        await LoadData();

        _uiTimer = new System.Timers.Timer(30000);
        _uiTimer.Elapsed += async (sender, e) => await InvokeAsync(StateHasChanged);
        _uiTimer.Start();
    }

    private System.Timers.Timer? _uiTimer;

    public void Dispose()
    {
        _uiTimer?.Dispose();
    }

    private async Task LoadData()
    {
        try
        {
            os = await OrdemServicoQueryService.ObterDetalhesAsync(Id);

            if (os != null)
            {
                autorizadoPor = os.Veiculo?.Cliente?.Nome ?? "";
            }

            config = await OrdemServicoQueryService.ObterConfiguracaoAsync();
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task<(int usuarioId, PerfilUsuario perfil, string nomeUsuario)> GetUsuarioContextoCompletoAtual()
    {
        var contexto = await CurrentUserService.ObterContextoAtualAsync();
        return (contexto.UsuarioId, contexto.Perfil, contexto.NomeUsuario);
    }

    private async Task<(int usuarioId, PerfilUsuario perfil)> GetUsuarioContextoAtual()
    {
        var (usuarioId, perfil, _) = await GetUsuarioContextoCompletoAtual();
        return (usuarioId, perfil);
    }

    /// <summary>Executa uma ação de domínio, recarrega os dados e trata erros com mensagem segura.</summary>
    private async Task Executar(Func<int, PerfilUsuario, string, Task> acao, string mensagemPadrao, Action? aoSucesso = null)
    {
        if (os == null) return;
        try
        {
            erroMensagem = null;
            var (usuarioId, perfil, nome) = await GetUsuarioContextoCompletoAtual();
            await acao(usuarioId, perfil, nome);
            await LoadData();
            aoSucesso?.Invoke();
        }
        catch (Exception ex)
        {
            erroMensagem = DomainErrorHelper.ObterMensagemSegura(ex, Logger, mensagemPadrao);
        }
    }

    private void FecharModais()
    {
        mostrarModalAprovacao = mostrarModalCancelamento = mostrarModalEdicao = mostrarModalRecusa = false;
        mostrarModalRenovar = mostrarModalAditivo = mostrarModalMecanico = mostrarModalConclusao = false;
        mostrarModalEntrega = mostrarModalPeca = false;
        erroMensagem = null;
        erroPeca = null;
    }

