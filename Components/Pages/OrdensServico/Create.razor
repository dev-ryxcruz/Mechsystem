@page "/ordens-servico/nova"
@rendermode InteractiveServer
@using mechsystem.Models
@using mechsystem.Interfaces
@using mechsystem.Services
@using mechsystem.Services.Queries
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador, Atendimento")]
@inject OrdemServicoQueryService OrdemServicoQueryService
@inject OrdemServicoService OrdemServicoService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject IClienteRepository ClienteRepository
@inject IVeiculoRepository VeiculoRepository
@inject IJSRuntime JS

<PageTitle>Nova Ordem de Serviço</PageTitle>

<div class="row align-items-center g-2 mb-4">
    <div class="col-12 col-sm">
        <h2 class="mb-0">Nova Ordem de Serviço (Orçamento)</h2>
    </div>
    <div class="col-auto">
        <a href="/ordens-servico" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Voltar
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (isLoading)
        {
            <p>Carregando dados...</p>
        }
        else
        {
            <EditForm Model="os" OnValidSubmit="HandleValidSubmit" FormName="NovaOS">
                <DataAnnotationsValidator />
                
                <h5 class="mb-3 border-bottom pb-2"><i class="bi bi-car-front me-2"></i>1. Veículo e Entrada</h5>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="veiculoId" class="form-label">Veículo (Cliente) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <InputSelect id="veiculoId" @bind-Value="os.VeiculoId" @bind-Value:after="OnVeiculoSelecionado" class="form-select">
                                <option value="0">-- Selecione um Veículo --</option>
                                @if (veiculos != null)
                                {
                                    @foreach (var v in veiculos)
                                    {
                                        <option value="@v.Id">@v.Placa - @v.Modelo (@v.Cliente?.Nome)</option>
                                    }
                                }
                            </InputSelect>
                            <button type="button" class="btn btn-outline-primary" @onclick="AbrirWizardCadastro" title="Cadastrar novo cliente e veículo">
                                <i class="bi bi-person-plus-fill me-1"></i> Novo
                            </button>
                        </div>
                        <ValidationMessage For="@(() => os.VeiculoId)" class="text-danger" />

                        @if (veiculos == null || !veiculos.Any())
                        {
                            <div class="alert alert-info mt-2 mb-0 py-2 px-3 d-flex align-items-center gap-2">
                                <i class="bi bi-info-circle"></i>
                                <span>Nenhum veículo cadastrado. Use o botão <strong>"Novo"</strong> para cadastrar um cliente e veículo rapidamente.</span>
                            </div>
                        }
                    </div>
                    <div class="col-md-3">
                        <label for="kmEntrada" class="form-label">KM de Entrada <span class="text-danger">*</span></label>
                        <InputNumber id="kmEntrada" @bind-Value="os.KmEntrada" class="form-control" min="1" />
                        <ValidationMessage For="@(() => os.KmEntrada)" class="text-danger" />
                        @if (!string.IsNullOrEmpty(erroKm))
                        {
                            <div class="text-danger small mt-1">@erroKm</div>
                        }
                        @{
                            var veiculoSel = veiculos?.FirstOrDefault(v => v.Id == os.VeiculoId);
                        }
                        @if (veiculoSel != null && os.KmEntrada > 0 && os.KmEntrada < veiculoSel.Quilometragem)
                        {
                            <div class="alert alert-warning py-1 px-2 small mt-1 mb-0">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                KM informado (@os.KmEntrada.ToString("N0")) é menor que a quilometragem do veículo (@veiculoSel.Quilometragem.ToString("N0") km). Ao salvar, a observação será registrada.
                            </div>
                        }
                    </div>
                    <div class="col-md-3">
                        <label for="combustivelEntrada" class="form-label">Combustível (Entrada) <span class="text-danger">*</span></label>
                        <InputSelect id="combustivelEntrada" @bind-Value="nivelCombustivelSelecionado" class="form-select">
                            <option value="">Selecione...</option>
                            @foreach (var nivel in Enum.GetValues<NivelCombustivel>())
                            {
                                <option value="@nivel">@nivel.ToDisplayText()</option>
                            }
                        </InputSelect>
                        @if (!string.IsNullOrEmpty(erroCombustivel))
                        {
                            <div class="text-danger small mt-1">@erroCombustivel</div>
                        }
                    </div>
                </div>

                <h5 class="mb-3 border-bottom pb-2 mt-4"><i class="bi bi-chat-left-text me-2"></i>2. Queixa do Cliente</h5>
                <div class="row mb-3">
                    <div class="col-md-12 mb-3">
                        <label for="queixa" class="form-label">Queixa do Cliente <span class="text-danger">*</span></label>
                        <InputTextArea id="queixa" @bind-Value="os.QueixaCliente" class="form-control" rows="3"></InputTextArea>
                        <ValidationMessage For="@(() => os.QueixaCliente)" class="text-danger" />
                    </div>
                    <div class="col-md-12">
                        <label for="diagnostico" class="form-label">Diagnóstico Técnico (Opcional)</label>
                        <InputTextArea id="diagnostico" @bind-Value="os.Diagnostico" class="form-control" rows="2"></InputTextArea>
                    </div>
                </div>

                <h5 class="mb-3 border-bottom pb-2 mt-4"><i class="bi bi-list-check me-2"></i>3. Itens do Orçamento</h5>

                @if (!string.IsNullOrEmpty(erroItens))
                {
                    <div class="alert alert-danger py-2">@erroItens</div>
                }

                @* ── Serviços ── *@
                <div class="card bg-light border-secondary mb-3">
                    <div class="card-body p-3">
                        <h6 class="fw-bold mb-2"><i class="bi bi-wrench-adjustable text-primary me-2"></i>Serviços</h6>
                        <div class="input-group">
                            <select class="form-select" @bind="servicoSelecionadoId">
                                <option value="0">-- Selecione um serviço do catálogo --</option>
                                @if (catalogoServicos != null)
                                {
                                    foreach (var s in catalogoServicos)
                                    {
                                        <option value="@s.Id">@s.Nome - @s.ValorPadrao.ToString("C")</option>
                                    }
                                }
                            </select>
                            <button type="button" class="btn btn-primary" @onclick="AdicionarServicoNaLista" disabled="@(servicoSelecionadoId == 0)">
                                <i class="bi bi-plus-lg me-1"></i> Adicionar
                            </button>
                        </div>
                        @if (linhasServico.Any())
                        {
                            <div class="table-responsive mt-3">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr><th>Serviço</th><th style="width:100px">Qtd.</th><th style="width:150px">Valor unit. (R$)</th><th class="text-end" style="width:130px">Subtotal</th><th style="width:50px"></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var l in linhasServico)
                                        {
                                            <tr>
                                                <td>@l.Nome</td>
                                                <td><InputNumber @bind-Value="l.Quantidade" @bind-Value:after="AtualizarPrevisaoSugerida" class="form-control form-control-sm" min="1" /></td>
                                                <td><InputNumber @bind-Value="l.Valor" class="form-control form-control-sm" min="0" step="0.01" /></td>
                                                <td class="text-end fw-bold text-success">@l.Subtotal.ToString("C")</td>
                                                <td><button type="button" class="btn btn-sm btn-outline-danger" title="Remover" @onclick="() => RemoverServico(l)"><i class="bi bi-trash"></i></button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                @* ── Peças ── *@
                <div class="card bg-light border-secondary mb-3">
                    <div class="card-body p-3">
                        <h6 class="fw-bold mb-2"><i class="bi bi-gear text-primary me-2"></i>Peças</h6>
                        <div class="row g-2">
                            <div class="col-md-8">
                                <input type="text" class="form-control" placeholder="Buscar peça por nome ou SKU..." @bind="buscaPeca" @bind:event="oninput" @bind:after="BuscarPecas" />
                            </div>
                            <div class="col-md-4">
                                <select class="form-select" @bind="origemNovaPeca">
                                    <option value="@OrigemPeca.Estoque">Estoque</option>
                                    <option value="@OrigemPeca.SobDemanda">Sob Demanda</option>
                                    <option value="@OrigemPeca.ClienteTrouxe">Cliente Trouxe</option>
                                </select>
                            </div>
                        </div>
                        @if (resultadoPecas.Any())
                        {
                            <ul class="list-group mt-2">
                                @foreach (var p in resultadoPecas)
                                {
                                    <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2">
                                        <span>@p.Nome <small class="text-muted">(@p.Sku · estoque: @p.EstoqueAtual)</small></span>
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="text-success fw-bold">@p.PrecoVenda.ToString("C")</span>
                                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => AdicionarPeca(p)"><i class="bi bi-plus-lg"></i></button>
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                        else if (!string.IsNullOrWhiteSpace(buscaPeca) && buscaPeca.Trim().Length >= 2)
                        {
                            <p class="small text-muted mt-2 mb-0">Nenhuma peça encontrada.</p>
                        }
                        @if (linhasPeca.Any())
                        {
                            <div class="table-responsive mt-3">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr><th>Peça</th><th style="width:160px">Origem</th><th style="width:90px">Qtd.</th><th style="width:140px">Valor unit. (R$)</th><th class="text-end" style="width:120px">Subtotal</th><th style="width:50px"></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var l in linhasPeca)
                                        {
                                            <tr>
                                                <td>@l.Nome <small class="text-muted">@l.Sku</small></td>
                                                <td>
                                                    <select class="form-select form-select-sm" @bind="l.Origem">
                                                        <option value="@OrigemPeca.Estoque">Estoque</option>
                                                        <option value="@OrigemPeca.SobDemanda">Sob Demanda</option>
                                                        <option value="@OrigemPeca.ClienteTrouxe">Cliente Trouxe</option>
                                                    </select>
                                                </td>
                                                <td><InputNumber @bind-Value="l.Quantidade" @bind-Value:after="AtualizarPrevisaoSugerida" class="form-control form-control-sm" min="1" /></td>
                                                <td><InputNumber @bind-Value="l.Valor" class="form-control form-control-sm" min="0" step="0.01" /></td>
                                                <td class="text-end fw-bold text-success">@l.Subtotal.ToString("C")</td>
                                                <td><button type="button" class="btn btn-sm btn-outline-danger" title="Remover" @onclick="() => linhasPeca.Remove(l)"><i class="bi bi-trash"></i></button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                @* ── Previsão e Totais ── *@
                <div class="row mb-3 mt-4">
                    <div class="col-md-6 mb-3">
                        <label for="previsaoEntrega" class="form-label">Previsão de Entrega <span class="text-danger">*</span></label>
                        <InputDate id="previsaoEntrega" @bind-Value="os.DataPrevisaoEntrega" @bind-Value:after="() => previsaoEditadaManualmente = true" class="form-control" />
                        <small class="text-muted d-block mt-1">
                            <i class="bi bi-info-circle me-1"></i>Sugerida pelo tempo estimado dos serviços (@TempoEstimadoMinutos min). Você pode alterar.
                        </small>
                        <ValidationMessage For="@(() => os.DataPrevisaoEntrega)" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 bg-light">
                            <div class="d-flex justify-content-between"><span>Serviços</span><span>@TotalServicos.ToString("C")</span></div>
                            <div class="d-flex justify-content-between"><span>Peças</span><span>@TotalPecas.ToString("C")</span></div>
                            @if (isAdmin)
                            {
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span>Desconto (R$)</span>
                                    <InputNumber @bind-Value="os.ValorDesconto" class="form-control form-control-sm" style="max-width:140px" min="0" step="0.01" />
                                </div>
                            }
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between fs-5 fw-bold"><span>Total</span><span class="text-success">@TotalGeral.ToString("C")</span></div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-success shadow-sm" disabled="@salvando">
                        <i class="bi bi-save me-1"></i> Gerar Orçamento
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>

@* ─── Modal: Wizard Cadastro Rápido (Cliente + Veículo) ────────────────────── *@
@if (mostrarWizard)
{
    <div class="blazor-modal-backdrop" @onclick="FecharWizard"></div>
    <div class="blazor-modal">
        <div class="blazor-modal-content" style="max-width: 620px;">
            @* ── Header com indicador de passo ── *@
            <div class="blazor-modal-header" style="background: var(--accent, #ff751f); color: white;">
                <h5 class="mb-0">
                    <i class="bi @(passoWizard == 1 ? "bi-person-plus" : "bi-truck") me-2"></i>
                    @(passoWizard == 1 ? "Passo 1 — Cadastrar Cliente" : "Passo 2 — Cadastrar Veículo")
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="FecharWizard"></button>
            </div>

            @* ── Progress indicator ── *@
            <div class="d-flex px-4 pt-3 pb-0">
                <div class="flex-fill text-center">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(passoWizard >= 1 ? "bg-primary text-white" : "bg-light text-muted")" style="width:32px;height:32px;font-weight:700;font-size:14px;">1</div>
                    <div class="small mt-1 @(passoWizard >= 1 ? "fw-bold text-primary" : "text-muted")">Cliente</div>
                </div>
                <div class="flex-fill d-flex align-items-start justify-content-center" style="padding-top:15px;">
                    <div style="height:2px;width:100%;background:@(passoWizard >= 2 ? "var(--accent, #ff751f)" : "#dee2e6");border-radius:2px;"></div>
                </div>
                <div class="flex-fill text-center">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(passoWizard >= 2 ? "bg-primary text-white" : "bg-light text-muted")" style="width:32px;height:32px;font-weight:700;font-size:14px;">2</div>
                    <div class="small mt-1 @(passoWizard >= 2 ? "fw-bold text-primary" : "text-muted")">Veículo</div>
                </div>
            </div>

            @* ── Body ── *@
            <div class="blazor-modal-body text-dark">
                @if (!string.IsNullOrEmpty(erroWizard))
                {
                    <div class="alert alert-danger py-2">@erroWizard</div>
                }

                @if (passoWizard == 1)
                {
                    @* ──── PASSO 1: CLIENTE ──── *@
                    <EditForm Model="novoCliente" OnValidSubmit="AvancarParaVeiculo">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Nome Completo <span class="text-danger">*</span></label>
                                <InputText @bind-Value="novoCliente.Nome" class="form-control" placeholder="Ex: João da Silva" />
                                <ValidationMessage For="@(() => novoCliente.Nome)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">CPF <span class="text-danger">*</span></label>
                                <InputText @bind-Value="novoCliente.Cpf" class="form-control mask-cpf" placeholder="Apenas números" />
                                <ValidationMessage For="@(() => novoCliente.Cpf)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Telefone</label>
                                <InputText @bind-Value="novoCliente.Telefone" class="form-control mask-telefone" placeholder="(00) 00000-0000" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">E-mail</label>
                                <InputText @bind-Value="novoCliente.Email" class="form-control" placeholder="joao@email.com" />
                                <ValidationMessage For="@(() => novoCliente.Email)" class="text-danger small" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Endereço</label>
                                <InputText @bind-Value="novoCliente.Endereco" class="form-control" placeholder="Rua, Número, Bairro, Cidade" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-secondary" @onclick="FecharWizard">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@salvandoWizard">
                                @if (salvandoWizard)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Próximo <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </EditForm>
                }
                else
                {
                    @* ──── PASSO 2: VEÍCULO ──── *@
                    <div class="alert bg-light border mb-3 py-2 d-flex align-items-center gap-2">
                        <i class="bi bi-person-check text-success fs-5"></i>
                        <span>Cliente: <strong>@novoCliente.Nome</strong> (CPF: @novoCliente.Cpf)</span>
                    </div>

                    <EditForm Model="novoVeiculo" OnValidSubmit="ConcluirWizard">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Placa <span class="text-danger">*</span></label>
                                <InputText @bind-Value="novoVeiculo.Placa" class="form-control text-uppercase" placeholder="ABC-1234" />
                                <ValidationMessage For="@(() => novoVeiculo.Placa)" class="text-danger small" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Marca</label>
                                <InputText @bind-Value="novoVeiculo.Marca" class="form-control" placeholder="Ex: Toyota" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Modelo</label>
                                <InputText @bind-Value="novoVeiculo.Modelo" class="form-control" placeholder="Ex: Corolla" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Cor</label>
                                <InputText @bind-Value="novoVeiculo.Cor" class="form-control" placeholder="Ex: Preto" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Ano</label>
                                <InputNumber @bind-Value="novoVeiculo.Ano" class="form-control" placeholder="2020" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Km</label>
                                <InputNumber @bind-Value="novoVeiculo.Quilometragem" class="form-control" placeholder="0" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-4">
                            <button type="button" class="btn btn-outline-secondary" @onclick="VoltarParaCliente">
                                <i class="bi bi-arrow-left me-1"></i> Voltar
                            </button>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-secondary" @onclick="FecharWizard">Cancelar</button>
                                <button type="submit" class="btn btn-success" disabled="@salvandoWizard">
                                    @if (salvandoWizard)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    <i class="bi bi-check-lg me-1"></i> Concluir Cadastro
                                </button>
                            </div>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
}

<style>
    /* Blazor-controlled Modal */
    .blazor-modal-backdrop {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.5); z-index: 1040;
    }
    .blazor-modal {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        display: flex; align-items: center; justify-content: center;
        z-index: 1050;
        padding: 1rem;
    }
    .blazor-modal-content {
        background: white; border-radius: 0.5rem; width: 500px; max-width: 92%;
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.3);
        max-height: 90vh;
        display: flex;
        flex-direction: column;
    }
    .blazor-modal-header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1rem 1.25rem; border-radius: 0.5rem 0.5rem 0 0;
        flex-shrink: 0;
    }
    .blazor-modal-header h5 { margin: 0; }
    .blazor-modal-body {
        padding: 1.25rem;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        flex: 1;
    }

    /* ── Responsividade Mobile ── */
    @@media (max-width: 640px) {
        .blazor-modal {
            padding: 0.5rem;
            align-items: flex-end;
        }
        .blazor-modal-content {
            width: 100%;
            max-width: 100%;
            border-radius: 1rem 1rem 0 0;
            max-height: 92vh;
        }
        .blazor-modal-body {
            padding: 1rem;
        }
    }
</style>

@code {
    [SupplyParameterFromForm]
    private OrdemServico os { get; set; } = default!;

    private List<Veiculo>? veiculos;
    private List<Servico>? catalogoServicos;
    private int servicoSelecionadoId = 0;
    private Configuracao? config;
    private bool isLoading = true;

    // ─── Wizard: Cadastro Rápido ─────────────────────────────────────────────────
    private bool mostrarWizard = false;
    private int passoWizard = 1;
    private Cliente novoCliente = new();
    private Veiculo novoVeiculo = new();
    private string? erroWizard;
    private bool salvandoWizard = false;

    private PerfilUsuario perfilAtual = PerfilUsuario.Atendimento;

    protected override async Task OnInitializedAsync()
    {
        os ??= new();
        os.DataEmissao = DateTime.UtcNow.Date;
        os.DataPrevisaoEntrega = OrdemServicoService.CalcularPrevisaoEntregaSugerida(0);

        var contexto = await CurrentUserService.ObterContextoAtualAsync();
        usuarioIdAtual = contexto.UsuarioId;
        perfilAtual = contexto.Perfil;
        nomeUsuarioAtual = contexto.NomeUsuario;
        isAdmin = perfilAtual == PerfilUsuario.Administrador;

        config = await OrdemServicoQueryService.ObterConfiguracaoAsync();
        os.ValidadeOrcamentoAte = os.DataEmissao.AddDays(config?.ValidadeOrcamentoDias ?? 10);

        veiculos = await OrdemServicoQueryService.ListarVeiculosAtivosParaSelecaoAsync();
        catalogoServicos = await OrdemServicoQueryService.ListarServicosAtivosAsync();

        isLoading = false;
    }

    private void OnVeiculoSelecionado()
    {
        var veiculo = veiculos?.FirstOrDefault(v => v.Id == os.VeiculoId);
        if (veiculo != null && os.KmEntrada == 0)
        {
            os.KmEntrada = veiculo.Quilometragem;
        }
    }

    private async Task HandleValidSubmit()
    {
        erroItens = null;
        erroKm = null;
        erroCombustivel = null;
        if (os.VeiculoId == 0) return;

        if (!nivelCombustivelSelecionado.HasValue || (int)nivelCombustivelSelecionado.Value < 1 || (int)nivelCombustivelSelecionado.Value > 5)
        {
            erroCombustivel = "Selecione o nível de combustível de entrada.";
            return;
        }

        salvando = true;
        try
        {
            var request = new CriarOrcamentoRequest(
                os.VeiculoId,
                os.KmEntrada,
                nivelCombustivelSelecionado.Value,
                os.QueixaCliente,
                os.Diagnostico,
                os.DataPrevisaoEntrega,
                os.ValorDesconto,
                linhasServico.Select(l => new CriarOrcamentoServicoItem(
                    l.ServicoId,
                    l.Quantidade,
                    l.PrecoBase,
                    l.Valor,
                    l.TempoMinutos)).ToList(),
                linhasPeca.Select(l => new CriarOrcamentoPecaItem(
                    l.PecaId,
                    l.Quantidade,
                    l.PrecoBase,
                    l.PrecoCusto,
                    l.Valor,
                    l.Origem)).ToList());

            var osId = await OrdemServicoService.CriarOrcamentoAsync(request, usuarioIdAtual, perfilAtual, nomeUsuarioAtual);
            NavigationManager.NavigateTo($"/ordens-servico/{osId}");
        }
        catch (Exception ex)
        {
            erroItens = DomainErrorHelper.ObterMensagemSegura(ex, Logger, "Não foi possível gerar o orçamento. Tente novamente.");
        }
        finally
        {
            salvando = false;
        }
    }

    // ─── Itens ───────────────────────────────────────────────────────────────────
    private class LinhaServico
    {
        public int ServicoId { get; set; }
        public string Nome { get; set; } = "";
        public int Quantidade { get; set; } = 1;
        public decimal PrecoBase { get; set; }
        public decimal Valor { get; set; }
        public int? TempoMinutos { get; set; }
        public decimal Subtotal => Quantidade * Valor;
    }

    private class LinhaPeca
    {
        public int PecaId { get; set; }
        public string Nome { get; set; } = "";
        public string Sku { get; set; } = "";
        public int Quantidade { get; set; } = 1;
        public decimal PrecoBase { get; set; }
        public decimal PrecoCusto { get; set; }
        public decimal Valor { get; set; }
        public OrigemPeca Origem { get; set; }
        public decimal Subtotal => Quantidade * Valor;
    }

    private readonly List<LinhaServico> linhasServico = new();
    private readonly List<LinhaPeca> linhasPeca = new();
    private List<Peca> resultadoPecas = new();
    private string? buscaPeca;
    private OrigemPeca origemNovaPeca = OrigemPeca.Estoque;
    private string? erroItens;
    private string? erroKm;
    private string? erroCombustivel;
    private NivelCombustivel? nivelCombustivelSelecionado;
    private int usuarioIdAtual;
    private string? nomeUsuarioAtual;
    private bool salvando;
    private bool isAdmin;
    private bool previsaoEditadaManualmente;

    private decimal TotalServicos => linhasServico.Sum(l => l.Subtotal);
    private decimal TotalPecas => linhasPeca.Sum(l => l.Subtotal);
    private decimal TotalGeral => TotalServicos + TotalPecas - (isAdmin ? os.ValorDesconto : 0m);
    private int TempoEstimadoMinutos => linhasServico.Sum(l => (l.TempoMinutos ?? 0) * Math.Max(l.Quantidade, 1));

    private void AdicionarServicoNaLista()
    {
        if (servicoSelecionadoId <= 0 || catalogoServicos == null) return;

        var servico = catalogoServicos.FirstOrDefault(s => s.Id == servicoSelecionadoId);
        if (servico == null) return;

        var existente = linhasServico.FirstOrDefault(l => l.ServicoId == servico.Id);
        if (existente != null)
        {
            existente.Quantidade += 1;
        }
        else
        {
            linhasServico.Add(new LinhaServico
            {
                ServicoId = servico.Id,
                Nome = servico.Nome,
                PrecoBase = servico.ValorPadrao,
                Valor = servico.ValorPadrao,
                TempoMinutos = servico.TempoEstimadoMinutos
            });
        }
        servicoSelecionadoId = 0;
        AtualizarPrevisaoSugerida();
    }

    private void RemoverServico(LinhaServico l)
    {
        linhasServico.Remove(l);
        AtualizarPrevisaoSugerida();
    }

    private async Task BuscarPecas()
    {
        resultadoPecas = await OrdemServicoQueryService.BuscarPecasRapidoAsync(buscaPeca);
    }

    private void AdicionarPeca(Peca peca)
    {
        var existente = linhasPeca.FirstOrDefault(l => l.PecaId == peca.Id && l.Origem == origemNovaPeca);
        if (existente != null)
        {
            existente.Quantidade += 1;
        }
        else
        {
            linhasPeca.Add(new LinhaPeca
            {
                PecaId = peca.Id,
                Nome = peca.Nome,
                Sku = peca.Sku,
                PrecoBase = peca.PrecoVenda,
                PrecoCusto = peca.PrecoCusto,
                Valor = peca.PrecoVenda,
                Origem = origemNovaPeca
            });
        }
        buscaPeca = null;
        resultadoPecas = new();
    }

    private void AtualizarPrevisaoSugerida()
    {
        if (previsaoEditadaManualmente) return;
        os.DataPrevisaoEntrega = OrdemServicoService.CalcularPrevisaoEntregaSugerida(TempoEstimadoMinutos);
    }
    // ─── Wizard: Métodos ─────────────────────────────────────────────────────────

    private async Task AbrirWizardCadastro()
    {
        novoCliente = new Cliente();
        novoVeiculo = new Veiculo();
        erroWizard = null;
        passoWizard = 1;
        salvandoWizard = false;
        mostrarWizard = true;
        StateHasChanged();
        await Task.Delay(100);
        await JS.InvokeVoidAsync("applyMasks");
    }

    private void FecharWizard()
    {
        mostrarWizard = false;
    }

    private void VoltarParaCliente()
    {
        erroWizard = null;
        passoWizard = 1;
    }

    private async Task AvancarParaVeiculo()
    {
        try
        {
            salvandoWizard = true;
            erroWizard = null;

            // Salvar o cliente no banco
            await ClienteRepository.Salvar(novoCliente);

            // Avançar para passo 2
            novoVeiculo.ClienteId = novoCliente.Id;
            novoVeiculo.Ano = DateTime.UtcNow.Year;
            passoWizard = 2;
        }
        catch (Exception ex)
        {
            erroWizard = DomainErrorHelper.ObterMensagemSegura(ex, Logger, "Não foi possível salvar o cliente. Verifique os dados informados.");
        }
        finally
        {
            salvandoWizard = false;
        }
    }

    private async Task ConcluirWizard()
    {
        try
        {
            salvandoWizard = true;
            erroWizard = null;

            // Garantir vínculo com o cliente recém-criado
            novoVeiculo.ClienteId = novoCliente.Id;

            // Salvar o veículo no banco
            await VeiculoRepository.Salvar(novoVeiculo);

            // Recarregar a lista de veículos
            veiculos = await OrdemServicoQueryService.ListarVeiculosAtivosParaSelecaoAsync();

            // Pré-selecionar o veículo recém-criado
            os.VeiculoId = novoVeiculo.Id;

            mostrarWizard = false;
        }
        catch (Exception ex)
        {
            erroWizard = DomainErrorHelper.ObterMensagemSegura(ex, Logger, "Não foi possível salvar o veículo. Verifique os dados informados.");
        }
        finally
        {
            salvandoWizard = false;
        }
    }

    [Inject] private ILogger<Create> Logger { get; set; } = default!;
}
