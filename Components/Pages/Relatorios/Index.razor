@page "/relatorios"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using mechsystem.Models
@using mechsystem.Services
@using mechsystem.Services.Queries
@attribute [Authorize(Roles = "Administrador, Atendimento")]
@inject OrdemServicoQueryService OrdemServicoQueryService
@inject RelatorioService RelatorioService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Relatórios — Mechsystem</PageTitle>

<div class="relatorios-page pb-5">

    <!-- Header -->
    <div class="rel-header mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-file-earmark-bar-graph me-2" style="color: var(--accent);"></i>Central de Relatórios</h2>
            <p class="text-muted mb-0">Emissão, detalhamento, exportação CSV e impressão de relatórios gerenciais</p>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap d-print-none">
            <div class="btn-group btn-group-sm" role="group" aria-label="Modo de Filtro">
                <button type="button" class="btn @(!usarIntervaloCustomizado ? "btn-dark" : "btn-outline-secondary")"
                        @onclick="async () => { usarIntervaloCustomizado = false; await CarregarDados(); }">
                    <i class="bi bi-calendar-month me-1"></i>Mês / Ano
                </button>
                <button type="button" class="btn @(usarIntervaloCustomizado ? "btn-dark" : "btn-outline-secondary")"
                        @onclick="async () => { usarIntervaloCustomizado = true; await CarregarDados(); }">
                    <i class="bi bi-calendar-range me-1"></i>Intervalo (De / Até)
                </button>
            </div>

            @if (!usarIntervaloCustomizado)
            {
                <div class="d-flex gap-1 align-items-center">
                    <select class="form-select form-select-sm" style="width: auto;" @bind="selectedMonth" @bind:after="CarregarDados">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">@(new DateTime(2026, m, 1).ToString("MMMM", ptBR))</option>
                        }
                    </select>
                    <select class="form-select form-select-sm" style="width: auto;" @bind="selectedYear" @bind:after="CarregarDados">
                        @for (int y = DateTimeExtensions.TodayBrasilia().Year - 2; y <= DateTimeExtensions.TodayBrasilia().Year + 1; y++)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="d-flex gap-1 align-items-center flex-wrap">
                    <span class="small text-muted">De:</span>
                    <input type="date" class="form-control form-control-sm" style="width: auto;" @bind="dataDe" />
                    <span class="small text-muted ms-1">Até:</span>
                    <input type="date" class="form-control form-control-sm" style="width: auto;" @bind="dataAte" />
                </div>
            }

            <button class="btn btn-sm btn-accent shadow-sm" @onclick="GerarTodos" disabled="@carregando">
                <i class="bi bi-arrow-repeat me-1"></i>Atualizar Relatórios
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(erroPermissao))
    {
        <div class="alert alert-danger shadow-sm border-0 border-start border-danger border-4">
            <i class="bi bi-shield-lock-fill me-2"></i>@erroPermissao
        </div>
    }
    else if (!string.IsNullOrEmpty(erroValidacaoFiltro))
    {
        <div class="alert alert-warning shadow-sm border-0 border-start border-warning border-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@erroValidacaoFiltro
        </div>
    }
    else if (carregando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Gerando relatórios...</p>
        </div>
    }
    else if (relatorios != null && relatorios.Any())
    {
        <!-- Tabs -->
        <ul class="nav nav-tabs mb-0 d-print-none" role="tablist">
            @for (int i = 0; i < relatorios.Count; i++)
            {
                var idx = i;
                var rel = relatorios[i];
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(abaAtiva == idx ? "active" : "")" @onclick="() => SelecionarAba(idx)">
                        <i class="bi @rel.GetIcone() me-1" style="color: @rel.GetCorTema();"></i>
                        @rel.Titulo
                    </button>
                </li>
            }
        </ul>

        <!-- Conteúdo da aba ativa -->
        @if (abaAtiva >= 0 && abaAtiva < relatorios.Count)
        {
            var relAtivo = relatorios[abaAtiva];

            <!-- Toolbar de impressão -->
            <div class="rel-toolbar d-print-none">
                <button class="btn btn-sm btn-dark" @onclick="Imprimir">
                    <i class="bi bi-printer-fill me-1"></i>Imprimir / PDF
                </button>
                <span class="text-muted small ms-3">
                    <i class="bi bi-clock me-1"></i>Gerado em @relAtivo.GetDataFormatada() (Brasília) por <strong>@relAtivo.GeradoPor</strong>
                </span>
            </div>

            <!-- Documento imprimível -->
            <div class="rel-documento" id="relatorio-print">

                <!-- Cabeçalho do documento -->
                <div class="rel-doc-header">
                    <div>
                        <div class="rel-doc-empresa">@(config?.NomeFantasia ?? "MechSystem")</div>
                        <div class="rel-doc-info">CNPJ: @(FormatarCnpj(config?.Cnpj))</div>
                        @if (!string.IsNullOrEmpty(config?.Telefone))
                        {
                            <div class="rel-doc-info">Tel: @config.Telefone</div>
                        }
                        @if (!string.IsNullOrEmpty(config?.EnderecoCompleto))
                        {
                            <div class="rel-doc-info">@config.EnderecoCompleto</div>
                        }
                    </div>
                    <div class="text-end">
                        <div class="rel-doc-tipo">RELATÓRIO GERENCIAL</div>
                        <div class="rel-doc-titulo" style="color: @relAtivo.GetCorTema();">
                            <i class="bi @relAtivo.GetIcone() me-1"></i>@relAtivo.Titulo
                        </div>
                        <div class="rel-doc-periodo">Período: @GetPeriodoLabel()</div>
                        <div class="rel-doc-info mt-1">
                            Emitido em @relAtivo.GetDataFormatada() (Horário de Brasília)<br />
                            Responsável: <strong>@relAtivo.GeradoPor</strong>
                        </div>
                    </div>
                </div>

                <div class="rel-doc-divider"></div>

                <!-- Conteúdo específico por tipo -->
                @if (relAtivo is RelatorioOS relOS)
                {
                    <div class="rel-section">
                        <div class="rel-section-title">RESUMO OPERACIONAL NO PERÍODO (@GetPeriodoLabel())</div>
                        <div class="rel-kpi-grid">
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor" style="color: @relOS.GetCorTema();">@relOS.TotalOS</span>
                                <span class="rel-kpi-label">O.S. Emitidas no Período</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor text-success">@relOS.TotalConcluidas</span>
                                <span class="rel-kpi-label">Concluídas no Período</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor" style="color: #fd7e14;">@relOS.TotalEmAndamento</span>
                                <span class="rel-kpi-label">Em Andamento (Período)</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor text-warning">@relOS.TotalOrcamentos</span>
                                <span class="rel-kpi-label">Orçamentos (Período)</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor text-danger">@relOS.TotalCanceladas</span>
                                <span class="rel-kpi-label">Canceladas (Período)</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor" style="color: #6f42c1;">@relOS.TaxaConversao.ToString("N1", ptBR)%</span>
                                <span class="rel-kpi-label">Conversão (Período)</span>
                            </div>
                        </div>
                    </div>

                    @if (isAdmin)
                    {
                        <div class="rel-doc-divider"></div>

                        <div class="rel-section">
                            <div class="rel-section-title">INDICADORES FINANCEIROS DE O.S. CONCLUÍDAS NO PERÍODO</div>
                            <table class="rel-table">
                                <tbody>
                                    <tr><td>Faturamento Total (O.S. Concluídas no Período)</td><td class="text-end fw-bold">@relOS.FaturamentoTotal.ToString("C", ptBR)</td></tr>
                                    <tr><td>Ticket Médio por O.S. Concluída</td><td class="text-end">@relOS.TicketMedio.ToString("C", ptBR)</td></tr>
                                    <tr><td>Taxa de Conversão de Orçamentos</td><td class="text-end">@relOS.TaxaConversao.ToString("N1", ptBR)%</td></tr>
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="rel-doc-divider"></div>

                    <!-- Tabela de Detalhe 1: Ordens de Serviço do Período com Link -->
                    <div class="rel-section">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="rel-section-title mb-0">ORDENS DE SERVIÇO DO PERÍODO (@ordensDetalhe.Count)</div>
                            <button type="button" class="btn btn-sm btn-outline-success d-print-none" @onclick="ExportarCsvOrdensPeriodo" disabled="@(!ordensDetalhe.Any())">
                                <i class="bi bi-filetype-csv me-1"></i>Exportar CSV
                            </button>
                        </div>
                        @if (ordensDetalhe.Any())
                        {
                            <div class="table-responsive">
                                <table class="rel-table rel-table-detail">
                                    <thead>
                                        <tr>
                                            <th>Nº O.S.</th>
                                            <th>Emissão</th>
                                            <th>Conclusão</th>
                                            <th>Placa / Veículo</th>
                                            <th>Cliente</th>
                                            <th class="text-center">Status</th>
                                            <th class="text-end">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in ordensDetalhe)
                                        {
                                            <tr>
                                                <td class="fw-bold">
                                                    <a href="/ordens-servico/@item.Id" class="text-decoration-none">
                                                        #@item.Id.ToString("D4") <i class="bi bi-box-arrow-up-right small d-print-none"></i>
                                                    </a>
                                                </td>
                                                <td>@item.DataEmissao.ToString("dd/MM/yyyy")</td>
                                                <td>@(item.DataConclusao.ToBrasiliaTime()?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                <td><strong>@item.Placa</strong> — @item.VeiculoDescricao</td>
                                                <td>@item.ClienteNome</td>
                                                <td class="text-center">@item.Status</td>
                                                <td class="text-end fw-bold">@item.ValorTotal.ToString("C", ptBR)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mb-0">Nenhuma Ordem de Serviço registrada no período selecionado.</p>
                        }
                    </div>

                    <div class="rel-doc-divider"></div>

                    <!-- Tabela de Detalhe 2: Ranking de Serviços por Quantidade e Receita -->
                    <div class="rel-section">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="rel-section-title mb-0">RANKING DE SERVIÇOS POR QUANTIDADE E RECEITA (@rankingServicos.Count)</div>
                            <button type="button" class="btn btn-sm btn-outline-success d-print-none" @onclick="ExportarCsvRankingServicos" disabled="@(!rankingServicos.Any())">
                                <i class="bi bi-filetype-csv me-1"></i>Exportar CSV
                            </button>
                        </div>
                        @if (rankingServicos.Any())
                        {
                            <div class="table-responsive">
                                <table class="rel-table rel-table-detail">
                                    <thead>
                                        <tr>
                                            <th style="width: 60px;">Pos.</th>
                                            <th>Serviço</th>
                                            <th class="text-center">Quantidade</th>
                                            <th class="text-end">Receita Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < rankingServicos.Count; i++)
                                        {
                                            var r = rankingServicos[i];
                                            <tr>
                                                <td class="fw-bold">#@(i + 1)</td>
                                                <td>@r.NomeServico</td>
                                                <td class="text-center fw-bold">@r.QuantidadeExecucoes</td>
                                                <td class="text-end fw-bold text-success">@r.ReceitaTotal.ToString("C", ptBR)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mb-0">Nenhum serviço executado no período selecionado.</p>
                        }
                    </div>
                }
                else if (relAtivo is RelatorioEstoque relEst)
                {
                    <div class="rel-section">
                        <div class="rel-section-title">POSIÇÃO ATUAL DO ESTOQUE (TEMPO REAL)</div>
                        <div class="rel-kpi-grid">
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor text-success">@relEst.PecasAtivas</span>
                                <span class="rel-kpi-label">Peças Ativas (Posição Atual)</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor text-secondary">@relEst.PecasInativas</span>
                                <span class="rel-kpi-label">Peças Inativas (Posição Atual)</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor text-danger">@relEst.PecasAbaixoDoMinimo</span>
                                <span class="rel-kpi-label">Abaixo do Mínimo (Ativas)</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor" style="color: #6f42c1;">@relEst.MargemLucroMedia.ToString("N1", ptBR)%</span>
                                <span class="rel-kpi-label">Margem Média (Peças Ativas)</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor text-success">@relEst.CapitalImobilizado.ToString("C", ptBR)</span>
                                <span class="rel-kpi-label">Capital Imobilizado (Ativas)</span>
                            </div>
                        </div>
                    </div>

                    <div class="rel-doc-divider"></div>

                    <div class="rel-section">
                        <div class="rel-section-title">MOVIMENTAÇÕES NO PERÍODO (@GetPeriodoLabel())</div>
                        <div class="rel-kpi-grid">
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor text-dark">@relEst.TotalMovimentacoes</span>
                                <span class="rel-kpi-label">Movimentações no Período</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor text-success">@relEst.MovimentacoesEntradaPeriodo</span>
                                <span class="rel-kpi-label">Entradas no Período</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor text-danger">@relEst.MovimentacoesSaidaPeriodo</span>
                                <span class="rel-kpi-label">Saídas no Período</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor text-warning">@relEst.MovimentacoesAjustePeriodo</span>
                                <span class="rel-kpi-label">Ajustes no Período</span>
                            </div>
                        </div>
                    </div>

                    <div class="rel-doc-divider"></div>

                    <!-- Tabela de Detalhe 3: Movimentações de Estoque no Período com Usuário -->
                    <div class="rel-section">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="rel-section-title mb-0">HISTÓRICO DE MOVIMENTAÇÕES NO PERÍODO (@movimentacoesDetalhe.Count)</div>
                            <button type="button" class="btn btn-sm btn-outline-success d-print-none" @onclick="ExportarCsvMovimentacoesPeriodo" disabled="@(!movimentacoesDetalhe.Any())">
                                <i class="bi bi-filetype-csv me-1"></i>Exportar CSV
                            </button>
                        </div>
                        @if (movimentacoesDetalhe.Any())
                        {
                            <div class="table-responsive">
                                <table class="rel-table rel-table-detail">
                                    <thead>
                                        <tr>
                                            <th>Data / Hora (Brasília)</th>
                                            <th>SKU</th>
                                            <th>Peça</th>
                                            <th class="text-center">Tipo</th>
                                            <th class="text-center">Quantidade</th>
                                            <th>Referência / Motivo</th>
                                            <th>Usuário</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var mov in movimentacoesDetalhe)
                                        {
                                            <tr>
                                                <td>@mov.DataHora.ToBrasiliaTime().ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="fw-bold font-monospace">@mov.Sku</td>
                                                <td>@mov.PecaNome</td>
                                                <td class="text-center">@mov.Tipo</td>
                                                <td class="text-center fw-bold @(mov.Quantidade >= 0 ? "text-success" : "text-danger")">
                                                    @(mov.Quantidade > 0 ? $"+{mov.Quantidade}" : mov.Quantidade.ToString())
                                                </td>
                                                <td>@(mov.Referencia ?? "—")</td>
                                                <td>@mov.UsuarioNome</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mb-0">Nenhuma movimentação de estoque registrada no período selecionado.</p>
                        }
                    </div>

                    <div class="rel-doc-divider"></div>

                    <!-- Peças em ruptura -->
                    @if (pecasRuptura != null && pecasRuptura.Any())
                    {
                        <div class="rel-section">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="rel-section-title mb-0">⚠ PEÇAS ATIVAS EM RUPTURA DE ESTOQUE (POSIÇÃO ATUAL)</div>
                                <button type="button" class="btn btn-sm btn-outline-success d-print-none" @onclick="ExportarCsvPecasRuptura">
                                    <i class="bi bi-filetype-csv me-1"></i>Exportar CSV
                                </button>
                            </div>
                            <table class="rel-table rel-table-detail">
                                <thead>
                                    <tr>
                                        <th>SKU</th>
                                        <th>Nome</th>
                                        <th class="text-center">Estoque Atual</th>
                                        <th class="text-center">Estoque Mínimo</th>
                                        <th class="text-end">Preço Venda</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in pecasRuptura)
                                    {
                                        <tr>
                                            <td class="fw-bold">@p.Sku</td>
                                            <td>@p.Nome</td>
                                            <td class="text-center text-danger fw-bold">@p.EstoqueAtual</td>
                                            <td class="text-center">@p.EstoqueMinimo</td>
                                            <td class="text-end">@p.PrecoVenda.ToString("C", ptBR)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="rel-section">
                            <div class="alert alert-success d-flex align-items-center gap-2 mb-0">
                                <i class="bi bi-check-circle-fill fs-5"></i>
                                <span>Estoque saudável — nenhuma peça ativa abaixo do mínimo.</span>
                            </div>
                        </div>
                    }
                }
                else if (relAtivo is RelatorioFinanceiro relFin && isAdmin)
                {
                    <div class="rel-section">
                        <div class="rel-section-title">PANORAMA FINANCEIRO NO PERÍODO (@GetPeriodoLabel())</div>
                        <div class="rel-kpi-grid">
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor text-success">@relFin.ReceitaTotal.ToString("C", ptBR)</span>
                                <span class="rel-kpi-label">Receita Total (No Período)</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor" style="color: @relFin.GetCorTema();">@relFin.TotalOSPagas</span>
                                <span class="rel-kpi-label">O.S. Concluídas (No Período)</span>
                            </div>
                            <div class="rel-kpi">
                                <span class="rel-kpi-valor" style="color: #6f42c1;">@relFin.LucroRealPecas.ToString("C", ptBR)</span>
                                <span class="rel-kpi-label">Lucro Real Peças (No Período)</span>
                            </div>
                        </div>
                    </div>

                    <div class="rel-doc-divider"></div>

                    <div class="rel-section">
                        <div class="rel-section-title">COMPOSIÇÃO DA RECEITA NO PERÍODO</div>
                        <table class="rel-table">
                            <tbody>
                                <tr>
                                    <td><span class="dot me-2 bg-success"></span>Mão de Obra</td>
                                    <td class="text-end">@relFin.ReceitaMaoDeObra.ToString("C", ptBR)</td>
                                    <td class="text-end" style="width: 80px;">@relFin.PercentualMaoDeObra.ToString("N1", ptBR)%</td>
                                </tr>
                                <tr>
                                    <td><span class="dot me-2" style="background: #fd7e14;"></span>Peças</td>
                                    <td class="text-end">@relFin.ReceitaPecas.ToString("C", ptBR)</td>
                                    <td class="text-end">@relFin.PercentualPecas.ToString("N1", ptBR)%</td>
                                </tr>
                                <tr class="rel-total-row">
                                    <td>RECEITA TOTAL LÍQUIDA</td>
                                    <td class="text-end fw-bold">@relFin.ReceitaTotal.ToString("C", ptBR)</td>
                                    <td class="text-end">100%</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="rel-doc-divider"></div>

                    <div class="rel-section">
                        <div class="rel-section-title">ANÁLISE DE LUCRATIVIDADE E POSIÇÃO PATRIMONIAL</div>
                        <table class="rel-table">
                            <tbody>
                                <tr>
                                    <td>Capital Imobilizado em Estoque (Posição Atual — Peças Ativas)</td>
                                    <td class="text-end">@relFin.CapitalImobilizado.ToString("C", ptBR)</td>
                                </tr>
                                <tr>
                                    <td>Lucro Real em Peças no Período (Venda - Custo Snapshot)</td>
                                    <td class="text-end fw-bold text-success">@relFin.LucroRealPecas.ToString("C", ptBR)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }

                <!-- Resumo textual (GerarResumo via override) -->
                <div class="rel-doc-divider"></div>
                <div class="rel-section">
                    <div class="rel-section-title">RESUMO AUTOMÁTICO (GERADO VIA POLIMORFISMO)</div>
                    <div class="rel-resumo-box">
                        @foreach (var parte in relAtivo.GerarResumo().Split(" | "))
                        {
                            <span class="d-block"><i class="bi bi-chevron-right me-1 text-muted" style="font-size: 0.7rem;"></i>@parte</span>
                        }
                    </div>
                </div>

                <!-- Rodapé -->
                <div class="rel-rodape">
                    @relAtivo.GetCabecalho()
                </div>
            </div>
        }
    }
</div>

@code {
    private System.Globalization.CultureInfo ptBR = new("pt-BR");
    private int selectedMonth = DateTimeExtensions.TodayBrasilia().Month;
    private int selectedYear = DateTimeExtensions.TodayBrasilia().Year;
    private bool usarIntervaloCustomizado = false;
    private DateTime dataDe = new DateTime(DateTimeExtensions.TodayBrasilia().Year, DateTimeExtensions.TodayBrasilia().Month, 1);
    private DateTime dataAte = DateTimeExtensions.TodayBrasilia();

    private bool carregando = false;
    private int abaAtiva = 0;
    private bool isAdmin = false;
    private string usuarioLogado = "Sistema";
    private string? erroPermissao;
    private string? erroValidacaoFiltro;

    private Configuracao? config;
    private List<Relatorio> relatorios = new();
    private List<Peca> pecasRuptura = new();
    private List<OrdemServicoPeriodoItemDto> ordensDetalhe = new();
    private List<RankingServicoItemDto> rankingServicos = new();
    private List<MovimentacaoPeriodoItemDto> movimentacoesDetalhe = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private void SelecionarAba(int idx)
    {
        if (idx < 0 || idx >= relatorios.Count) return;
        if (relatorios[idx] is RelatorioFinanceiro && !isAdmin)
        {
            erroPermissao = "Apenas Administradores possuem permissão para acessar o relatório Financeiro.";
            return;
        }
        abaAtiva = idx;
    }

    private (DateTime inicioUtc, DateTime fimUtc) ObterIntervaloUtc()
    {
        if (usarIntervaloCustomizado)
        {
            var ini = DateTime.SpecifyKind(dataDe.Date, DateTimeKind.Utc);
            var fim = DateTime.SpecifyKind(dataAte.Date.AddDays(1), DateTimeKind.Utc);
            return (ini, fim);
        }
        else
        {
            var ini = new DateTime(selectedYear, selectedMonth, 1, 0, 0, 0, DateTimeKind.Utc);
            var fim = ini.AddMonths(1);
            return (ini, fim);
        }
    }

    private async Task CarregarDados()
    {
        carregando = true;
        erroPermissao = null;
        erroValidacaoFiltro = null;
        StateHasChanged();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true || (!user.IsInRole("Administrador") && !user.IsInRole("Atendimento")))
        {
            erroPermissao = "Acesso negado: apenas Administradores e Atendimento possuem permissão para acessar os relatórios.";
            carregando = false;
            return;
        }

        if (usarIntervaloCustomizado && dataAte.Date < dataDe.Date)
        {
            erroValidacaoFiltro = "A data final ('Até') não pode ser anterior à data inicial ('De').";
            carregando = false;
            return;
        }

        isAdmin = user.IsInRole("Administrador");
        usuarioLogado = user.FindFirst(ClaimTypes.GivenName)?.Value
            ?? user.Identity?.Name
            ?? "Usuário";

        config = await OrdemServicoQueryService.ObterConfiguracaoAsync();

        var (inicio, fim) = ObterIntervaloUtc();

        var (pacoteRelatorios, _, _, estoqueResumo) = await RelatorioService.GerarPacoteRelatoriosAsync(
            inicio,
            fim,
            usuarioLogado,
            incluirFinanceiro: isAdmin);

        relatorios = pacoteRelatorios;
        pecasRuptura = estoqueResumo.PecasEmRuptura;

        ordensDetalhe = await RelatorioService.ObterOrdensDoPeriodoDetalheAsync(inicio, fim);
        rankingServicos = await RelatorioService.ObterRankingServicosPeriodoAsync(inicio, fim);
        movimentacoesDetalhe = await RelatorioService.ObterMovimentacoesPeriodoDetalheAsync(inicio, fim);

        if (abaAtiva >= relatorios.Count)
        {
            abaAtiva = 0;
        }

        carregando = false;
    }

    private async Task GerarTodos()
    {
        await CarregarDados();
    }

    private async Task Imprimir()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async Task ExportarCsvOrdensPeriodo()
    {
        var cabecalhos = new[] { "Nº O.S.", "Emissão", "Conclusão", "Placa", "Veículo", "Cliente", "Status", "Mão de Obra (R$)", "Peças (R$)", "Desconto (R$)", "Valor Total (R$)" };
        var linhas = ordensDetalhe.Select(o => new string?[]
        {
            o.Id.ToString("D4"),
            o.DataEmissao.ToString("dd/MM/yyyy", ptBR),
            o.DataConclusao.ToBrasiliaTime()?.ToString("dd/MM/yyyy", ptBR) ?? "",
            o.Placa,
            o.VeiculoDescricao,
            o.ClienteNome,
            o.Status.ToString(),
            o.ValorMaoDeObraEfetivo.ToString("N2", ptBR),
            o.ValorPecasEfetivo.ToString("N2", ptBR),
            o.ValorDesconto.ToString("N2", ptBR),
            o.ValorTotal.ToString("N2", ptBR)
        });

        var csv = RelatorioService.GerarCsvPtBr(cabecalhos, linhas);
        await JSRuntime.InvokeVoidAsync("downloadCsvUtf8Bom", $"relatorio_os_{ObterSufixoArquivo()}.csv", csv);
    }

    private async Task ExportarCsvRankingServicos()
    {
        var cabecalhos = new[] { "Posição", "Serviço", "Quantidade Executada", "Receita Total (R$)" };
        var linhas = rankingServicos.Select((r, idx) => new string?[]
        {
            (idx + 1).ToString(),
            r.NomeServico,
            r.QuantidadeExecucoes.ToString(),
            r.ReceitaTotal.ToString("N2", ptBR)
        });

        var csv = RelatorioService.GerarCsvPtBr(cabecalhos, linhas);
        await JSRuntime.InvokeVoidAsync("downloadCsvUtf8Bom", $"ranking_servicos_{ObterSufixoArquivo()}.csv", csv);
    }

    private async Task ExportarCsvMovimentacoesPeriodo()
    {
        var cabecalhos = new[] { "Data/Hora (Brasília)", "SKU", "Peça", "Tipo", "Quantidade", "Referência", "Usuário" };
        var linhas = movimentacoesDetalhe.Select(m => new string?[]
        {
            m.DataHora.ToBrasiliaTime().ToString("dd/MM/yyyy HH:mm", ptBR),
            m.Sku,
            m.PecaNome,
            m.Tipo.ToString(),
            m.Quantidade.ToString(),
            m.Referencia ?? "",
            m.UsuarioNome
        });

        var csv = RelatorioService.GerarCsvPtBr(cabecalhos, linhas);
        await JSRuntime.InvokeVoidAsync("downloadCsvUtf8Bom", $"movimentacoes_estoque_{ObterSufixoArquivo()}.csv", csv);
    }

    private async Task ExportarCsvPecasRuptura()
    {
        var cabecalhos = new[] { "SKU", "Nome", "Estoque Atual", "Estoque Mínimo", "Preço Venda (R$)" };
        var linhas = pecasRuptura.Select(p => new string?[]
        {
            p.Sku,
            p.Nome,
            p.EstoqueAtual.ToString(),
            p.EstoqueMinimo.ToString(),
            p.PrecoVenda.ToString("N2", ptBR)
        });

        var csv = RelatorioService.GerarCsvPtBr(cabecalhos, linhas);
        await JSRuntime.InvokeVoidAsync("downloadCsvUtf8Bom", $"pecas_em_ruptura_{ObterSufixoArquivo()}.csv", csv);
    }

    private string ObterSufixoArquivo()
    {
        return usarIntervaloCustomizado
            ? $"{dataDe:yyyyMMdd}_a_{dataAte:yyyyMMdd}"
            : $"{selectedYear}{selectedMonth:D2}";
    }

    private string GetPeriodoLabel()
    {
        if (usarIntervaloCustomizado)
        {
            return $"{dataDe:dd/MM/yyyy} A {dataAte:dd/MM/yyyy}";
        }

        return new DateTime(selectedYear, selectedMonth, 1)
            .ToString("MMMM 'de' yyyy", ptBR).ToUpper();
    }

    private static string FormatarCnpj(string? cnpj)
    {
        if (string.IsNullOrWhiteSpace(cnpj)) return "00.000.000/0001-00";
        var digits = new string(cnpj.Where(char.IsDigit).ToArray());
        if (digits.Length == 14)
        {
            return $"{digits[..2]}.{digits[2..5]}.{digits[5..8]}/{digits[8..12]}-{digits[12..14]}";
        }
        return cnpj;
    }
}
