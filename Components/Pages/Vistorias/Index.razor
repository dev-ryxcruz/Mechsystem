@page "/vistorias"
@using Microsoft.EntityFrameworkCore
@using mechsystem.Data
@using mechsystem.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject AppDbContext DbContext

<PageTitle>Histórico de Vistorias</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2>Histórico de Vistorias</h2>
    <div class="d-flex gap-2 align-items-center flex-wrap flex-md-nowrap w-100" style="max-width: 400px;">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" class="form-control border-start-0 ps-0 shadow-none" placeholder="Pesquisar Vistoria..." @bind="termoPesquisa" @bind:event="oninput" />
        </div>
    </div>
</div>

@if (vistorias == null)
{
    <p><em>Carregando...</em></p>
}
else if (!vistorias.Any())
{
    <div class="alert alert-info">Nenhuma Vistoria cadastrada ainda no sistema.</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-borderless align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th width="10%" class="text-center">Nº Vistoria</th>
                            <th width="15%" class="text-center">Data</th>
                            <th width="15%" class="text-center">OS Vinculada</th>
                            <th width="25%" class="text-start">Veículo / Cliente</th>
                            <th width="15%" class="text-center">Nível de Combust.</th>
                            <th width="10%" class="text-center">Itens Checklist</th>
                            <th width="10%" class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in VistoriasFiltradas!)
                    {
                        <tr>
                            <td class="text-center">#@v.Id.ToString("D4")</td>
                            <td class="text-center">@v.DataVistoria.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center"><a href="/ordens-servico/@v.OrdemServicoId" class="text-decoration-none fw-bold">OS-@v.OrdemServicoId.ToString("D4")</a></td>
                            <td class="text-start">
                                @(v.OrdemServico?.Veiculo?.Modelo) - <strong>@(v.OrdemServico?.Veiculo?.Placa)</strong><br />
                                <small class="text-muted">@(v.OrdemServico?.Veiculo?.Cliente?.Nome)</small>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@GetEnumDisplayName(v.NivelCombustivel)</span>
                            </td>
                            <td class="text-center">
                                @{
                                    int presentes = 0;
                                    if(v.TemEstepe) presentes++;
                                    if(v.TemMacaco) presentes++;
                                    if(v.TemChaveRoda) presentes++;
                                    if(v.TemRadio) presentes++;
                                    if(v.TemTriangulo) presentes++;
                                }
                                <span class="badge bg-secondary">@presentes/5 Presentes</span>
                            </td>
                            <td class="text-center">
                                <a href="/ordensdeservico/@v.OrdemServicoId/vistoria" class="btn btn-sm btn-outline-primary" title="Ver / Editar Checklist Visual">
                                    <i class="bi bi-eye"></i> Mapa
                                </a>
                                <a href="/imprimir/vistoria/@v.OrdemServicoId" target="_blank" class="btn btn-sm btn-outline-secondary" title="Imprimir PDF">
                                    <i class="bi bi-printer"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private List<Vistoria>? vistorias;
    private string termoPesquisa = "";
    private IEnumerable<Vistoria>? VistoriasFiltradas => string.IsNullOrWhiteSpace(termoPesquisa) 
        ? vistorias 
        : vistorias?.Where(v => 
            v.Id.ToString().Contains(termoPesquisa) ||
            v.OrdemServicoId.ToString().Contains(termoPesquisa) ||
            (v.OrdemServico?.Veiculo?.Placa != null && v.OrdemServico.Veiculo.Placa.Contains(termoPesquisa, StringComparison.OrdinalIgnoreCase)) ||
            (v.OrdemServico?.Veiculo?.Cliente?.Nome != null && v.OrdemServico.Veiculo.Cliente.Nome.Contains(termoPesquisa, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        vistorias = await DbContext.Vistorias
            .Include(v => v.OrdemServico)
                .ThenInclude(os => os!.Veiculo)
                    .ThenInclude(veic => veic!.Cliente)
            .OrderByDescending(v => v.DataVistoria)
            .ToListAsync();
    }

    private string GetEnumDisplayName(Enum value)
    {
        var field = value.GetType().GetField(value.ToString());
        var attributes = field?.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false) as System.ComponentModel.DataAnnotations.DisplayAttribute[];
        return attributes?.Length > 0 ? (attributes[0].Name ?? value.ToString()) : value.ToString();
    }
}
