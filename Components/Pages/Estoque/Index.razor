@page "/estoque"
@rendermode InteractiveServer
@using mechsystem.Interfaces
@using mechsystem.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador, Atendimento")]
@inject IPecaRepository PecaRepository
@inject NavigationManager NavigationManager

<PageTitle>Estoque de Peças — Mechsystem</PageTitle>

<div class="page-container">
    <PageHeader Icon="bi-box-seam-fill" Title="Estoque de Peças" Subtitle="Gerencie o cadastro e disponibilidade das peças">
        <Actions>
            <a href="/estoque/entrada" class="btn btn-outline-secondary shadow-sm text-nowrap">
                <i class="bi bi-box-arrow-in-down me-1"></i>Entrada
            </a>
            <AuthorizeView Roles="Administrador">
                <a href="/estoque/ajuste" class="btn btn-outline-secondary shadow-sm text-nowrap">
                    <i class="bi bi-sliders me-1"></i>Ajuste
                </a>
            </AuthorizeView>
            <a href="/estoque/cadastro" class="btn btn-accent shadow-sm text-nowrap">
                <i class="bi bi-plus-lg"></i> Nova Peça
            </a>
        </Actions>
    </PageHeader>

@* Alerta de ruptura rápido *@
@if (pecasComAlerta != null && pecasComAlerta.Any())
{
    <div class="alert border-0 shadow-sm mb-4 d-flex align-items-center gap-3" 
         style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white; border-radius: 0.75rem;">
        <i class="bi bi-exclamation-triangle-fill fs-3"></i>
        <div>
            <strong>Alerta de Ruptura!</strong>
            <span class="ms-1">@pecasComAlerta.Count() peça(s) atingiram o nível mínimo de estoque:</span>
            <span class="fw-bold ms-1">
                @string.Join(", ", pecasComAlerta.Take(5).Select(p => p.Sku))
                @(pecasComAlerta.Count() > 5 ? $" e mais {pecasComAlerta.Count() - 5}..." : "")
            </span>
        </div>
    </div>
}

<ListToolbar Placeholder="Buscar peça por SKU, nome ou marca..."
             @bind-SearchTerm="termoBusca"
             TotalCount="@(pecasFiltradas.Count())"
             CountLabel="peça(s)"
             CountIcon="bi-box">
</ListToolbar>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (pecas == null)
        {
            <div class="text-center p-5">
                <div class="spinner-border text-accent" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
            </div>
        }
        else if (!pecasFiltradas.Any())
        {
            <div class="text-center p-5 text-muted">
                <i class="bi bi-box-seam fs-1 mb-3"></i>
                <h5>Nenhuma peça encontrada.</h5>
                <p>Nenhuma peça corresponde à busca ou o estoque está vazio.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th width="12%" class="text-start">SKU</th>
                            <th width="24%" class="text-start">Peça</th>
                            <th width="14%" class="text-start">Marca</th>
                            <th width="10%" class="text-end">Custo</th>
                            <th width="10%" class="text-end">Venda</th>
                            <th width="10%" class="text-end">Estoque</th>
                            <th width="10%" class="text-start">Localização</th>
                            <th width="10%" class="actions-col text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var peca in pecasFiltradas)
                        {
                            <tr class="@(peca.AbaixoDoMinimo ? "table-danger" : "")">
                                <td>
                                    <span class="badge bg-dark font-monospace">@peca.Sku</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@peca.Nome</div>
                                </td>
                                <td>
                                    <span class="text-muted">@(peca.Marca ?? "—")</span>
                                </td>
                                <td class="text-end text-muted">
                                    @peca.PrecoCusto.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                                </td>
                                <td class="text-end fw-bold text-success">
                                    @peca.PrecoVenda.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                                </td>
                                <td class="text-end">
                                    @if (peca.AbaixoDoMinimo)
                                    {
                                        <span class="badge bg-danger px-3 py-2 d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-exclamation-triangle-fill"></i>
                                            @peca.EstoqueAtual / @peca.EstoqueMinimo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success px-3 py-2">
                                            @peca.EstoqueAtual
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(peca.Localizacao))
                                    {
                                        <span class="badge bg-light text-dark border" title="@peca.Localizacao">
                                            <i class="bi bi-geo-alt me-1"></i>@peca.Localizacao
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted"><small>—</small></span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/estoque/cadastro/@peca.Id" class="btn btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="btn btn-outline-info" @onclick="() => VerHistorico(peca.Id)" title="Histórico">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" @onclick="() => ConfirmarExclusao(peca)" title="Desativar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
</div>

@* Modal Histórico *@
@if (mostrarHistorico)
{
    <div class="blazor-modal-backdrop" @onclick="FecharHistorico"></div>
    <div class="blazor-modal">
        <div class="blazor-modal-content" style="max-width: 700px;">
            <div class="blazor-modal-header bg-dark text-white">
                <h5><i class="bi bi-clock-history me-2"></i>Histórico de Movimentação — @pecaHistorico?.Sku</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="FecharHistorico"></button>
            </div>
            <div class="blazor-modal-body" style="max-height: 400px; overflow-y: auto;">
                @if (historico == null || !historico.Any())
                {
                    <p class="text-muted text-center py-3">Nenhuma movimentação registrada.</p>
                }
                else
                {
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Tipo</th>
                                <th class="text-center">Qtd</th>
                                <th>Referência</th>
                                <th>Usuário</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mov in historico)
                            {
                                <tr>
                                    <td><small>@mov.DataHora.ToBrasiliaTime().ToString("dd/MM/yy HH:mm")</small></td>
                                    <td>
                                        @switch(mov.Tipo)
                                        {
                                            case TipoMovimentacao.Entrada:
                                                <span class="badge bg-success">Entrada</span>
                                                break;
                                            case TipoMovimentacao.Saida:
                                                <span class="badge bg-danger">Saída</span>
                                                break;
                                            case TipoMovimentacao.Ajuste:
                                                <span class="badge bg-warning text-dark">Ajuste</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center fw-bold @(mov.Quantidade >= 0 ? "text-success" : "text-danger")">
                                        @(mov.Quantidade >= 0 ? "+" : "")@mov.Quantidade
                                    </td>
                                    <td><small class="text-muted">@(mov.Referencia ?? "—")</small></td>
                                    <td><small>@(mov.Usuario?.NomeCompleto ?? "Sistema")</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="blazor-modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="FecharHistorico">Fechar</button>
            </div>
        </div>
    </div>
}

@* Modal Exclusão *@
@if (mostrarModalExclusao)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom-0 bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Desativar Peça</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelarExclusao"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="mb-1 fs-5">Desativar "<strong>@pecaParaExcluir?.Nome</strong>"?</p>
                    <p class="text-muted">A peça será ocultada das listagens mas manterá seu histórico de movimentações.</p>
                </div>
                <div class="modal-footer border-top-0 bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarExclusao">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DesativarPeca">Confirmar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<Peca>? pecas;
    private IEnumerable<Peca>? pecasComAlerta;
    private string termoBusca = "";

    // Histórico
    private bool mostrarHistorico = false;
    private Peca? pecaHistorico;
    private IEnumerable<MovimentacaoEstoque>? historico;

    // Exclusão
    private bool mostrarModalExclusao = false;
    private Peca? pecaParaExcluir;

    protected override async Task OnInitializedAsync()
    {
        await CarregarPecas();
    }

    private async Task CarregarPecas()
    {
        pecas = await PecaRepository.GetAllAsync();
        pecasComAlerta = pecas.Where(p => p.AbaixoDoMinimo);
    }

    private IEnumerable<Peca> pecasFiltradas =>
        string.IsNullOrWhiteSpace(termoBusca)
            ? pecas ?? Array.Empty<Peca>()
            : pecas?.Where(p =>
                p.Sku.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
                p.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
                (p.Marca != null && p.Marca.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)))
              ?? Array.Empty<Peca>();

    // Histórico
    private async Task VerHistorico(int pecaId)
    {
        pecaHistorico = await PecaRepository.GetByIdAsync(pecaId);
        historico = await PecaRepository.GetHistoricoAsync(pecaId);
        mostrarHistorico = true;
    }

    private void FecharHistorico()
    {
        mostrarHistorico = false;
        historico = null;
    }

    // Exclusão (soft-delete)
    private void ConfirmarExclusao(Peca peca)
    {
        pecaParaExcluir = peca;
        mostrarModalExclusao = true;
    }

    private void CancelarExclusao()
    {
        mostrarModalExclusao = false;
        pecaParaExcluir = null;
    }

    private async Task DesativarPeca()
    {
        if (pecaParaExcluir != null)
        {
            await PecaRepository.DeleteAsync(pecaParaExcluir.Id);
            await CarregarPecas();
            CancelarExclusao();
        }
    }
}
