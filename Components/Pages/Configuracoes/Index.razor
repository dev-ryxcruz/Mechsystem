@page "/configuracoes"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer

@using mechsystem.Models
@using mechsystem.Services
@using Microsoft.AspNetCore.Authorization
@inject ConfiguracaoService ConfiguracaoService
@inject IJSRuntime JS

<PageTitle>Configurações do Sistema — Mechsystem</PageTitle>

<div class="cfg-header">
    <div class="cfg-title-block">
        <div class="cfg-icon-wrap">
            <i class="bi bi-gear-fill"></i>
        </div>
        <div>
            <h2 class="cfg-title">Configurações do Sistema</h2>
            <p class="cfg-subtitle">Personalize as informações e regras da sua oficina</p>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="cfg-loading">
        <div class="spinner-border cfg-spinner" role="status"></div>
        <p class="mt-3 text-muted">Carregando configurações...</p>
    </div>
}
else if (config == null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        Não foi possível carregar as configurações. Recarregue a página.
    </div>
}
else
{
    <!-- ALERT MESSAGES -->
    @if (showSuccess)
    {
        <div class="cfg-alert cfg-alert-success" @onclick="() => showSuccess = false">
            <i class="bi bi-check-circle-fill"></i>
            <span>Configurações salvas com sucesso!</span>
            <button class="cfg-alert-close"><i class="bi bi-x-lg"></i></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="cfg-alert cfg-alert-danger" @onclick="() => errorMessage = string.Empty">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@errorMessage</span>
            <button class="cfg-alert-close"><i class="bi bi-x-lg"></i></button>
        </div>
    }

    <!-- TABS -->
    <div class="cfg-tabs">
        <button class="cfg-tab @(activeTab == "oficina" ? "active" : "")" @onclick='() => activeTab = "oficina"'>
            <i class="bi bi-shop"></i> Oficina
        </button>
        <button class="cfg-tab @(activeTab == "sistema" ? "active" : "")" @onclick='() => activeTab = "sistema"'>
            <i class="bi bi-sliders"></i> Sistema
        </button>
        <button class="cfg-tab @(activeTab == "financeiro" ? "active" : "")" @onclick='() => activeTab = "financeiro"'>
            <i class="bi bi-currency-dollar"></i> Financeiro
        </button>
    </div>

    <EditForm Model="config" OnValidSubmit="SalvarConfiguracoes" id="form-configuracoes">
        <DataAnnotationsValidator />

        <!-- ABA: OFICINA -->
        @if (activeTab == "oficina")
        {
            <div class="cfg-panel">
                <div class="cfg-panel-header">
                    <i class="bi bi-building me-2"></i>Dados da Oficina
                </div>
                <div class="cfg-panel-body">

                    <div class="cfg-field-group">
                        <div class="cfg-field cfg-field--full">
                            <label class="cfg-label">
                                Nome Fantasia <span class="cfg-required">*</span>
                            </label>
                            <div class="cfg-input-wrap">
                                <i class="bi bi-shop cfg-input-icon"></i>
                                <InputText @bind-Value="config.NomeFantasia" class="cfg-input cfg-input--icon" placeholder="Ex.: MechSystem Auto Center" />
                            </div>
                            <ValidationMessage For="@(() => config.NomeFantasia)" class="cfg-validation" />
                        </div>

                        <div class="cfg-field">
                            <label class="cfg-label">CNPJ</label>
                            <div class="cfg-input-wrap">
                                <i class="bi bi-file-earmark-text cfg-input-icon"></i>
                                <InputText @bind-Value="config.Cnpj" class="cfg-input cfg-input--icon" placeholder="00.000.000/0000-00" />
                            </div>
                        </div>

                        <div class="cfg-field">
                            <label class="cfg-label">Telefone</label>
                            <div class="cfg-input-wrap">
                                <i class="bi bi-telephone cfg-input-icon"></i>
                                <InputText @bind-Value="config.Telefone" class="cfg-input cfg-input--icon mask-telefone" placeholder="(00) 0000-0000" />
                            </div>
                        </div>

                        <div class="cfg-field">
                            <label class="cfg-label">WhatsApp</label>
                            <div class="cfg-input-wrap">
                                <i class="bi bi-whatsapp cfg-input-icon"></i>
                                <InputText @bind-Value="config.WhatsApp" class="cfg-input cfg-input--icon mask-telefone" placeholder="(00) 9 0000-0000" />
                            </div>
                        </div>

                        <div class="cfg-field">
                            <label class="cfg-label">E-mail</label>
                            <div class="cfg-input-wrap">
                                <i class="bi bi-envelope cfg-input-icon"></i>
                                <InputText @bind-Value="config.Email" class="cfg-input cfg-input--icon" placeholder="contato@oficina.com.br" />
                            </div>
                            <ValidationMessage For="@(() => config.Email)" class="cfg-validation" />
                        </div>

                        <div class="cfg-field cfg-field--full">
                            <label class="cfg-label">Endereço Completo</label>
                            <div class="cfg-input-wrap">
                                <i class="bi bi-geo-alt cfg-input-icon"></i>
                                <InputText @bind-Value="config.EnderecoCompleto" class="cfg-input cfg-input--icon" placeholder="Rua, número, bairro, cidade - UF" />
                            </div>
                        </div>

                        <div class="cfg-field cfg-field--full">
                            <label class="cfg-label">Mensagem de Rodapé (para impressões)</label>
                            <InputTextArea @bind-Value="config.MensagemRodape" class="cfg-textarea" rows="3"
                                           placeholder="Ex.: Agradecemos a preferência! Garantia de 90 dias nos serviços realizados." />
                        </div>
                    </div>

                </div>
            </div>
        }

        <!-- ABA: SISTEMA -->
        @if (activeTab == "sistema")
        {
            <div class="cfg-panel">
                <div class="cfg-panel-header">
                    <i class="bi bi-sliders me-2"></i>Regras Operacionais
                </div>
                <div class="cfg-panel-body">
                    <div class="cfg-field-group">

                        <div class="cfg-field">
                            <label class="cfg-label">
                                Validade dos Orçamentos <span class="cfg-required">*</span>
                            </label>
                            <div class="cfg-input-wrap">
                                <i class="bi bi-calendar-check cfg-input-icon"></i>
                                <InputNumber @bind-Value="config.ValidadeOrcamentoDias" class="cfg-input cfg-input--icon" />
                                <span class="cfg-input-suffix">dias</span>
                            </div>
                            <ValidationMessage For="@(() => config.ValidadeOrcamentoDias)" class="cfg-validation" />
                            <small class="cfg-hint">Após este prazo, o orçamento expira automaticamente.</small>
                        </div>

                        <div class="cfg-field">
                            <label class="cfg-label">
                                Garantia Padrão de Serviços <span class="cfg-required">*</span>
                            </label>
                            <div class="cfg-input-wrap">
                                <i class="bi bi-shield-check cfg-input-icon"></i>
                                <InputNumber @bind-Value="config.GarantiaPadraoDias" class="cfg-input cfg-input--icon" />
                                <span class="cfg-input-suffix">dias</span>
                            </div>
                            <ValidationMessage For="@(() => config.GarantiaPadraoDias)" class="cfg-validation" />
                            <small class="cfg-hint">Garantia padrão aplicada em todas as ordens de serviço.</small>
                        </div>

                    </div>

                    <div class="cfg-divider"></div>

                    <div class="cfg-toggle-card @(config.ObrigarVistoriaParaOS ? "active" : "")"
                         @onclick="() => config.ObrigarVistoriaParaOS = !config.ObrigarVistoriaParaOS">
                        <div class="cfg-toggle-info">
                            <div class="cfg-toggle-icon">
                                <i class="bi bi-clipboard2-check"></i>
                            </div>
                            <div>
                                <strong class="cfg-toggle-title">Exigir Vistoria Prévia para OS</strong>
                                <p class="cfg-toggle-desc">
                                    Impede a abertura de uma Ordem de Serviço sem que uma Vistoria de Entrada tenha sido registrada previamente para o veículo.
                                </p>
                            </div>
                        </div>
                        <div class="cfg-switch @(config.ObrigarVistoriaParaOS ? "on" : "")">
                            <div class="cfg-switch-thumb"></div>
                        </div>
                    </div>

                </div>
            </div>
        }

        <!-- ABA: FINANCEIRO -->
        @if (activeTab == "financeiro")
        {
            <div class="cfg-panel">
                <div class="cfg-panel-header">
                    <i class="bi bi-cash-stack me-2"></i>Configurações Financeiras
                </div>
                <div class="cfg-panel-body">
                    <div class="cfg-field-group">

                        <div class="cfg-field">
                            <label class="cfg-label">Símbolo da Moeda</label>
                            <div class="cfg-input-wrap">
                                <i class="bi bi-currency-exchange cfg-input-icon"></i>
                                <InputText @bind-Value="config.SimboloMoeda" class="cfg-input cfg-input--icon" placeholder="R$" maxlength="5" />
                            </div>
                            <ValidationMessage For="@(() => config.SimboloMoeda)" class="cfg-validation" />
                            <small class="cfg-hint">Símbolo exibido nos valores monetários do sistema.</small>
                        </div>

                        <div class="cfg-field">
                            <label class="cfg-label">Taxa Adicional de Mão de Obra (%)</label>
                            <div class="cfg-input-wrap">
                                <i class="bi bi-percent cfg-input-icon"></i>
                                <InputNumber @bind-Value="config.TaxaMaoDeObra" class="cfg-input cfg-input--icon" />
                                <span class="cfg-input-suffix">%</span>
                            </div>
                            <ValidationMessage For="@(() => config.TaxaMaoDeObra)" class="cfg-validation" />
                            <small class="cfg-hint">Percentual aplicado automaticamente sobre serviços de mão de obra (0 = sem taxa adicional).</small>
                        </div>

                    </div>

                    <div class="cfg-info-box">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>As configurações financeiras afetam o cálculo de novas Ordens de Serviço a partir da data de salvamento.</span>
                    </div>
                </div>
            </div>
        }

        <!-- ACTION BAR -->
        <div class="cfg-actions">
            <a href="/" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i> Voltar ao Início
            </a>
            <button type="submit" class="cfg-save-btn" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Salvando...</span>
                }
                else
                {
                    <i class="bi bi-floppy-fill me-2"></i>
                    <span>Salvar Configurações</span>
                }
            </button>
        </div>
    </EditForm>
}

@code {
    private Configuracao? config;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showSuccess = false;
    private string errorMessage = string.Empty;
    private string activeTab = "oficina";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            config = await ConfiguracaoService.GetConfiguracaoAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Erro ao carregar configurações.";
            Console.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SalvarConfiguracoes()
    {
        if (config == null) return;

        isSaving = true;
        showSuccess = false;
        errorMessage = string.Empty;

        try
        {
            await ConfiguracaoService.SalvarConfiguracaoAsync(config);
            showSuccess = true;
            // Auto-hide after 4s
            _ = Task.Delay(4000).ContinueWith(_ => { showSuccess = false; InvokeAsync(StateHasChanged); });
        }
        catch (Exception ex)
        {
            errorMessage = "Erro ao salvar as configurações. Tente novamente.";
            Console.WriteLine(ex);
        }
        finally
        {
            isSaving = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || config != null)
        {
            await JS.InvokeVoidAsync("applyMasks");
        }
    }
}